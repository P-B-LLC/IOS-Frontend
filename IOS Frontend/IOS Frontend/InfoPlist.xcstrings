{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rytivo"
          }
        }
      },
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rytivo"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSCameraUsageDescription" : {
      "comment" : "iOS camera permission prompt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقط صورة أو فيديو لإرفاقه بمنشور تختار مشاركته، أو امسح الرمز الشريطي لطعام لتسجيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm ein Foto oder Video auf, um es an einen Beitrag anzuhängen, den du teilen möchtest, oder scanne den Barcode eines Lebensmittels, um es zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a photo or video to attach to a post you choose to share, or scan a food’s barcode to log it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma una foto o graba un video para adjuntarlo a una publicación que decidas compartir, o escanea el código de barras de un alimento para registrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez une photo ou une vidéo à joindre à une publication que vous choisissez de partager, ou scannez le code-barres d’un aliment pour l’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो पोस्ट शेयर करना चुनते हैं, उसमें अटैच करने के लिए फ़ोटो या वीडियो लें, या किसी खाने को लॉग करने के लिए उसका बारकोड स्कैन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェアする投稿に添付する写真や動画を撮影したり、食品のバーコードをスキャンして記録したりします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma foto ou grave um vídeo para anexar a uma publicação que você escolher compartilhar, ou escaneie o código de barras de um alimento para registrá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте фото или видео, чтобы прикрепить их к публикации, которой вы решите поделиться, или отсканируйте штрихкод продукта, чтобы записать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄照片或视频，附加到你选择分享的帖子中，或扫描食品条形码进行记录。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Apple Health read permission prompt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تفعيل المزامنة، يقرأ Rytivo الخطوات والتمارين المكتملة والمسافة والطاقة النشطة ومعدل نبض القلب، ثم يحفظ ملخصات التمارين وإجمالي الخطوات في حسابك. لا تُرفع المسارات أو عينات نبض القلب الفردية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei aktivierter Synchronisierung liest Rytivo Schritte, abgeschlossene Workouts, Distanz, Aktivitätsenergie und Herzfrequenz und speichert Workout-Zusammenfassungen und Schrittsummen in deinem Konto. Routen und einzelne Herzfrequenzmessungen werden nicht hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With sync enabled, Rytivo reads steps, completed workouts, distance, active energy and heart rate, then saves workout summaries and step totals to your account. Routes and individual heart-rate samples are not uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronización activada, Rytivo lee pasos, entrenamientos completados, distancia, energía activa y frecuencia cardíaca, y guarda resúmenes de entrenamiento y totales de pasos en tu cuenta. No se suben rutas ni muestras individuales de frecuencia cardíaca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la synchronisation est activée, Rytivo lit les pas, les entraînements terminés, la distance, l’énergie en activité et la fréquence cardiaque, puis enregistre les résumés d’entraînement et les totaux de pas dans votre compte. Aucun itinéraire ni échantillon individuel de fréquence cardiaque n’est envoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक चालू होने पर Rytivo कदम, पूरे किए गए वर्कआउट, दूरी, सक्रिय ऊर्जा और हृदय गति पढ़ता है, फिर वर्कआउट के सारांश और कदमों के कुल आँकड़े आपके खाते में सेव करता है। रूट और हृदय गति के अलग-अलग सैंपल अपलोड नहीं होते।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期を有効にすると、Rytivoは歩数、完了したワークアウト、距離、アクティブエネルギー、心拍数を読み取り、ワークアウトの概要と歩数の合計をアカウントに保存します。ルートや個々の心拍数サンプルはアップロードされません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a sincronização ativada, o Rytivo lê passos, treinos concluídos, distância, energia ativa e frequência cardíaca e salva resumos dos treinos e totais de passos na sua conta. Rotas e amostras individuais de frequência cardíaca não são enviadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включённой синхронизации Rytivo считывает шаги, завершённые тренировки, дистанцию, активную энергию и пульс, затем сохраняет сводки тренировок и общее число шагов в вашем аккаунте. Маршруты и отдельные измерения пульса не загружаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用同步后，Rytivo 会读取步数、已完成的训练、距离、活动能量和心率，并将训练摘要和步数总计保存到你的账户。不会上传路线或单次心率采样数据。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Apple Health write permission prompt (the app never writes)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يكتب Rytivo في تطبيق صحتي. بل يقرأ فقط عدد خطواتك وتمارينك ليظهر تدريبك دون إدخاله مرتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo schreibt keine Daten in Health. Es liest nur deine Schrittzahl und Workouts, damit dein Training erscheint, ohne dass du es doppelt eingeben musst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo does not write to Health. It only reads your step count and workouts so your training shows up without entering it twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo no escribe datos en Salud. Solo lee tu conteo de pasos y tus entrenamientos para que tu entrenamiento aparezca sin tener que ingresarlo dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo n’écrit pas dans Santé. Il lit uniquement votre nombre de pas et vos entraînements pour que votre activité apparaisse sans avoir à la saisir deux fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo स्वास्थ्य में कुछ नहीं लिखता। यह सिर्फ़ आपके कदमों की गिनती और वर्कआउट पढ़ता है, ताकि आपकी ट्रेनिंग दो बार दर्ज किए बिना दिखे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivoはヘルスケアにデータを書き込みません。歩数とワークアウトを読み取るだけなので、二重に入力しなくてもトレーニングが表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo não grava dados no app Saúde. Ele só lê sua contagem de passos e seus treinos para que eles apareçam sem precisar inseri-los duas vezes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo не записывает данные в «Здоровье». Приложение только считывает количество шагов и тренировки, чтобы они появлялись без повторного ввода."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo 不会向“健康”写入数据。它只读取你的步数和训练记录，这样你的训练就会显示出来，无需重复输入。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "iOS location permission prompt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Rytivo موقعك لرسم مسارك وقياس المسافة والوتيرة أثناء جلسة جري أو ركوب دراجة أو سباحة. لا يتم التتبّع إلا خلال جلسة تبدأها أنت، ويتوقف عند إنهائها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo verwendet deinen Standort, um deine Route aufzuzeichnen sowie Distanz und Pace zu messen, während eine Lauf-, Rad- oder Schwimmeinheit läuft. Die Aufzeichnung erfolgt nur während einer Einheit, die du startest, und endet, wenn du sie beendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo uses your location to map your route and measure distance and pace while a run, ride, or swim session is running. Tracking only happens during a session you start, and stops when you end it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo usa tu ubicación para trazar tu ruta y medir la distancia y el ritmo mientras está en curso una sesión de carrera, ciclismo o natación. El seguimiento solo ocurre durante una sesión que inicias tú y se detiene cuando la terminas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo utilise votre position pour tracer votre itinéraire et mesurer la distance et l’allure pendant une séance de course, de vélo ou de natation. Le suivi n’a lieu que pendant une séance que vous lancez, et s’arrête quand vous la terminez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दौड़, राइड या तैराकी का सेशन चलने के दौरान Rytivo आपका रूट मैप करने और दूरी व पेस मापने के लिए आपकी लोकेशन का इस्तेमाल करता है। ट्रैकिंग सिर्फ़ आपके शुरू किए गए सेशन के दौरान होती है, और सेशन खत्म करने पर बंद हो जाती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivoは、ラン、ライド、スイムのセッション中に位置情報を使ってルートを地図に記録し、距離とペースを計測します。位置情報の記録は、あなたが開始したセッション中にのみ行われ、セッションを終了すると停止します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo usa sua localização para mapear seu trajeto e medir a distância e o ritmo enquanto uma sessão de corrida, pedalada ou natação está em andamento. O rastreamento só acontece durante uma sessão que você inicia e para quando você a encerra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo использует вашу геопозицию, чтобы нанести маршрут на карту и измерить дистанцию и темп во время пробежки, заезда или заплыва. Отслеживание ведётся только во время занятия, которое вы начали, и прекращается, когда вы его завершаете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo 会在跑步、骑行或游泳训练进行时使用你的位置，以绘制路线并测量距离和配速。仅在你开始的训练期间进行追踪，并在你结束训练时停止。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "iOS microphone permission prompt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الصوت عند التقاط فيديو لمنشورك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm Ton auf, wenn du ein Video für deinen Beitrag aufnimmst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record sound when you capture a video for your post."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba el sonido cuando capturas un video para tu publicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le son lorsque vous filmez une vidéo pour votre publication."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी पोस्ट के लिए वीडियो बनाते समय आवाज़ रिकॉर्ड करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿用の動画を撮影するときに音声を録音します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave o som quando você captura um vídeo para sua publicação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись звука, когда вы снимаете видео для своей публикации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在为帖子拍摄视频时录制声音。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "iOS motion and fitness permission prompt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Rytivo مقياس الضغط الجوي في جهازك أثناء الجري أو ركوب الدراجة أو السباحة لقياس الارتفاع الذي تصعده. ولا يُستخدم إلا أثناء جلسة بدأتها أنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo liest während eines Laufs, einer Radfahrt oder einer Schwimmeinheit das Barometer deines Geräts aus, um die zurückgelegten Höhenmeter zu messen. Es wird nur verwendet, während eine von dir gestartete Einheit läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo reads your device's barometer during a run, ride, or swim to measure the elevation you climb. It is only used while a session you started is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo lee el barómetro de tu dispositivo durante una carrera, un recorrido en bici o una sesión de natación para medir el desnivel que subes. Solo se usa mientras está en curso una sesión que iniciaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo lit le baromètre de votre appareil pendant une course, une sortie à vélo ou une séance de natation pour mesurer le dénivelé que vous gravissez. Il n’est utilisé que pendant une séance que vous avez lancée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दौड़, राइड या तैराकी के दौरान आपकी चढ़ाई की ऊँचाई मापने के लिए Rytivo आपके डिवाइस का बैरोमीटर पढ़ता है। इसका इस्तेमाल सिर्फ़ तभी होता है जब आपका शुरू किया गया सेशन चल रहा हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivoは、ラン、ライド、スイム中にデバイスの気圧計を読み取り、登った標高を計測します。あなたが開始したセッションの実行中にのみ使用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo lê o barômetro do seu dispositivo durante uma corrida, pedalada ou natação para medir o seu ganho de elevação. Ele só é usado enquanto uma sessão iniciada por você está em andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo считывает показания барометра устройства во время пробежки, заезда или заплыва, чтобы измерить набор высоты. Они используются только во время занятия, которое вы начали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo 会在跑步、骑行或游泳期间读取你设备的气压计，以测量你的爬升高度。仅在你开始的训练进行时使用。"
          }
        }
      }
    },
    "RouteTracking" : {
      "comment" : "iOS prompt asking for precise location during a session",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Rytivo إلى موقعك الدقيق لرسم مسار هذا الجري أو ركوب الدراجة أو السباحة ولقياس مسافته. من دونه يمكن توقيت الجلسة، لكن لا يمكن تسجيل أي مسار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo benötigt deinen genauen Standort, um die Route dieses Laufs, dieser Radfahrt oder dieser Schwimmeinheit aufzuzeichnen und ihre Distanz zu messen. Ohne ihn kann die Zeit der Einheit trotzdem gemessen werden, aber es kann keine Route aufgezeichnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo needs your exact location to map the route of this run, ride, or swim and to measure its distance. Without it the session can still be timed, but no route can be recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo necesita tu ubicación exacta para trazar la ruta de esta carrera, recorrido en bici o sesión de natación y para medir su distancia. Sin ella, la sesión se puede cronometrar igualmente, pero no se puede registrar ninguna ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo a besoin de votre position exacte pour tracer l’itinéraire de cette course, sortie à vélo ou séance de natation et en mesurer la distance. Sans elle, la séance peut tout de même être chronométrée, mais aucun itinéraire ne peut être enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस दौड़, राइड या तैराकी का रूट मैप करने और उसकी दूरी मापने के लिए Rytivo को आपकी सटीक लोकेशन चाहिए। इसके बिना भी सेशन का समय गिना जा सकता है, लेकिन कोई रूट रिकॉर्ड नहीं हो सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このラン、ライド、スイムのルートを地図に記録し、距離を計測するために、Rytivoには正確な位置情報が必要です。許可しない場合もセッションの時間は計測できますが、ルートは記録できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo precisa da sua localização exata para mapear o trajeto desta corrida, pedalada ou natação e medir a distância. Sem ela, a sessão ainda pode ser cronometrada, mas nenhum trajeto pode ser registrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo нужна ваша точная геопозиция, чтобы нанести на карту маршрут этой пробежки, заезда или заплыва и измерить его дистанцию. Без неё время занятия всё равно можно засечь, но маршрут записать не получится."
          }
        },
        "zh-Hans" : {
