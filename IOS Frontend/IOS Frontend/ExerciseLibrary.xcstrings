    "Press the band straight out in front of you, resisting the pull that tries to rotate you." : {
      "comment" : "A step of how to do the exercise “Pallof Press (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
