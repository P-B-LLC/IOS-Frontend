            "value" : "ادفع للأعلى للخروج من أسفل القرفصاء بأسرع ما يمكن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich so schnell wie möglich aus der tiefsten Position der Kniebeuge nach oben."
          }
        },
        "es" : {
          "stringUnit" : {
