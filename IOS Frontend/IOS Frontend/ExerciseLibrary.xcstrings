          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich aufrecht hin und führe den rechten Arm quer vor dem Körper über die linke Schulter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie, erguido, y lleva el brazo derecho cruzando el cuerpo por encima del hombro izquierdo."
          }
        },
        "fr" : {
