        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने नितंब को ऊपर और आगे की ओर उठाएं और साथ ही सिर को पीछे लाकर छत की ओर देखें, ताकि पीठ में आर्च बने।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お尻を上前方に持ち上げながら、頭を後ろに倒して天井を見上げ、背中にアーチをつくります。"
