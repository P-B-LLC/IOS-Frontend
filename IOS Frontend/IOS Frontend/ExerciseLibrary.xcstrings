            "state" : "translated",
            "value" : "Lege die Hände auf die Stangen. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca las manos sobre las barras. Esta será tu posición inicial."
          }
        },
        "fr" : {
