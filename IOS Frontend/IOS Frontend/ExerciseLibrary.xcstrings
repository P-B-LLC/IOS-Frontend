        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在动作顶端收缩一秒后，开始吸气，沿着举起时的相同路径，缓慢将重量放回起始位置。"
          }
        }
      }
    },
