          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire a corda com giros rápidos dos punhos, de modo que ela passe sob os pés duas vezes antes de você aterrissar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вращайте скакалку быстрыми движениями кистей так, чтобы она проходила под ногами дважды до приземления."
