    "Repeat for 3-5 repetitions, and continue with a heavier weight, moving as fast as possible." : {
      "comment" : "A step of how to do the exercise “Power Stairs”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كرر الحركة من 3 إلى 5 تكرارات، ثم تابع بوزن أثقل، مع التحرك بأسرع ما يمكن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole 3–5 Wiederholungen und mach mit einem schwereren Gewicht weiter, dabei bewegst du dich so schnell wie möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
