    "Lower your legs to one side, stopping just before they touch the floor while your shoulders stay down." : {
      "comment" : "A step of how to do the exercise “Lying Windshield Wiper”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل ساقيك إلى أحد الجانبين، مع التوقف قبل أن تلمسا الأرض مباشرة بينما يبقى كتفاك على الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die Beine zu einer Seite ab und halte kurz vor der Bodenberührung an, während die Schultern unten bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja las piernas hacia un lado, deteniéndote justo antes de que toquen el suelo mientras los hombros permanecen abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaissez les jambes d'un côté, en vous arrêtant juste avant qu'elles touchent le sol, tandis que vos épaules restent plaquées au sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों को एक तरफ़ नीचे लाएं, फ़र्श को छूने से ठीक पहले रुक जाएं और कंधे नीचे ही रहें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩は床につけたまま、床に触れる直前まで脚を片側に倒します。"
