        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़ोर लगाकर ऊपर उठें और खड़े होते हुए डम्बल को सिर के ऊपर प्रेस करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上がりながら、ダンベルを頭上へ押し上げます。"
