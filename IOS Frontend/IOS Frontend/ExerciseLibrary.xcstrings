        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहां तक हो सके जारी रखें, रुकें, और फिर शुरुआती स्थिति में लौटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能な限り回旋させたら静止し、開始姿勢に戻ります。"
