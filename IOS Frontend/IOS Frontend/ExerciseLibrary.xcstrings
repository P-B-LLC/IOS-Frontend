    "Drop into a burpee, bringing your chest to the floor with the bar in front of you." : {
      "comment" : "A step of how to do the exercise “Bar Facing Burpee”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل في حركة بيربي، مقرّبًا صدرك من الأرض والبار أمامك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe in einen Burpee und bringe deine Brust zu Boden, die Stange liegt vor dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjate caer en un burpee, llevando el pecho al suelo con la barra frente a ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en burpee, la poitrine au sol, la barre devant vous."
          }
        },
        "hi" : {
