    "Run a band around a stationary post like that of a squat rack." : {
      "comment" : "A step of how to do the exercise “Reverse Fly (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر شريطًا حول عمود ثابت مثل حامل السكوات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe ein Band um einen festen Pfosten, zum Beispiel den eines Kniebeugenracks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa una banda alrededor de un poste fijo, como el de un rack de sentadillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez une bande élastique autour d'un poteau fixe, comme celui d'un rack à squat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंड को किसी स्थिर खंभे, जैसे स्क्वॉट रैक, के चारों ओर लपेटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクワットラックなどの固定された支柱にバンドを回します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe uma faixa elástica ao redor de um poste fixo, como o de um rack de agachamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустите резинку вокруг неподвижной опоры, например стойки для приседаний."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将弹力带绕在固定的立柱上，例如深蹲架。"
          }
        }
      }
    },
    "Run in place, driving one knee up to hip height while you stay on the ball of the other foot." : {
      "comment" : "A step of how to do the exercise “High Knee”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركض في المكان، دافعًا إحدى الركبتين إلى مستوى الورك بينما تبقى على مقدمة القدم الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufe auf der Stelle und treibe ein Knie bis auf Hüfthöhe nach oben, während du auf dem Fußballen des anderen Fußes bleibst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre en el sitio, llevando una rodilla hasta la altura de la cadera mientras te mantienes sobre la punta del otro pie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courez sur place en montant un genou à hauteur de hanche tout en restant sur l'avant de l'autre pied."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक घुटने को कूल्हे की ऊंचाई तक ऊपर लाते हुए जगह पर दौड़ें, जबकि दूसरे पैर के पंजे के अगले हिस्से पर टिके रहें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その場で走り、片膝を股関節の高さまで引き上げながら、もう一方の足の指の付け根で立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corra no lugar, levando um joelho até a altura do quadril enquanto permanece na ponta do outro pé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бегите на месте, поднимая одно колено до уровня бедра и оставаясь на подушечке другой стопы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原地跑，一侧膝盖抬到髋部高度，另一只脚保持前脚掌着地。"
          }
        }
      }
    },
    "Run the set distance at maximal effort, then walk back to recover fully before the next rep." : {
      "comment" : "A step of how to do the exercise “Sprint”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجرِ المسافة المحددة بأقصى جهد، ثم امشِ عائدًا للتعافي بالكامل قبل التكرار التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufe die festgelegte Distanz mit maximaler Anstrengung und gehe dann zurück, um dich vor der nächsten Wiederholung vollständig zu erholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre la distancia establecida al máximo esfuerzo y luego regresa caminando para recuperarte por completo antes de la siguiente repetición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courez la distance prévue à effort maximal, puis revenez en marchant pour récupérer complètement avant la répétition suivante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तय दूरी को पूरी ताक़त से दौड़ें, फिर अगली रेप से पहले पूरी तरह रिकवर होने के लिए चलकर वापस आएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定した距離を全力で走り、次の回の前に歩いて戻って十分に回復します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corra a distância definida com esforço máximo e depois volte caminhando para se recuperar totalmente antes da próxima repetição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пробегите заданную дистанцию с максимальным усилием, затем вернитесь шагом и полностью восстановитесь перед следующим повторением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以最大努力跑完设定距离，然后走回起点，充分恢复后再进行下一次。"
          }
        }
      }
    },
    "Run with a tall posture, relaxed shoulders and your arms swinging forward and back." : {
      "comment" : "A step of how to do the exercise “Running”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجرِ بوضعية منتصبة وكتفين مرخيين وذراعين تتأرجحان للأمام والخلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lauf mit aufrechter Haltung, entspannten Schultern und vor und zurück schwingenden Armen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre con la postura erguida, los hombros relajados y los brazos balanceándose hacia delante y hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courez avec une posture haute, les épaules relâchées et les bras balançant d'avant en arrière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीधे पोस्चर, ढीले कंधों और आगे-पीछे झूलती बाजुओं के साथ दौड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背筋を伸ばし、肩の力を抜き、腕を前後に振って走ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corra com postura ereta, ombros relaxados e braços balançando para a frente e para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бегите с вытянутой осанкой, расслабленными плечами и руками, свободно качающимися вперёд и назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跑步时身体挺拔，肩膀放松，手臂前后摆动。"
          }
        }
      }
    },
