          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm mit dem Gewicht über dem Kopf zurück in den Stand und bringe die Füße zusammen. Senke das Gewicht ab, um zur Ausgangsposition zurückzukehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a la posición de pie, sosteniendo el peso sobre la cabeza, y junta los pies. Baja el peso para volver a la posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redressez-vous en gardant la charge au-dessus de la tête et rapprochez les pieds. Abaissez la charge pour revenir à la position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न को सिर के ऊपर रखते हुए खड़ी स्थिति में लौटें और पैरों को साथ ले आएं। शुरुआती स्थिति में लौटने के लिए वज़न को नीचे लाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
