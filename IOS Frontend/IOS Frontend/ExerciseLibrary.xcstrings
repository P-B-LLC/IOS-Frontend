        }
      }
    },
    "Walk forward with short, controlled steps, keeping the bag high and your core braced." : {
      "comment" : "A step of how to do the exercise “Sandbag Carry”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امشِ للأمام بخطوات قصيرة ومتحكَّم بها، مع إبقاء الكيس مرتفعًا وعضلات جذعك مشدودة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
