    "Stand in the middle of the bar length wise." : {
      "comment" : "A step of how to do the exercise “Jefferson Squat (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف في منتصف البار على امتداد طوله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich in die Mitte der Stange, in Längsrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate en el centro de la barra, a lo largo de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout au milieu de la barre, dans le sens de sa longueur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार की लंबाई के बीचों-बीच खड़े हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
