            "value" : "हाथों को बार पर रखें, कंधों की चौड़ाई से ज़्यादा चौड़े।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーに手を置き、手は肩幅より広く開きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque as mãos na barra, mais afastadas que a largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите ладони на гриф, ладони шире плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手放在杠上，握距比肩宽。"
          }
        }
      }
    },
    "Place your hands on the bars. This will be your starting position." : {
