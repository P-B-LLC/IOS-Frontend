          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringe das Gewicht vorsichtig zurück auf den Boden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el peso al suelo con cuidado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposez la charge au sol avec précaution."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न को सावधानी से वापस ज़मीन पर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重りを慎重に床に戻します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolva o peso ao chão com cuidado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккуратно верните вес на пол."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小心地将重量放回地面。"
          }
        }
      }
    },
