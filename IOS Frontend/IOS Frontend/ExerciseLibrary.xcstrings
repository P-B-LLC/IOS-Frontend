    "Low Cable Crossover" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كروس أوفر بالكابل من الأسفل"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabelzug-Crossover von unten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruce de poleas bajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poulie vis-à-vis basse"
          }
