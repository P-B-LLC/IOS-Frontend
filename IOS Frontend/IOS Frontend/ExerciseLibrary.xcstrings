        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धड़ को दूसरी ओर झुकाते हुए कोहनी को छत की ओर उठाएं। 10 से 20 सेकंड रुकें, फिर दूसरी तरफ़ बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
