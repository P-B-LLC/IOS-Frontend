          }
        }
      }
    },
    "Hold your back parallel to the floor with your knees tucked and your shoulders pulled down." : {
      "comment" : "A step of how to do the exercise “Tuck Front Lever”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ ظهرك موازيًا للأرض وركبتيك مثنيتين نحو صدرك وكتفيك مسحوبين للأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Rücken parallel zum Boden, die Knie angezogen und die Schultern nach unten gezogen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la espalda paralela al suelo con las rodillas encogidas y los hombros hacia abajo."
