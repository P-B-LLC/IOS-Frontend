    "Stand facing a wall in a half-kneeling or split stance with your front toes a few inches from the wall." : {
      "comment" : "A step of how to do the exercise “Knee to Wall Ankle Mobilization”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف مواجهًا الحائط في وضع الركوع على ركبة واحدة أو وقفة الانقسام، مع إبقاء أصابع قدمك الأمامية على بعد بضعة سنتيمترات (نحو 5 سم) من الحائط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich mit Blick zur Wand in einen halben Kniestand oder einen Ausfallschritt, die vorderen Zehen sind einige Zentimeter von der Wand entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de cara a una pared en posición de media rodilla o en tijera, con la punta del pie delantero a unos 5-8 cm de la pared."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous face à un mur en fente à genou ou en position fendue, les orteils du pied avant à quelques centimètres (environ 5-8 cm) du mur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दीवार की ओर मुंह करके हाफ़-नीलिंग या स्प्लिट स्टांस में खड़े हों, आपके आगे वाले पंजे दीवार से कुछ इंच (लगभग 5-8 सेमी) दूर हों।"
          }
