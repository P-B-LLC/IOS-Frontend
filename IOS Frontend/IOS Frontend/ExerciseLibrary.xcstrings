          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निचली कमर को फ़र्श में दबाएं और कंधों, बाजुओं और पैरों को कुछ सेमी ऊपर उठाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
