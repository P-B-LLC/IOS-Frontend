        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corra em velocidade máxima da primeira linha até a segunda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спринтом пробегите от первой линии ко второй."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从第一条线冲刺到第二条线。"
          }
        }
      }
    },
    "Square your hips and lower them toward the floor, supporting yourself on your hands or forearms." : {
      "comment" : "A step of how to do the exercise “Pigeon Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوِّ وركيك وأنزلهما نحو الأرض، مع دعم نفسك على يديك أو ساعديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Hüfte gerade aus und senke sie zum Boden ab, dabei stützt du dich auf Hände oder Unterarme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinea las caderas y bájalas hacia el suelo, apoyándote en las manos o los antebrazos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez les hanches d'aplomb et abaissez-les vers le sol, en vous soutenant avec les mains ou les avant-bras."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों को सीधा रखें और उन्हें फ़र्श की ओर नीचे लाएं, खुद को हाथों या फ़ोरआर्म पर सहारा दें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腰を正面に向けて床の方へ下ろし、手または前腕で体を支えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinhe o quadril e abaixe-o em direção ao chão, apoiando-se nas mãos ou nos antebraços."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выровняйте таз и опустите его к полу, опираясь на руки или предплечья."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摆正髋部并向地面降低，用双手或前臂支撑身体。"
          }
        }
      }
    },
