            "value" : "بعد توقف لثانية واحدة، عد إلى وضع البداية مع الشهيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh nach einer Sekunde Pause beim Einatmen zurück in die Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una pausa de un segundo, vuelve a la posición inicial mientras inhalas."
          }
        },
        "fr" : {
