          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खड़े होकर, बगल में दो डम्बल पकड़ें। यही आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立った姿勢で、ダンベルを1組、体の横に持ちます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
