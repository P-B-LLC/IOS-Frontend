    "Touch the soles of your feet together with your feet six to eight inches in front of your hips." : {
      "comment" : "A step of how to do the exercise “Seated Overhead Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضمم باطني قدميك معًا بحيث تكون القدمان على بعد 15-20 سم أمام وركيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring die Fußsohlen aneinander, die Füße 15–20 cm vor der Hüfte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta las plantas de los pies, con los pies a unos 15-20 cm frente a las caderas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joignez la plante des pieds, les pieds à 15-20 cm devant vos hanches."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों के तलवे आपस में छुआएं, पैर कूल्हों से लगभग 15-20 सेमी आगे हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足裏同士を合わせ、足を股関節の約15~20cm前に置きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encoste as solas dos pés, com os pés de 15 a 20 cm à frente do quadril."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соедините подошвы стоп так, чтобы стопы находились в 15–20 см перед бёдрами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双脚脚掌相贴，双脚位于髋部前方约15至20厘米。"
          }
        }
      }
    },
