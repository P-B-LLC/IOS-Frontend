    "Press the kettlebell by extending the elbow and adducting the arm, pressing it above your body. Return to the starting position." : {
      "comment" : "A step of how to do the exercise “Extended Range Single Arm Floor Press (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع الكيتل بيل بمدّ المرفق وتقريب الذراع، مرفوعًا فوق جسمك. ثم عد إلى وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke die Kettlebell, indem du den Ellbogen streckst und den Arm heranführst, sodass sie über deinem Körper ist. Kehre in die Ausgangsposition zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona la pesa rusa extendiendo el codo y aduciendo el brazo, empujándola por encima de tu cuerpo. Vuelve a la posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez le kettlebell en tendant le coude et en rapprochant le bras de l'axe du corps, pour le pousser au-dessus de vous. Revenez à la position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहनी को सीधा करके और बाजू को अंदर की ओर लाकर केटलबेल को अपने शरीर के ऊपर प्रेस करें। शुरुआती स्थिति में लौटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肘を伸ばして腕を内転させながらケトルベルをプレスし、体の上に押し上げます。開始姿勢に戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre o kettlebell estendendo o cotovelo e aduzindo o braço, levando-o acima do corpo. Volte à posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите гирю, разгибая локоть и приводя руку к корпусу, поднимая её над собой. Вернитесь в исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伸直肘部并内收手臂，将壶铃推举到身体上方。然后回到起始姿势。"
          }
        }
      }
    },
    "Press the kettlebell into a locked out position." : {
      "comment" : "A step of how to do the exercise “Leg-Over Floor Press (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع الكيتل بيل حتى يُقفل المرفق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück die Kettlebell nach oben, bis der Arm durchgestreckt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja la pesa rusa hasta bloquear el codo arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez le kettlebell jusqu'à avoir le bras verrouillé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केटलबेल को लॉकआउट की स्थिति तक ऊपर प्रेस करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケトルベルを、腕がロックするまで押し上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre o kettlebell até estender totalmente o braço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите гирю до полного выпрямления руки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将壶铃推至锁定位置。"
          }
        }
      }
    },
    "Press the kettlebell straight up toward the ceiling, rotating your wrist." : {
      "comment" : "A step of how to do the exercise “Single Arm Floor Press (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع الكيتل بيل مباشرة نحو السقف مع تدوير معصمك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück die Kettlebell gerade nach oben zur Decke und dreh dabei das Handgelenk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja la pesa rusa directamente hacia el techo, rotando la muñeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez la kettlebell droit vers le plafond en tournant le poignet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कलाई को घुमाते हुए केटलबेल को सीधे छत की ओर ऊपर प्रेस करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首を回しながら、ケトルベルを天井に向けてまっすぐ押し上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre o kettlebell diretamente para cima, em direção ao teto, girando o punho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите гирю строго вверх к потолку, поворачивая запястье."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将壶铃笔直向天花板推起，同时转动手腕。"
          }
        }
      }
    },
    "Press the kettlebell up and out until it is locked out overhead. Return to the starting position." : {
      "comment" : "A step of how to do the exercise “Seated Overhead Press (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع الكيتل بيل للأعلى وللخارج حتى تفرد ذراعك تمامًا فوق الرأس. ثم عد إلى وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück die Kettlebell nach oben und nach außen, bis die Arme über Kopf durchgestreckt sind. Kehre in die Ausgangsposition zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja la pesa rusa hacia arriba y hacia fuera hasta bloquearla por encima de la cabeza. Vuelve a la posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez la kettlebell vers le haut et l'extérieur jusqu'au verrouillage au-dessus de la tête. Revenez à la position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केटलबेल को ऊपर और बाहर की ओर प्रेस करें जब तक वह सिर के ऊपर लॉकआउट न हो जाए। वापस शुरुआती स्थिति में लौटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケトルベルを上方かつ外側に、頭上でロックアウトするまで押し上げます。開始姿勢に戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre o kettlebell para cima e para fora até ficar estendido acima da cabeça. Volte à posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите гирю вверх и в сторону до полного выпрямления руки над головой. Вернитесь в исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将壶铃向上向外推，直到在头顶锁定。回到起始姿势。"
          }
        }
      }
    },
    "Press the kettlebells up and out. As the kettlebells pass your head, lean into the weights so that the kettlebells are racked behind your head. Make sure to contract your lats, butt, and stomach for added stability." : {
      "comment" : "A step of how to do the exercise “Double Overhead Press (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع الكيتل بيل للأعلى وللخارج. عندما يمر الكيتل بيل بجانب رأسك، مِل نحو الأوزان بحيث يستقر الكيتل بيل خلف رأسك. احرص على شد الظهرية العريضة والأرداف والبطن لمزيد من الثبات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke die Kettlebells nach oben und nach außen. Sobald die Kettlebells deinen Kopf passieren, lehne dich in die Gewichte, sodass die Kettlebells hinter deinem Kopf abgelegt sind. Spanne Latissimus, Gesäß und Bauch für zusätzliche Stabilität an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona las pesas rusas hacia arriba y hacia fuera. Cuando las pesas pasen por la cabeza, inclínate hacia los pesos de modo que queden apoyadas detrás de la cabeza. Asegúrate de contraer los dorsales, los glúteos y el abdomen para mayor estabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez les kettlebells vers le haut et vers l'extérieur. Lorsque les kettlebells passent devant votre tête, penchez-vous vers eux pour qu'ils se retrouvent en appui derrière la tête. Veillez à contracter les grands dorsaux, les fessiers et l'abdomen pour plus de stabilité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केटलबेल को ऊपर और बाहर की ओर प्रेस करें। जब केटलबेल आपके सिर के पास से गुज़रें, तो वज़न की ओर झुकें ताकि केटलबेल सिर के पीछे रैक हो जाएं। अतिरिक्त स्थिरता के लिए लैट्स, नितंबों और पेट को सिकोड़ना न भूलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケトルベルを上方と外側へ押し上げます。ケトルベルが頭を通過するとき、重りに体を預けるようにして、ケトルベルが頭の後ろに収まるようにします。安定性を高めるために、広背筋、お尻、お腹に力を入れてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre os kettlebells para cima e para fora. Quando os kettlebells passarem pela cabeça, incline-se para dentro dos pesos de modo que fiquem apoiados atrás da cabeça. Contraia os dorsais, os glúteos e o abdômen para ter mais estabilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите гири вверх и в стороны. Когда гири проходят уровень головы, подайтесь корпусом вперёд под вес, чтобы гири оказались за головой. Напрягите широчайшие, ягодицы и живот для дополнительной устойчивости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将壶铃向上、向外推起。壶铃经过头部时，身体向重量方向前倾，使壶铃架在头后方。务必收紧背阔肌、臀部和腹部以增加稳定性。"
          }
        }
      }
    },
    "Press through that foot to step up, bringing the other foot to meet it, then stand tall." : {
      "comment" : "A step of how to do the exercise “Step Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط بتلك القدم لتصعد، وأحضر القدم الأخرى لتلحق بها، ثم قف منتصبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich über diesen Fuß nach oben, hole den anderen Fuß nach und stelle dich aufrecht hin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja con ese pie para subir, llevando el otro pie hasta juntarlo, y luego ponte erguido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez dans ce pied pour monter, en ramenant l'autre pied à sa hauteur, puis redressez-vous complètement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस पैर से ज़ोर लगाकर ऊपर चढ़ें, दूसरे पैर को उसके पास लाएं, फिर सीधे खड़े हो जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その足で押してステップアップし、もう一方の足を引き寄せてそろえ、まっすぐ立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre com esse pé para subir, levando o outro pé até o degrau, e fique totalmente em pé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оттолкнитесь этой ногой, чтобы подняться, приставьте к ней другую ногу, затем выпрямитесь в полный рост."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这只脚发力蹬起上台阶，另一只脚跟上并拢，然后站直。"
          }
        }
      }
    },
    "Press through your arms at the same moment so you finish with your elbows locked." : {
      "comment" : "A step of how to do the exercise “Kipping Handstand Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع بذراعيك في اللحظة نفسها لتنهي الحركة ومرفقاك مقفلان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich im selben Moment durch die Arme nach oben, sodass du mit durchgestreckten Ellbogen endest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja con los brazos en ese mismo momento para terminar con los codos bloqueados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez avec les bras au même moment pour terminer les coudes verrouillés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसी पल बाजुओं से ऊपर प्रेस करें ताकि अंत में कोहनियां लॉक हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時に腕で押し、肘をロックして終わります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre com os braços ao mesmo tempo, para terminar com os cotovelos estendidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одновременно выжимайте себя руками, чтобы завершить движение с зафиксированными локтями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时通过手臂发力推起，最后肘部锁定。"
          }
        }
      }
    },
    "Press through your feet to stand up fully, using your hands on your thighs or the armrests if needed." : {
      "comment" : "A step of how to do the exercise “Sit to Stand”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط بقدميك لتقف بالكامل، مستخدمًا يديك على فخذيك أو مساند الذراعين إذا لزم الأمر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich über die Füße vollständig nach oben in den Stand. Nutze bei Bedarf die Hände auf den Oberschenkeln oder den Armlehnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja con los pies para ponerte de pie por completo, apoyando las manos en los muslos o en los reposabrazos si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez dans vos pieds pour vous lever complètement, en vous aidant de vos mains sur les cuisses ou sur les accoudoirs si nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी तरह खड़े होने के लिए पैरों से ज़ोर लगाएं, ज़रूरत हो तो जांघों पर हाथ या आर्मरेस्ट का सहारा लें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足で床を押して完全に立ち上がります。必要なら太ももの上や肘掛けに手をついて構いません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre com os pés para ficar totalmente em pé, usando as mãos apoiadas nas coxas ou nos braços da cadeira, se necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оттолкнитесь ступнями и полностью встаньте, при необходимости опираясь руками на бёдра или подлокотники."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双脚发力蹬地完全站起，需要时可用手撑住大腿或扶手。"
          }
        }
      }
    },
    "Press two lightweight plates together with your hands. Hold the plates together close to your chest to create an isometric contraction in your chest muscles. Your fingers should be pointed forward. This is your starting position." : {
      "comment" : "A step of how to do the exercise “Svend Press”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط قرصين خفيفين معًا بيديك. أمسك القرصين معًا قرب صدرك لتوليد انقباض ثابت في عضلات صدرك. يجب أن تكون أصابعك موجهة للأمام. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke zwei leichte Hantelscheiben mit den Händen zusammen. Halte die Scheiben nah an der Brust zusammen, um eine isometrische Anspannung in den Brustmuskeln zu erzeugen. Deine Finger zeigen nach vorn. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona dos discos ligeros uno contra otro con las manos. Mantén los discos juntos cerca del pecho para crear una contracción isométrica en los músculos pectorales. Los dedos deben apuntar hacia delante. Esta es tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressez deux disques légers l'un contre l'autre avec les mains. Tenez les disques ensemble près de votre poitrine pour créer une contraction isométrique des pectoraux. Vos doigts doivent pointer vers l'avant. Ceci est votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो हल्की प्लेटों को अपने हाथों से आपस में दबाएं। प्लेटों को छाती के पास साथ में पकड़ें ताकि छाती की मांसपेशियों में आइसोमेट्रिक संकुचन बने। आपकी उंगलियां आगे की ओर होनी चाहिए। यह आपकी शुरुआती स्थिति है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2枚の軽いプレートを両手で押し合わせます。プレートを胸の近くで合わせて保持し、胸の筋肉にアイソメトリック収縮を作ります。指は前に向けます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione duas anilhas leves uma contra a outra com as mãos. Mantenha as anilhas juntas, próximas ao peito, para criar uma contração isométrica nos músculos do peito. Os dedos devem apontar para a frente. Esta é a posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сожмите руками два лёгких блина друг с другом. Держите блины вместе близко к груди, чтобы создать изометрическое сокращение грудных мышц. Пальцы направлены вперёд. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手将两个轻的杠铃片压在一起。把杠铃片紧贴胸前，使胸肌产生等长收缩。手指指向前方。这就是起始姿势。"
          }
        }
      }
    },
    "Press your chest toward your thighs and reach your heels toward the floor, bending your knees if needed." : {
      "comment" : "A step of how to do the exercise “Downward Dog”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط بصدرك نحو فخذيك ومدّ كعبيك نحو الأرض، مع ثني ركبتيك عند الحاجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke die Brust in Richtung der Oberschenkel und schiebe die Fersen zum Boden, die Knie darfst du bei Bedarf beugen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva el pecho hacia los muslos y estira los talones hacia el suelo, flexionando las rodillas si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez la poitrine vers les cuisses et allongez les talons vers le sol, en fléchissant les genoux si nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छाती को जांघों की ओर दबाएं और एड़ियों को फ़र्श की ओर ले जाएं, ज़रूरत हो तो घुटने मोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸を太ももに向かって押し込み、かかとを床に向かって伸ばします。必要であれば膝を曲げてもかまいません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre o peito em direção às coxas e leve os calcanhares em direção ao chão, flexionando os joelhos se necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тянитесь грудью к бёдрам, а пятками к полу, при необходимости сгибая колени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将胸部向大腿方向压，脚跟向地面延伸，如有需要可以弯曲膝盖。"
          }
        }
      }
    },
    "Press your elbows against the inside of your knees and keep your chest up." : {
      "comment" : "A step of how to do the exercise “Deep Squat Hold”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
