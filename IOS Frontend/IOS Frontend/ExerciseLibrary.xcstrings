          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь вперёд от бёдер и потянитесь к лодыжке, пока не почувствуете растяжение в бицепсе бедра. Удерживайте 15 секунд, затем повторите в другую сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从髋部前倾，伸手去够脚踝，直到腘绳肌感到拉伸。保持15秒，然后换另一侧重复。"
          }
        }
      }
    },
