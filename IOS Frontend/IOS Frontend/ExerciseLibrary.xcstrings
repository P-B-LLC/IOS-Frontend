        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双脚平放在地面上，双臂举过头顶，掌心交叉。这就是起始姿势。"
          }
        }
      }
    },
    "Keep your feet on the floor or a step." : {
