    "Leg Extension (Machine)" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مد الساقين (جهاز)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beinstrecker (Gerät)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extensión de piernas (Máquina)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg extension (Machine)"
          }
