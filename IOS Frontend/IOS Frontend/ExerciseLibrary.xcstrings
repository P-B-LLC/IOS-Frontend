          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसे केबल रो मशीन की सीट पर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
