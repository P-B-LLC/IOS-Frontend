          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout, les pieds un peu plus écartés que les épaules et les orteils légèrement tournés vers l'extérieur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों को कंधों से थोड़ा ज़्यादा चौड़ा रखकर खड़े हों और पंजे हल्के से बाहर की ओर मुड़े हों।"
