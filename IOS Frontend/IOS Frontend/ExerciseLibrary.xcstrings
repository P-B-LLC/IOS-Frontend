            "state" : "translated",
            "value" : "Setz dich aufrecht auf den Boden, dein Partner sitzt hinter dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido en el suelo con tu compañero detrás de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
