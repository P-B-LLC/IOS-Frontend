    "Switch legs, raising the opposite knee, and then attacking the ground straight down." : {
      "comment" : "A step of how to do the exercise “Linear Acceleration Wall Drill”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل الساقين، فارفع الركبة المقابلة، ثم اضرب الأرض مباشرة للأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle das Bein, heb das andere Knie an und stampf es dann gerade nach unten in den Boden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia de pierna, subiendo la rodilla contraria, y luego golpea el suelo directamente hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de jambe, levez le genou opposé, puis frappez le sol droit vers le bas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैर बदलें, विपरीत घुटना उठाएं, और फिर उसे सीधा ज़मीन पर पटकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚を替えて反対の膝を持ち上げ、同じように真下に地面へ叩きつけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque de perna, levantando o joelho oposto, e depois ataque o chão diretamente para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смените ногу: поднимите противоположное колено и так же резко ударьте стопой прямо вниз в пол."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换腿，抬起另一侧膝盖，然后同样直接向下踩向地面。"
          }
        }
      }
    },
    "Switch movements by raising your right leg up and lowering your left leg. Remember to breathe while performing this exercise." : {
      "comment" : "A step of how to do the exercise “Scissor Kick”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل الحركتين برفع ساقك اليمنى وخفض ساقك اليسرى. تذكّر أن تتنفس أثناء أداء هذا التمرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle die Bewegung, indem du das rechte Bein anhebst und das linke absenkst. Denk daran, bei dieser Übung weiterzuatmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia los movimientos subiendo la pierna derecha y bajando la izquierda. Recuerda respirar mientras haces este ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inversez les mouvements en levant la jambe droite et en abaissant la jambe gauche. N'oubliez pas de respirer pendant cet exercice."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दाहिने पैर को ऊपर और बाएँ पैर को नीचे करके मूवमेंट बदलें। यह एक्सरसाइज़ करते समय साँस लेना न भूलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右脚を上げて左脚を下ろし、動作を入れ替えます。この種目の間は呼吸を忘れないでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque os movimentos elevando a perna direita e abaixando a esquerda. Lembre-se de respirar durante este exercício."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смените движения, поднимая правую ногу и опуская левую. Не забывайте дышать во время выполнения упражнения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交换动作，抬起右腿，降低左腿。记得做这个动作时要呼吸。"
          }
        }
      }
    },
