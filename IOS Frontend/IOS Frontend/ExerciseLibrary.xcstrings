        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez-la là un instant sans toucher la poitrine et sans relâcher la tension."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसे वहीं थोड़ी देर रोकें, बिना छाती को छुए और बिना तनाव खोए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸に触れず、緊張を保ったまま、そこでしばらく保持します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha-a ali por um momento, sem tocar o peito nem perder a tensão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте его там мгновение, не касаясь груди и не теряя напряжения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在那里停留片刻，不要触碰胸部，也不要放松身体的紧绷。"
          }
        }
      }
    },
    "Hold on to the bar using both arms at each side (palms facing forward), unlock it and lift it off the rack by first pushing with your legs and at the same time straightening your torso." : {
      "comment" : "A step of how to do the exercise “Bulgarian Split Squat (Smith Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك البار بكلتا يديك على جانبيك (راحتا اليدين متجهتان إلى الأمام)، وحرّره وارفعه عن الحامل بالدفع أولًا بساقيك مع تقويم جذعك في الوقت نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Stange mit beiden Armen an den Seiten fest (Handflächen zeigen nach vorn), entriegele sie und hebe sie aus der Halterung, indem du zuerst mit den Beinen drückst und gleichzeitig deinen Oberkörper aufrichtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujeta la barra con ambos brazos a cada lado (palmas hacia delante), desbloquéala y levántala del soporte empujando primero con las piernas y enderezando al mismo tiempo el torso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez la barre à deux mains de chaque côté (paumes tournées vers l'avant), déverrouillez-la et décrochez-la du rack en poussant d'abord avec les jambes tout en redressant le buste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों हाथों से बार को दोनों तरफ से पकड़ें (हथेलियां सामने की ओर), उसे अनलॉक करें और पहले पैरों से धक्का देते हुए और साथ ही धड़ को सीधा करते हुए उसे रैक से उठाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両手(手のひらは前に向ける)でバーの両側を握り、ロックを外して、まず脚で押しながら同時に上体をまっすぐ起こして、ラックからバーを持ち上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure a barra com os dois braços, um de cada lado (palmas voltadas para a frente), destrave-a e tire-a do suporte empurrando primeiro com as pernas e, ao mesmo tempo, endireitando o tronco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держитесь за гриф обеими руками по бокам (ладони вперёд), разблокируйте его и снимите со стойки, сначала оттолкнувшись ногами и одновременно выпрямив корпус."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手分别握住杠铃杆两侧（掌心朝前），将其解锁，先用双腿发力蹬起，同时挺直躯干，将杠铃从架上抬起。"
          }
        }
      }
    },
