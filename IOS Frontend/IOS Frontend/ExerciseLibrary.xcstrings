    "Switch sides. This stretches the buttocks and lower back of the bent leg and the hip flexor of the straight leg." : {
      "comment" : "A step of how to do the exercise “Single Knee to Chest Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل الجانب. يطيل هذا التمرين الأرداف وأسفل الظهر في الساق المثنية وعضلة ثني الورك في الساق المستقيمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle die Seite. Das dehnt das Gesäß und den unteren Rücken auf der Seite des gebeugten Beins sowie den Hüftbeuger des gestreckten Beins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia de lado. Esto estira los glúteos y la zona lumbar de la pierna flexionada y el flexor de cadera de la pierna extendida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de côté. Cet exercice étire les fessiers et le bas du dos du côté de la jambe fléchie, ainsi que le fléchisseur de hanche de la jambe tendue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइड बदलें। इससे मुड़े हुए पैर के नितंब और निचली कमर तथा सीधे पैर के हिप फ़्लेक्सर में स्ट्रेच आता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右を入れ替えます。これで曲げた脚側の臀部と腰、そして伸ばした脚側の股関節屈筋が伸びます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque de lado. Isso alonga o glúteo e a região lombar da perna flexionada e o flexor do quadril da perna estendida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смените сторону. Это растягивает ягодицы и поясницу со стороны согнутой ноги и сгибатели бедра вытянутой ноги."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换边。这会拉伸弯曲腿一侧的臀部和下背部，以及伸直腿一侧的髋屈肌。"
          }
        }
      }
    },
