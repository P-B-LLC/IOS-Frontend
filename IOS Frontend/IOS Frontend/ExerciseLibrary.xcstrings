          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie con los pies separados al ancho de las caderas y activa el core."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout, les pieds écartés de la largeur des hanches, et gainez le tronc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों को कूल्हों की चौड़ाई पर रखकर खड़े हों और कोर को कसें।"
          }
        },
        "ja" : {
