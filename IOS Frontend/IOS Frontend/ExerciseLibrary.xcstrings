    "Hold the straight bar attachment using an underhand grip (palms up) that is about shoulder width." : {
      "comment" : "A step of how to do the exercise “Lying High Pulley Bicep Curl - Close Grip (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك ملحق البار المستقيم بقبضة سفلية (الراحتان للأعلى) بعرض الكتفين تقريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den geraden Stangenaufsatz im Untergriff (Handflächen nach oben) in etwa schulterbreitem Abstand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujeta el accesorio de barra recta con agarre supino (palmas hacia arriba) más o menos a la anchura de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez la barre droite en supination (paumes vers le haut), à peu près à la largeur des épaules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्ट्रेट बार अटैचमेंट को अंडरहैंड ग्रिप (हथेलियां ऊपर) से पकड़ें, जो लगभग कंधों की चौड़ाई जितनी हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレートバーアタッチメントを、肩幅程度のアンダーハンドグリップ(手のひらを上向き)で持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure a barra reta com pegada supinada (palmas para cima) aproximadamente na largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмитесь за прямую рукоять обратным хватом (ладони вверх) примерно на ширине плеч."
