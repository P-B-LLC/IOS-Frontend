        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहनियां मोड़कर चेन को नीचे लाएं, चेन का कुछ हिस्सा फ़र्श पर उतरने दें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肘を曲げてチェーンを下ろし、チェーンの一部を床に落とします。"
