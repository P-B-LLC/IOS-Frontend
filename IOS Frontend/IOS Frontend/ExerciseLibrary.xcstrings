          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre langsam zurück und führe deine Wiederholungen aus, bevor du das Bein wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve lentamente y completa tus repeticiones antes de cambiar de pierna."
