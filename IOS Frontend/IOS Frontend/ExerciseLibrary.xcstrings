    "Descend by flexing at the elbow, lowering your chest toward the ground." : {
      "comment" : "A step of how to do the exercise “Clock Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل بثني المرفق، مقرّبًا صدرك من الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe nach unten, indem du die Ellbogen beugst und die Brust zum Boden absenkst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desciende flexionando el codo, bajando el pecho hacia el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en fléchissant les coudes, en abaissant la poitrine vers le sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहनियां मोड़कर नीचे आएं, छाती को ज़मीन की ओर नीचे लाते हुए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肘を曲げて、胸を地面に向かって下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça flexionando o cotovelo, abaixando o peito em direção ao chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опускайтесь, сгибая локти, опуская грудь к земле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屈肘下降，将胸部降向地面。"
          }
        }
      }
    },
    "Descend by flexing at the elbow, lowering your chest towards the ground." : {
      "comment" : "A step of how to do the exercise “Plyo Push Up”.",
      "extractionState" : "manual",
