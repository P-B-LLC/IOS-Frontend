        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez pour sortir du squat et servez-vous de cet élan pour pousser et lancer le ballon vers une cible placée sur le mur au-dessus de vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्वॉट से ज़ोर लगाकर ऊपर उठें और उस मोमेंटम का उपयोग करके गेंद को अपने ऊपर दीवार पर बने टारगेट की ओर प्रेस करके फेंकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクワットから立ち上がり、その勢いを使って、頭上の壁にあるターゲットにボールをプレスして投げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba do agachamento e use esse impulso para empurrar e arremessar a bola em um alvo na parede acima de você."
