    "Stay tight and return the working leg to the starting position." : {
      "comment" : "A step of how to do the exercise “Dead Bug”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابقَ مشدودًا وأعد الساق العاملة إلى وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib angespannt und führe das arbeitende Bein zurück in die Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la tensión y vuelve a llevar la pierna que trabaja a la posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez gainé et ramenez la jambe qui travaille à la position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरीर को कसा हुआ रखें और काम करने वाले पैर को शुरुआती स्थिति में वापस लाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力を抜かずに、動かしている脚を開始姿勢に戻します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o corpo firme e leve a perna que está trabalhando de volta à posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставайтесь в напряжении и верните рабочую ногу в исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持紧绷，将工作腿收回到起始位置。"
          }
        }
      }
    },
