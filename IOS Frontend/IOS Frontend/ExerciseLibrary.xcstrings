    "Hang from a bar or rings with an overhand grip and straight arms." : {
      "comment" : "A step of how to do the exercise “Front Lever”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدلَّ من بار أو حلقات بقبضة علوية وذراعين مستقيمتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge dich mit Obergriff und gestreckten Armen an eine Stange oder an Ringe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuélgate de una barra o de anillas con agarre prono y los brazos rectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez-vous à une barre ou à des anneaux en pronation, les bras tendus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओवरहैंड ग्रिप और सीधी बाजुओं के साथ बार या रिंग्स से लटकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーまたは吊り輪を順手で握り、腕をまっすぐにしてぶら下がります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure-se em uma barra ou em argolas com pegada pronada e braços esticados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повисните на турнике или кольцах хватом сверху на прямых руках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用正握悬挂在杠或吊环上，手臂伸直。"
          }
        }
      }
    },
    "Hang from a bar with straight arms and tuck your knees tightly to your chest." : {
      "comment" : "A step of how to do the exercise “Tuck Front Lever”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدلَّ من بار بذراعين مستقيمتين واثنِ ركبتيك بإحكام نحو صدرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge mit gestreckten Armen an einer Stange und ziehe die Knie fest zur Brust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuélgate de una barra con los brazos rectos y encoge las rodillas con fuerza hacia el pecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez-vous à une barre, bras tendus, et groupez fermement les genoux contre la poitrine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीधी बाजुओं के साथ बार से लटकें और घुटनों को कसकर छाती तक मोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーに腕を伸ばしてぶら下がり、膝を胸にしっかり引き寄せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure-se em uma barra com os braços retos e encolha bem os joelhos em direção ao peito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повисните на перекладине на прямых руках и плотно подтяните колени к груди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手臂伸直悬挂在杠上，将膝盖紧紧收向胸部。"
          }
        }
      }
    },
    "Hang from a chin-up bar using an underhand grip (palms facing you) that is slightly wider than shoulder width." : {
      "comment" : "A step of how to do the exercise “Gorilla Chin Crunch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدلَّ من عقلة بقبضة سفلية (راحتاك نحوك) أوسع قليلًا من عرض الكتفين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge dich mit Untergriff (Handflächen zu dir) und etwas mehr als schulterbreiter Griffbreite an eine Klimmzugstange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuélgate de una barra para dominadas con agarre supino (palmas hacia ti), ligeramente más ancho que los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez-vous à une barre de traction en supination (paumes tournées vers vous), un peu plus large que les épaules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंधों की चौड़ाई से थोड़ी चौड़ी अंडरहैंड ग्रिप (हथेलियां आपकी ओर) से चिन-अप बार से लटकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩幅よりやや広い逆手(手のひらを自分に向ける)でチンニングバーにぶら下がります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure-se em uma barra de remada com pegada supinada (palmas voltadas para você), um pouco mais larga que os ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повисните на турнике обратным хватом (ладони к себе) чуть шире плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用反握（掌心朝向自己）悬挂在引体向上杆上，握距比肩稍宽。"
          }
        }
      }
    },
    "Hang from a chin-up bar with both arms extended at arms length in top of you using either a wide grip or a medium grip. The legs should be straight down with the pelvis rolled slightly backwards. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Hanging Leg Raise”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدلَّ من عقلة بكلتا ذراعيك ممدودتين فوقك بقبضة واسعة أو متوسطة. يجب أن تكون الساقان مستقيمتين للأسفل مع إمالة الحوض للخلف قليلًا. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge dich an eine Klimmzugstange, beide Arme über dir gestreckt, mit breitem oder mittlerem Griff. Die Beine hängen gerade nach unten, das Becken ist leicht nach hinten gekippt. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuélgate de una barra para dominadas con ambos brazos extendidos por encima de ti, con un agarre ancho o medio. Las piernas deben colgar rectas hacia abajo con la pelvis ligeramente inclinada hacia atrás. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez-vous à une barre de traction, les deux bras tendus au-dessus de vous, avec une prise large ou moyenne. Les jambes pendent à la verticale, le bassin légèrement basculé vers l'arrière. Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चौड़ी या मध्यम ग्रिप से चिन-अप बार पर लटकें, दोनों बाजुएं अपने ऊपर पूरी लंबाई तक सीधी हों। पैर सीधे नीचे हों और श्रोणि थोड़ी पीछे की ओर घूमी हो। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイドグリップまたはミディアムグリップで、チンニングバーに両腕を頭上に伸ばしてぶら下がります。脚はまっすぐ下ろし、骨盤をわずかに後傾させます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure-se em uma barra de remada com os dois braços estendidos acima de você, usando uma pegada larga ou média. As pernas devem ficar esticadas para baixo, com a pelve levemente enrolada para trás. Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повисните на турнике на вытянутых над собой руках, используя широкий или средний хват. Ноги прямые, направлены вниз, таз слегка подкручен назад. Это будет ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬挂在引体向上杆上，双臂在头顶上方伸直，采用宽握或中等握距。双腿自然下垂，骨盆稍微后卷。这就是起始姿势。"
          }
        }
      }
    },
    "Hang from a chin-up bar with your legs and feet together using an overhand grip (palms facing away from you) that is slightly wider than shoulder width. You may use wrist wraps in order to facilitate holding on to the bar." : {
      "comment" : "A step of how to do the exercise “Hanging Pike”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدلَّ من عقلة مع ضم ساقيك وقدميك بقبضة علوية (راحتاك بعيدتان عنك) أوسع قليلًا من عرض الكتفين. يمكنك استخدام أربطة المعصم لتسهيل الإمساك بالبار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge dich mit zusammengehaltenen Beinen und Füßen im Obergriff (Handflächen von dir weg) und etwas mehr als schulterbreiter Griffbreite an eine Klimmzugstange. Du kannst Handgelenkbandagen verwenden, um das Halten der Stange zu erleichtern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuélgate de una barra para dominadas con las piernas y los pies juntos, con un agarre prono (palmas mirando hacia fuera) ligeramente más ancho que los hombros. Puedes usar muñequeras de sujeción para facilitar el agarre de la barra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez-vous à une barre de traction, les jambes et les pieds joints, en pronation (paumes tournées à l'opposé de vous), un peu plus large que les épaules. Vous pouvez utiliser des sangles de poignet pour faciliter la prise de la barre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों और पंजों को साथ रखकर, कंधों की चौड़ाई से थोड़ी चौड़ी ओवरहैंड ग्रिप (हथेलियां आपसे दूर) से चिन-अप बार पर लटकें। बार को पकड़े रहने में आसानी के लिए आप रिस्ट रैप्स का इस्तेमाल कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩幅よりやや広い順手(手のひらを自分と反対に向ける)で、脚と足を揃えてチンニングバーにぶら下がります。バーを握りやすくするために、リストラップを使ってもかまいません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure-se em uma barra de remada com as pernas e os pés juntos, usando uma pegada pronada (palmas voltadas para longe de você) um pouco mais larga que os ombros. Você pode usar munhequeiras para facilitar a pegada na barra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повисните на турнике, ноги и ступни вместе, хватом сверху (ладони от себя) чуть шире плеч. Для удобства удержания грифа можно использовать кистевые бинты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双腿和双脚并拢，用正握（掌心朝外）悬挂在引体向上杆上，握距比肩稍宽。可以使用助力带来帮助握住杠。"
          }
        }
      }
    },
    "Hang from a pull-up bar and raise your straight legs until your feet are near the bar." : {
      "comment" : "A step of how to do the exercise “Windshield Wiper”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدلَّ من عقلة السحب وارفع ساقيك المستقيمتين حتى تصبح قدماك قرب البار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge an einer Klimmzugstange und hebe die gestreckten Beine, bis die Füße nahe an der Stange sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
