        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用肘部抵住膝盖内侧，保持挺胸。"
          }
        }
      }
    },
    "Press your lower back into the floor and lift your shoulders, arms and legs a few inches up." : {
      "comment" : "A step of how to do the exercise “Hollow Body Hold”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط أسفل ظهرك نحو الأرض وارفع كتفيك وذراعيك وساقيك بضعة سنتيمترات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke den unteren Rücken in den Boden und hebe Schultern, Arme und Beine einige Zentimeter an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona la zona lumbar contra el suelo y levanta los hombros, los brazos y las piernas unos 8 cm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
