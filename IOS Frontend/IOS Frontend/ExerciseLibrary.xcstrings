          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich über die Fersen ab und hebe die Hüfte, bis Oberkörper und Oberschenkel in einer Linie sind."
          }
        },
        "es" : {
          "stringUnit" : {
