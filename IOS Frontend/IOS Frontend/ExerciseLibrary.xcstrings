    "Spin the rope with fast wrist turns so it passes under your feet twice before you land." : {
      "comment" : "A step of how to do the exercise “Double Under”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
