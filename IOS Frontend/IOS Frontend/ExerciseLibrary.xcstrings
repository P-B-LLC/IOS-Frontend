    "Perform this movement slowly for a number of repetitions, and repeat on the other side." : {
      "comment" : "A step of how to do the exercise “Standing Hip Circle”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدِّ هذه الحركة ببطء للعدد المطلوب من التكرارات، وكرر على الجانب الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe diese Bewegung langsam für eine Anzahl an Wiederholungen aus und wiederhole sie dann auf der anderen Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realiza este movimiento lentamente durante varias repeticiones y repite del otro lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuez ce mouvement lentement pour un certain nombre de répétitions, puis recommencez de l'autre côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस मूवमेंट को धीरे-धीरे कुछ रेप्स तक करें, और दूसरी तरफ़ दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この動作をゆっくりと決められた回数行い、反対側でも繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça este movimento lentamente pelo número de repetições e repita do outro lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняйте это движение медленно заданное количество повторений, затем повторите на другую сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓慢进行该动作若干次，然后换另一侧重复。"
