    "Keep your ribs down and your shoulder pulled into its socket." : {
      "comment" : "A step of how to do the exercise “Waiter's Walk (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
