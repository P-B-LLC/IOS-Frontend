    "Return the kettlebell to the starting position, with the palm facing in." : {
      "comment" : "A step of how to do the exercise “Arnold Press (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
