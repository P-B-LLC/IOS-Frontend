          }
        }
      }
    },
    "Drive up and press the dumbbell overhead as you stand." : {
      "comment" : "A step of how to do the exercise “Single Arm Thruster (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع للأعلى وارفع الدمبل فوق رأسك أثناء الوقوف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich nach oben und stemme die Kurzhantel beim Aufstehen über den Kopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja hacia arriba y presiona la mancuerna por encima de la cabeza mientras te pones de pie."
          }
