        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार को कूल्हों पर पकड़कर, कंधों की चौड़ाई से थोड़ी बाहर वाली ग्रिप के साथ खड़े हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩幅よりわずかに広いグリップで、バーを腰の位置で持って立ちます。"
