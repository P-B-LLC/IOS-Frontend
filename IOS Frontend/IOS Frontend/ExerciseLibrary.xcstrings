    "Wrap the rope around one leg, using your feet to pinch the rope. Reach up as high as possible with your arms, gripping the rope tightly." : {
      "comment" : "A step of how to do the exercise “Rope Climb”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لفّ الحبل حول إحدى الساقين، مستخدمًا قدميك لعصر الحبل. ارفع ذراعيك لأعلى ما يمكن، مع إمساك الحبل بإحكام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wickle das Seil um ein Bein und klemm es mit den Füßen ein. Streck die Arme so hoch wie möglich nach oben und greife das Seil fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envuelve la cuerda alrededor de una pierna, usando los pies para pinzar la cuerda. Estírate hacia arriba lo más alto posible con los brazos, agarrando la cuerda con firmeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enroulez la corde autour d'une jambe, en pinçant la corde avec les pieds. Étirez les bras le plus haut possible en serrant fermement la corde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रस्सी को एक पैर के चारों ओर लपेटें और पैरों से रस्सी को दबाकर पकड़ें। बाजुओं से जितना हो सके ऊपर पहुँचें और रस्सी को कसकर पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロープを片脚に巻き付け、足でロープを挟みます。腕をできるだけ高く伸ばし、ロープをしっかり握ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enrole a corda em uma perna, usando os pés para prender a corda. Estique-se o mais alto possível com os braços, segurando a corda com firmeza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберните канат вокруг одной ноги, зажимая его стопами. Потянитесь руками как можно выше, крепко сжимая канат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将绳子绕在一条腿上，用双脚夹住绳子。双臂尽量向上伸，紧紧抓住绳子。"
          }
        }
      }
    },
    "Wrist Circle" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدوير الرسغين"
          }
        },
