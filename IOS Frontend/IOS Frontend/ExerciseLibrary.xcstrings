    "Breathe in as you let your belly drop and lift your chest and tailbone (cow)." : {
      "comment" : "A step of how to do the exercise “Cat Cow”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خذ شهيقًا وأنت تترك بطنك يهبط وترفع صدرك وعظمة الذيل (وضع البقرة)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme ein, während du den Bauch absinken lässt und Brust und Steißbein anhebst (Kuh)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala mientras dejas caer el abdomen y elevas el pecho y el coxis (vaca)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez en laissant le ventre descendre et en levant la poitrine et le coccyx (vache)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस अंदर लेते हुए पेट को नीचे गिरने दें और छाती और टेलबोन को ऊपर उठाएं (काउ)।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸いながらお腹を落とし、胸と尾骨を持ち上げます(キャウ)。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire enquanto deixa a barriga cair e levanta o peito e o cóccix (vaca)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте вдох, позволяя животу опуститься, и поднимите грудь и копчик (корова)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气，同时让腹部下沉，抬起胸部和尾骨（牛式）。"
          }
        }
      }
    },
    "Breathe out as you round your spine toward the ceiling and tuck your chin and tailbone (cat)." : {
      "comment" : "A step of how to do the exercise “Cat Cow”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ازفر وأنت تقوّس عمودك الفقري نحو السقف وتقرّب ذقنك وعظمة الذيل (وضع القطة)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme aus, während du die Wirbelsäule zur Decke rundest und Kinn und Steißbein einziehst (Katze)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala mientras redondeas la columna hacia el techo y metes la barbilla y el coxis (gato)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez en arrondissant la colonne vers le plafond et en rentrant le menton et le coccyx (chat)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस छोड़ते हुए रीढ़ को छत की ओर गोल करें और ठोड़ी और टेलबोन को अंदर खींचें (कैट)।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吐きながら背骨を天井に向かって丸め、顎と尾骨を引き込みます(キャット)。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expire enquanto arredonda a coluna em direção ao teto e recolhe o queixo e o cóccix (gato)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдохните, округляя позвоночник к потолку и подтягивая подбородок и копчик (кошка)."
