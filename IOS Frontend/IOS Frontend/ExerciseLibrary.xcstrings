          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tritt vom Rack zurück und stell dich in mittlerer, schulterbreiter Fußstellung hin, die Zehen leicht nach außen gedreht. Halte den Kopf immer oben, denn mit gesenktem Blick verlierst du das Gleichgewicht. Halte außerdem den Rücken gerade und die Knie leicht gebeugt, niemals durchgedrückt. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
