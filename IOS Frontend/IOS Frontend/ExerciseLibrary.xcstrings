          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue o movimento pelo número de repetições prescrito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
