    "Sit on a flat bench with a dumbbell on each hand being held at arms length. The elbows should be close to the torso." : {
      "comment" : "A step of how to do the exercise “Seated Bicep Curl (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجلس على مقعد مسطح وفي كل يد دمبل تمسكه بطول الذراع. يجب أن يكون المرفقان قريبين من الجذع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich auf eine flache Bank, in jeder Hand eine Kurzhantel, mit hängenden Armen gehalten. Die Ellbogen sind nah am Oberkörper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate en un banco plano con una mancuerna en cada mano, sostenidas con los brazos extendidos. Los codos deben estar cerca del torso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous sur un banc plat avec un haltère dans chaque main, tenu à bout de bras. Les coudes doivent être près du tronc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्लैट बेंच पर बैठें, हर हाथ में एक डम्बल बाजू की लंबाई तक पकड़ा हो। कोहनियाँ धड़ के पास होनी चाहिए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フラットベンチに座り、両手にダンベルを1つずつ腕を伸ばして持ちます。肘は体幹に近づけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se em um banco reto com um halter em cada mão, segurados com os braços estendidos. Os cotovelos devem ficar junto ao tronco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядьте на горизонтальную скамью, держа по гантели в каждой руке на вытянутых руках. Локти прижаты к корпусу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐在平凳上，双手各握一个哑铃，手臂自然垂直伸直。肘部靠近躯干。"
          }
        }
      }
    },
    "Sit on a glute ham developer with your feet locked under the pads and your hips just off the back of the seat." : {
      "comment" : "A step of how to do the exercise “GHD Sit Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجلس على جهاز الأرداف والعضلات الخلفية للفخذ (Glute Ham Developer) مع تثبيت قدميك تحت الوسادتين ووركيك خارج مؤخرة المقعد قليلًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich auf ein Glute-Ham-Developer-Gerät, die Füße unter den Polstern fixiert und die Hüfte knapp hinter der Sitzfläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate en un banco para glúteos e isquiotibiales (GHD) con los pies fijados bajo las almohadillas y las caderas justo fuera del respaldo del asiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous sur un banc à ischio-jambiers (glute ham developer), les pieds calés sous les coussins et les hanches juste au bord arrière du siège."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्लूट हैम डेवलपर पर बैठें, पैर पैड के नीचे फंसे हों और कूल्हे सीट के पिछले हिस्से से बस बाहर हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グルートハムデベロッパーに座り、足をパッドの下に固定して、腰をシートの後ろ端から少し出します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se em um aparelho glute ham com os pés presos sob os apoios e o quadril logo além da parte de trás do assento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядьте на тренажёр для ягодично-бедренных мышц, зафиксировав ступни под валиками, а таз чуть сзади сиденья."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐在臀腿训练椅上，双脚固定在脚垫下，髋部刚好位于座位后缘之外。"
          }
        }
      }
    },
    "Sit on a low pulley row machine with a rope attachment." : {
