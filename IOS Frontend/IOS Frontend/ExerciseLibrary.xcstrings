          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一番下で少し静止してから、足のかかとで押して、膝と股関節を伸ばしながら開始姿勢に戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma breve pausa embaixo e depois volte à posição inicial empurrando o chão com o calcanhar, estendendo o joelho e o quadril."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ненадолго задержитесь внизу, затем вернитесь в исходное положение, давя пяткой, разгибая колено и бедро."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在底部稍作停顿，然后脚跟蹬地，伸展膝盖和髋部，回到起始位置。"
          }
        }
      }
    },
    "Pause briefly, and explode off of the box, extending through the hips and knees." : {
      "comment" : "A step of how to do the exercise “Speed Box Squat (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف لوهلة قصيرة، ثم انطلق من الصندوق بقوة انفجارية، مع مد الوركين والركبتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte kurz inne und springe explosiv von der Box hoch, indem du Hüfte und Knie streckst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una breve pausa y sube de forma explosiva desde el cajón, extendiendo las caderas y las rodillas."
