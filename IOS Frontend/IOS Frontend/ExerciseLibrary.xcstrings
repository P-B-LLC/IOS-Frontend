        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé ou sentado, bem ereto, e entrelace os dedos à sua frente, com os polegares apontando para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
