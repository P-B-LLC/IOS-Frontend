            "state" : "translated",
            "value" : "पिछले पैर से धक्का दें, कूल्हों के साथ जितनी हो सके उतनी ऊंचाई पाने की कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
