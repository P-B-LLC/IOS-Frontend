        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デクラインベンチの端で脚を固定し、ゆっくりとベンチに横になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
