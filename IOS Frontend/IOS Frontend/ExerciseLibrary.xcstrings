    "Return to your feet and jump onto the box, or over it, landing with soft knees." : {
      "comment" : "A step of how to do the exercise “Burpee Box Jump Over”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد إلى قدميك واقفز على الصندوق، أو فوقه، وهبط بركبتين مرنتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komme zurück auf die Füße und springe auf die Plyobox oder darüber hinweg, wobei du mit weichen Knien landest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ponerte de pie y salta sobre el cajón, o por encima de él, aterrizando con las rodillas flexionadas con suavidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relevez-vous et sautez sur le plyobox, ou par-dessus, en vous réceptionnant les genoux souples."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों पर खड़े हों और बॉक्स पर या उसके ऊपर से कूदें, घुटने नरम रखकर उतरें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上がり、ボックスの上にジャンプして乗るか、跳び越えて、膝を柔らかく使って着地します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte a ficar em pé e salte sobre a caixa, ou por cima dela, aterrissando com os joelhos suaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимитесь на ноги и запрыгните на тумбу или перепрыгните её, приземляясь на мягкие колени."
