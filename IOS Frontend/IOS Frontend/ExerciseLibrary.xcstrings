        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимите прямую ногу до уровня согнутого колена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将伸直的腿抬起，直到与弯曲的膝盖齐平。"
          }
        }
      }
    },
    "Lift your buttocks up and forward while bringing your head back to look up at the ceiling, to give an arch in your back." : {
      "comment" : "A step of how to do the exercise “Camel Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارفع مؤخرتك إلى الأعلى وإلى الأمام مع إمالة رأسك إلى الخلف للنظر إلى السقف، لتكوين قوس في ظهرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebe dein Gesäß nach oben und vorn und lege den Kopf in den Nacken, um zur Decke zu schauen, sodass ein Hohlkreuz entsteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eleva los glúteos hacia arriba y hacia delante mientras llevas la cabeza hacia atrás para mirar al techo, de modo que la espalda se arquee."
