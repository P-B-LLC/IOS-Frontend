          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alongamento de quadríceps em quatro apoios"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растяжка квадрицепса на четвереньках"
          }
        },
        "zh-Hans" : {
