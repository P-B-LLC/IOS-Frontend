        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke das Gewicht langsam ab, indem du die Knie beugst und dabei aufrecht und mit erhobenem Kopf bleibst (der Rücken bleibt jederzeit am Polster)."
          }
        },
        "es" : {
          "stringUnit" : {
