          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke den Nacken langsam ab, bis das Kinn den oberen Teil der Brust berührt, und atme dabei ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja despacio el cuello hasta que la barbilla toque la parte superior del pecho mientras inhalas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaissez lentement le cou jusqu'à ce que le menton touche le haut de la poitrine, en inspirant."
