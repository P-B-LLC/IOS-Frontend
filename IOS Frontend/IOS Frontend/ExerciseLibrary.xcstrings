    "After a brief pause return the weight to the starting position." : {
      "comment" : "A step of how to do the exercise “Behind the Back Shrug (Smith Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد توقف قصير، أعد الوزن إلى وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe das Gewicht nach einer kurzen Pause zurück in die Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una breve pausa, devuelve el peso a la posición inicial."
          }
        },
        "fr" : {
