        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja la barra despacio hasta la clavícula mientras inhalas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaissez lentement la barre jusqu'à la clavicule en inspirant."
