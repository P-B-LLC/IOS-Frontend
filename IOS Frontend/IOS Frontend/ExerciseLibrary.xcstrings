    },
    "Lift your hips into a bridge so your body forms a line from shoulders to knees." : {
      "comment" : "A step of how to do the exercise “Glute Bridge March”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارفع وركيك إلى وضع الجسر بحيث يشكل جسمك خطًا مستقيمًا من الكتفين إلى الركبتين."
          }
        },
        "de" : {
