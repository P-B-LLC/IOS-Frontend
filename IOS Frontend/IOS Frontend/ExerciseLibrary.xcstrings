        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe as manoplas em direção ao tronco, levando os cotovelos para trás e aproximando as escápulas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяните рукояти к корпусу, отводя локти назад и сводя лопатки."
