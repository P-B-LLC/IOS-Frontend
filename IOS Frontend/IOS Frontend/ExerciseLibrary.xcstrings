    "Keep a steady rhythm and set the damper and pace for your workout, tracking time, distance or calories." : {
      "comment" : "A step of how to do the exercise “Ski Erg”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على إيقاع ثابت واضبط المخمّد والوتيرة لتمرينك، مع تتبع الوقت أو المسافة أو السعرات الحرارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen gleichmäßigen Rhythmus und stelle Dämpfer und Tempo für dein Training ein. Verfolge dabei Zeit, Distanz oder Kalorien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén un ritmo constante y ajusta el amortiguador y el ritmo de tu entrenamiento, registrando tiempo, distancia o calorías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez un rythme régulier et réglez la résistance et l'allure de votre séance, en suivant le temps, la distance ou les calories."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक स्थिर लय बनाए रखें और अपनी वर्कआउट के लिए डैम्पर और पेस सेट करें, समय, दूरी या कैलोरी ट्रैक करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定のリズムを保ち、ダンパーとペースをワークアウトに合わせて設定し、時間、距離、またはカロリーを記録します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha um ritmo constante e ajuste a resistência e o ritmo do treino, acompanhando tempo, distância ou calorias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте ровный ритм, настройте демпфер и темп тренировки, отслеживая время, дистанцию или калории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持稳定的节奏，设置好阻尼和配速，记录时间、距离或卡路里。"
          }
        }
      }
    },
    "Keep a steady, light rhythm on the balls of your feet." : {
