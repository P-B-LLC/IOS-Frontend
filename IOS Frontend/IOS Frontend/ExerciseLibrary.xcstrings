        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma breve pausa e saia da caixa de forma explosiva, estendendo quadris e joelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кратко задержитесь и взрывным движением поднимитесь с тумбы, разгибая бёдра и колени."
