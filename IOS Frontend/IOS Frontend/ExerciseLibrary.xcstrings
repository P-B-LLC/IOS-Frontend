          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर से बाजू बदलें और मूवमेंट दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再び腕を替えて、動作を繰り返します。"
          }
        },
        "pt-BR" : {
