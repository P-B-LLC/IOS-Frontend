          }
        }
      }
    },
    "Slide across to the other hand, return to the middle and lower yourself under control." : {
      "comment" : "A step of how to do the exercise “Typewriter Pull Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزلق إلى اليد الأخرى، ثم عد إلى المنتصف وأنزل نفسك بتحكم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleite zur anderen Hand hinüber, kehre in die Mitte zurück und senke dich kontrolliert ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza el cuerpo hacia la otra mano, vuelve al centro y baja con control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez vers l'autre main, revenez au milieu et redescendez de façon contrôlée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे हाथ की ओर खिसकें, बीच में लौटें और नियंत्रण के साथ नीचे आएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方の手の方へ滑らせ、中央に戻って、コントロールしながら体を下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a outra mão, volte ao meio e desça com controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместитесь к другой руке, вернитесь в середину и под контролем опуститесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑向另一只手，回到中间，然后有控制地放下身体。"
          }
        }
      }
    },
    "Slide back down to the start and repeat." : {
      "comment" : "A step of how to do the exercise “Wall Slide”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزلق للأسفل إلى وضع البداية وكرر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleite zurück nach unten in die Ausgangsposition und wiederhole die Bewegung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza los brazos de nuevo hacia abajo hasta el inicio y repite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescendez en glissant jusqu'au départ et répétez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस शुरुआती स्थिति तक नीचे सरकाएं और दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始位置まで滑り下ろし、繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize de volta à posição inicial e repita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скользите обратно вниз в исходное положение и повторите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑回起点，重复。"
          }
        }
      }
    },
    "Slide down the wall until your knees are bent, up to about 90 degrees or less if that is more comfortable." : {
      "comment" : "A step of how to do the exercise “Wall Sit”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزلق على الجدار حتى تنثني ركبتاك، إلى حوالي 90 درجة أو أقل إذا كان ذلك أكثر راحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutsche an der Wand nach unten, bis die Knie gebeugt sind, bis etwa 90 Grad oder weniger, wenn dir das angenehmer ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza la espalda por la pared hasta que las rodillas queden flexionadas, hasta unos 90 grados o menos si te resulta más cómodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez le long du mur jusqu'à ce que vos genoux soient fléchis, jusqu'à environ 90 degrés ou moins si c'est plus confortable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दीवार पर नीचे फिसलें जब तक घुटने मुड़ न जाएं, लगभग 90 डिग्री तक या उससे कम अगर वह ज़्यादा आरामदायक हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "膝が約90度(楽であればそれ以下でも可)になるまで壁に沿って滑り下ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize pela parede até os joelhos ficarem flexionados, em até cerca de 90 graus ou menos, se for mais confortável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скользите вниз по стене, пока колени не согнутся примерно до 90 градусов или меньше, если так удобнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿墙下滑，直到膝盖弯曲，约 90 度，如果更舒适也可以小于 90 度。"
          }
        }
      }
    },
    "Slide your knees out wide with your shins parallel and your ankles in line with your knees." : {
      "comment" : "A step of how to do the exercise “Frog Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبعد ركبتيك للخارج بعرض واسع مع إبقاء ساقيك متوازيتين وكاحليك على استقامة ركبتيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiebe die Knie weit auseinander, die Schienbeine bleiben parallel und die Knöchel in einer Linie mit den Knien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza las rodillas hacia los lados, con las espinillas paralelas y los tobillos alineados con las rodillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écartez largement les genoux, les tibias parallèles et les chevilles alignées avec les genoux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घुटनों को चौड़ा खिसकाएं, पिंडलियां समानांतर और टखने घुटनों की सीध में हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すねを平行に保ち、足首を膝の真横に置いたまま、膝を横に大きく開いて滑らせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize os joelhos para os lados, bem abertos, com as canelas paralelas e os tornozelos alinhados com os joelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разведите колени широко в стороны, голени параллельны, голеностопы на одной линии с коленями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将双膝向两侧滑开，小腿保持平行，脚踝与膝盖在一条线上。"
          }
        }
      }
    },
    "Sliding Leg Curl" : {
