    "Start in a push-up position with your hands beside your waist and your fingers turned out or back." : {
      "comment" : "A step of how to do the exercise “Pseudo Planche Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ في وضع الضغط (البوش أب) ويداك بجانب خصرك وأصابعك متجهة للخارج أو للخلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh in die Liegestützposition, die Hände neben der Taille und die Finger nach außen oder nach hinten gedreht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en posición de flexión con las manos junto a la cintura y los dedos girados hacia fuera o hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez en position de pompe, les mains à côté de la taille et les doigts tournés vers l'extérieur ou vers l'arrière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुश-अप की स्थिति में शुरू करें, हाथ कमर के बगल में हों और उंगलियाँ बाहर या पीछे की ओर मुड़ी हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手を腰の横に置き、指を外側または後ろに向けて、腕立て伏せの姿勢になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece na posição de flexão, com as mãos ao lado da cintura e os dedos virados para fora ou para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примите упор лёжа, кисти рядом с поясом, пальцы повёрнуты наружу или назад."
