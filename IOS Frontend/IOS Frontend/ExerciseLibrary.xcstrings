    "Hold your arms under the knees, not over (that would put to much pressure on your knee joints)." : {
      "comment" : "A step of how to do the exercise “Knees to Chest Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك بذراعيك أسفل الركبتين لا فوقهما (فذلك يضع ضغطًا زائدًا على مفاصل الركبة)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Arme unter den Knien, nicht darüber (das würde zu viel Druck auf die Kniegelenke ausüben)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
