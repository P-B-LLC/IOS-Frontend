          }
        }
      }
    },
    "Lie facedown on top of an exercise ball." : {
      "comment" : "A step of how to do the exercise “Downward Facing Balance (Stability Ball)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استلقِ على بطنك فوق كرة تمارين."
          }
        },
        "de" : {
          "stringUnit" : {
