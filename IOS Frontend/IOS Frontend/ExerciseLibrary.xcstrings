            "state" : "translated",
            "value" : "Después de 10 a 20 segundos, cambia de lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après 10 à 20 secondes, changez de côté."
          }
        },
        "hi" : {
          "stringUnit" : {
