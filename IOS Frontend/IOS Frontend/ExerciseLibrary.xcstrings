    "Stand next to the end of the cones, facing 90 degrees to the direction of travel. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Lateral Cone Hop”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف بجانب نهاية صف المخاريط، مواجهًا بزاوية 90 درجة لاتجاه تحركك. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich neben das Ende der Hütchenreihe, 90 Grad zur Bewegungsrichtung gedreht. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate junto al extremo de los conos, orientado a 90 grados respecto a la dirección de desplazamiento. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous à côté de l'extrémité de la rangée de plots, face à 90 degrés par rapport à la direction du déplacement. Voici votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोन की कतार के एक सिरे के पास खड़े हों, चलने की दिशा से 90 डिग्री मुड़कर। यही आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーンの端の横に、進行方向に対して90度横を向いて立ちます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique ao lado da ponta da fileira de cones, de lado em relação à direção do deslocamento (a 90 graus). Esta será sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте рядом с краем ряда конусов, повернувшись на 90 градусов к направлению движения. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在锥桶一端的旁边，身体朝向与前进方向成90度。这就是起始姿势。"
          }
        }
      }
    },
    "Stand on one leg and bend the other knee, holding that foot behind you with the same-side hand." : {
      "comment" : "A step of how to do the exercise “Shrimp Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على ساق واحدة واثنِ الركبة الأخرى، وأمسك تلك القدم خلفك بيدك من الجانب نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf ein Bein, beuge das andere Knie und halte diesen Fuß mit der Hand derselben Seite hinter dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie sobre una pierna y flexiona la otra rodilla, sujetando ese pie por detrás con la mano del mismo lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous sur une jambe et fléchissez l'autre genou, en tenant ce pied derrière vous avec la main du même côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पैर पर खड़े हों और दूसरा घुटना मोड़ें, उस पैर को अपने पीछे उसी तरफ़ के हाथ से पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片脚で立ち、もう一方の膝を曲げて、同じ側の手でその足を後ろでつかみます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé sobre uma perna e flexione o outro joelho, segurando esse pé atrás de você com a mão do mesmo lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на одну ногу, согните другое колено и удерживайте эту стопу позади себя рукой той же стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单腿站立，另一侧膝盖弯曲，用同侧的手在身后抓住该脚。"
          }
        }
      }
    },
    "Stand on one leg holding a dumbbell in the opposite hand." : {
      "comment" : "A step of how to do the exercise “Single Leg Romanian Deadlift (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على ساق واحدة وأمسك دمبل باليد المقابلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich auf ein Bein und halte eine Kurzhantel in der gegenüberliegenden Hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie sobre una pierna sosteniendo una mancuerna con la mano opuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous sur une jambe, un haltère dans la main opposée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पैर पर खड़े हों और विपरीत हाथ में डम्बल पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片脚で立ち、反対側の手にダンベルを持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé sobre uma perna, segurando um halter na mão oposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на одну ногу, держа гантель в противоположной руке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单腿站立，对侧手持一个哑铃。"
          }
        }
      }
    },
    "Stand on one leg with the other leg held straight out in front of you." : {
      "comment" : "A step of how to do the exercise “Pistol Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على ساق واحدة وأبقِ الساق الأخرى ممدودة مستقيمة أمامك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh auf einem Bein, das andere Bein ist gerade vor dir ausgestreckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie sobre una pierna con la otra pierna recta extendida al frente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous sur une jambe, l'autre jambe tendue droit devant vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पैर पर खड़े हों और दूसरे पैर को अपने सामने सीधा रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片脚で立ち、もう一方の脚を前にまっすぐ伸ばします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé sobre uma perna, com a outra perna esticada à sua frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на одну ногу, другую ногу держите прямо перед собой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单腿站立，另一条腿向身前伸直。"
          }
        }
      }
    },
    "Stand on one of the two boxes with arms at the sides; feet should be together and slightly off the edge as in the depth jump. Place the other box approximately two or three feet in front of and facing the performer." : {
      "comment" : "A step of how to do the exercise “Depth Jump Leap”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على أحد الصندوقين وذراعاك بجانبيك؛ يجب أن تكون قدماك معًا وتتجاوزان الحافة قليلًا كما في القفز من ارتفاع. ضع الصندوق الآخر على بعد نحو 60 إلى 90 سم أمام المتدرب ومواجهًا له."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf eine der beiden Boxen, die Arme seitlich am Körper. Die Füße stehen zusammen und ragen leicht über die Kante, wie beim Tiefsprung. Platziere die andere Box etwa 60-90 cm vor dir, dir zugewandt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párate sobre uno de los dos cajones con los brazos a los lados; los pies deben estar juntos y ligeramente fuera del borde, como en el salto en profundidad. Coloca el otro cajón a unos 60 a 90 cm delante de ti y de cara a ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous sur l'un des deux plyoboxes, les bras le long du corps, les pieds joints et légèrement au-dessus du bord, comme pour le saut en contrebas. Placez l'autre plyobox à environ 60 à 90 cm devant vous, face à vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों में से एक बॉक्स पर बाजुएं बगल में रखकर खड़े हों; पैर साथ हों और डेप्थ जंप की तरह किनारे से थोड़े बाहर निकले हों। दूसरे बॉक्स को लगभग 60 से 90 सेमी आगे, अभ्यास करने वाले की ओर मुंह करके रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つのうち片方のボックスの上に、腕を体の横に下ろして立ちます。足は揃え、デプスジャンプのときのように端から少しはみ出させます。もう一方のボックスを、約60〜90cm前方に向かい合わせて置きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé sobre uma das duas caixas, com os braços ao lado do corpo; os pés devem ficar juntos e um pouco para fora da borda, como no salto em profundidade. Coloque a outra caixa a cerca de 60 a 90 cm à frente e de frente para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на одну из двух тумб, руки опущены вдоль тела, ступни вместе и слегка выступают за край, как при прыжке в глубину. Поставьте другую тумбу примерно в 60–90 см перед собой, лицом к вам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在其中一个箱子上，手臂垂在身体两侧；双脚并拢，稍微伸出箱沿，与跳深动作相同。将另一个箱子放在练习者前方约60到90厘米处，面向练习者。"
          }
        }
      }
    },
    "Stand on the back side of an incline bench as if you were going to be a spotter for someone. Have a dumbbell in one hand and rest it across the incline bench with a supinated (palms up) grip." : {
      "comment" : "A step of how to do the exercise “Single Arm Incline Bench Curl (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف خلف مقعد مائل كما لو كنت ستؤدي دور المساعد لشخص ما. أمسك دمبل بيد واحدة وضعه على المقعد المائل بقبضة سفلية (الراحة للأعلى)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf die Rückseite einer Schrägbank, als wolltest du jemanden sichern. Halte eine Kurzhantel in einer Hand und leg sie im Untergriff (Handfläche nach oben) über die Schrägbank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie en la parte trasera de un banco inclinado, como si fueras a ayudar a alguien como asistente. Sostén una mancuerna en una mano y apóyala sobre el banco inclinado con un agarre supino (palmas hacia arriba)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez-vous derrière un banc incliné comme si vous deviez parer quelqu'un. Tenez un haltère dans une main et posez-le en travers du banc incliné en supination (paume vers le haut)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनक्लाइन बेंच के पीछे की ओर इस तरह खड़े हों जैसे आप किसी के स्पॉटर बनने जा रहे हों। एक हाथ में डम्बल लें और उसे इनक्लाइन बेंच के आर-पार सुपिनेटेड (हथेली ऊपर) ग्रिप से टिकाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補助者になるときのように、インクラインベンチの背面側に立ちます。片手にダンベルを持ち、逆手（手のひらを上に向ける）でインクラインベンチの上に乗せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique atrás de um banco inclinado, como se fosse o auxiliar de alguém. Segure um halter em uma das mãos e apoie-o sobre o banco inclinado com pegada supinada (palmas para cima)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте с обратной стороны наклонной скамьи, как будто собираетесь страховать кого-то. Возьмите гантель в одну руку и положите её на наклонную скамью обратным хватом (ладонь вверх)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在上斜凳的背面，就像要给别人做保护者一样。一只手拿着哑铃，以反握（掌心向上）将它搭在上斜凳上。"
          }
        }
      }
    },
    "Stand on the bar, using the rope to balance yourself. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “London Bridge”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على البار مستخدمًا الحبل لموازنة نفسك. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf die Stange und halte dich mit dem Seil im Gleichgewicht. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie sobre la barra, usando la cuerda para equilibrarte. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montez sur la barre en vous servant de la corde pour vous équilibrer. Voici votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार पर खड़े हों और संतुलन बनाने के लिए रस्सी का इस्तेमाल करें। यही आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーの上に立ち、ロープを使ってバランスをとります。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba na barra, usando a corda para se equilibrar. Esta será sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на гриф, балансируя с помощью каната. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在杠上，借助绳子保持平衡。这就是起始姿势。"
          }
        }
      }
    },
    "Stand on the foot that does not have the ankle cuff (the far foot) and allow the leg with the cuff to be pulled towards the low pulley. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Hip Adduction (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على القدم التي لا يوجد عليها حزام الكاحل (القدم البعيدة) واترك الساق ذات الحزام تنسحب نحو البكرة السفلية. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf den Fuß ohne Knöchelmanschette (den entfernten Fuß) und lass das Bein mit der Manschette zum unteren Kabelzug hin ziehen. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párate sobre el pie que no tiene la tobillera (el pie lejano) y deja que la pierna con la tobillera sea jalada hacia la polea baja. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous sur le pied qui n'a pas la sangle de cheville (le pied éloigné) et laissez la jambe équipée de la sangle être tirée vers la poulie basse. Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस पैर पर खड़े हों जिस पर एंकल कफ़ नहीं है (दूर वाला पैर) और कफ़ वाले पैर को लो पुली की ओर खिंचने दें। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カフを付けていない足(遠いほうの足)で立ち、カフを付けた脚がローププーリーのほうへ引かれるままにします。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie-se no pé que não tem a tornozeleira (o pé distante) e deixe a perna com a tornozeleira ser puxada em direção à polia baixa. Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на ногу без манжеты (дальнюю ногу) и позвольте ноге с манжетой тянуться к нижнему блоку. Это будет ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在没有戴脚踝护套的脚（远侧脚）上，让戴护套的腿被拉向低位滑轮。这就是起始姿势。"
          }
        }
      }
    },
    "Stand on the ground with one foot resting on a bench or box with your heel close to the edge." : {
      "comment" : "A step of how to do the exercise “Bench Sprint”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على الأرض وإحدى قدميك على مقعد أو صندوق وكعبها قريب من الحافة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
