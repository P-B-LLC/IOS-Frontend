        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まっすぐに立ち、右腕を体の前で交差させて左肩の上に持っていきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé, bem ereto, e leve o braço direito à frente do corpo, por cima do ombro esquerdo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
