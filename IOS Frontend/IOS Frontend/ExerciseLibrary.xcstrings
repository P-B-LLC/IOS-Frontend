        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजुओं को घुटनों के नीचे से पकड़ें, ऊपर से नहीं (इससे घुटने के जोड़ों पर बहुत दबाव पड़ेगा)।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕は膝の上ではなく下で抱えます(膝関節に負担がかかりすぎるためです)。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure os joelhos por baixo, não por cima (isso colocaria pressão demais nas articulações dos joelhos)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обхватите руками колени снизу, а не сверху (иначе на коленные суставы приходится слишком большая нагрузка)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
