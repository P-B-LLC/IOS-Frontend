    "Press back up and turn your palms slightly forward at the top." : {
      "comment" : "A step of how to do the exercise “Ring Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع جسمك للأعلى مجددًا وأدر راحتيك قليلًا للأمام في الأعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich wieder hoch und dreh die Handflächen oben leicht nach vorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja para volver a subir y gira las palmas ligeramente hacia delante en la parte alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repoussez-vous vers le haut et tournez légèrement les paumes vers l'avant en haut du mouvement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस ऊपर प्रेस करें और शीर्ष पर हथेलियों को थोड़ा आगे की ओर घुमाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押し上げ、頂点で手のひらを少し前に向けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre de volta para cima e vire as palmas levemente para a frente no topo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите себя обратно вверх и в верхней точке слегка поверните ладони вперёд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推起回到起点，在顶端把手掌略微转向前方。"
          }
        }
      }
    },
    "Press back up to locked arms." : {
      "comment" : "A step of how to do the exercise “Spoto Press (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط للأعلى حتى تقفل ذراعيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke sie wieder nach oben, bis die Arme durchgestreckt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja de nuevo hacia arriba hasta bloquear los brazos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez à nouveau jusqu'à avoir les bras verrouillés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजुओं के लॉक होने तक वापस ऊपर प्रेस करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕が伸びきるまで押し上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre de volta para cima até travar os braços."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите обратно до выпрямленных рук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上推起，直到手臂锁定。"
          }
        }
      }
    },
    "Press back up to straight arms without letting your hips sag." : {
      "comment" : "A step of how to do the exercise “Knee Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع للأعلى حتى تستقيم ذراعاك دون أن يهبط وركاك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich zurück in die gestreckten Arme, ohne dass die Hüfte durchhängt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja de nuevo hasta estirar los brazos sin dejar que las caderas se hundan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repoussez-vous jusqu'à avoir les bras tendus sans laisser les hanches s'affaisser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों को लटकने दिए बिना वापस सीधी बाजुओं तक प्रेस करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腰を落とさずに、腕が伸びるまで押し上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre de volta até estender os braços, sem deixar o quadril cair."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите себя обратно до прямых рук, не позволяя тазу провисать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推起至手臂伸直，髋部不要下塌。"
          }
        }
      }
    },
    "Press back up to straight arms, keeping your hips high throughout." : {
      "comment" : "A step of how to do the exercise “Pike Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع للأعلى حتى تستقيم ذراعاك، مع إبقاء وركيك مرتفعين طوال الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich zurück in die gestreckten Arme und halte die Hüfte die ganze Zeit hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja de nuevo hasta estirar los brazos, manteniendo las caderas altas en todo momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repoussez-vous jusqu'à avoir les bras tendus, en gardant les hanches hautes tout au long du mouvement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस सीधी बाजुओं तक प्रेस करें, पूरे समय कूल्हे ऊंचे रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕がまっすぐになるまで押し上げます。その間ずっと腰を高く保ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre de volta até estender os braços, mantendo o quadril alto durante todo o movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выжмите себя обратно до прямых рук, всё время держа таз высоко."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推回到手臂伸直，整个过程中髋部保持高位。"
          }
        }
      }
    },
