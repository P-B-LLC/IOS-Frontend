          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うつ伏せになり、片脚をフォームローラーの上に乗せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
