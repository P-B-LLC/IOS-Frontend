            "value" : "कोहनियों में हल्का मोड़ बनाए रखते हुए साँस छोड़ते हुए वज़न को चाप में एक-दूसरे से दूर बाहर की ओर ले जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
