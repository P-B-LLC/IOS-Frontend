          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb die Stange beim Ausatmen zurück in die Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube la barra de nuevo a la posición inicial mientras exhalas."
          }
        },
        "fr" : {
          "stringUnit" : {
