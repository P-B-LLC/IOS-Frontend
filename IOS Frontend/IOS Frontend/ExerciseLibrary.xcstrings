    "Let it fall back and hinge as it passes between your legs, resisting the pull to rotate toward the bell." : {
      "comment" : "A step of how to do the exercise “Single Arm Kettlebell Swing”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعه يسقط للخلف وانثنِ من الوركين عند مروره بين ساقيك، مقاومًا الميل للدوران نحو الكيتل بيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass sie zurückfallen und beuge dich in der Hüfte, wenn sie zwischen deinen Beinen hindurchläuft, und widerstehe dem Zug, dich zur Kettlebell hin zu drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que caiga y flexiona las caderas cuando pase entre las piernas, resistiendo la tendencia a girar hacia la pesa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez-la retomber et penchez-vous au niveau des hanches quand elle passe entre vos jambes, en résistant à l'envie de pivoter vers la kettlebell."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसे वापस गिरने दें और जैसे ही वह पैरों के बीच से गुज़रे, हिंज करें, केटलबेल की ओर घूमने की खिंचाव का विरोध करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベルを落として脚の間を通過させるときに股関節から曲げ、ベルの方に体が回ろうとする力に逆らいます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe-o cair de volta e flexione o quadril quando ele passar entre as pernas, resistindo à tendência de girar em direção ao kettlebell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте ей упасть обратно и наклонитесь в бёдрах, когда она проходит между ног, сопротивляясь стремлению повернуться вслед за гирей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让壶铃落回，经过两腿之间时折叠髋部，抵抗向壶铃方向旋转的拉力。"
          }
        }
      }
    },
    "Let the arms hang to your sides fully extended as they point to the floor." : {
      "comment" : "A step of how to do the exercise “Incline Bench Pull (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع ذراعيك تتدليان إلى جانبيك ممدودتين بالكامل ومتجهتين نحو الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Arme vollständig gestreckt seitlich hängen, sodass sie zum Boden zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que los brazos cuelguen a los lados, completamente extendidos, apuntando al suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez les bras pendre sur les côtés, complètement tendus, pointés vers le sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजुओं को पूरी तरह सीधा करके बगल में लटकने दें, वे फ़र्श की ओर इशारा करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕を完全に伸ばして体の横に垂らし、床の方向に向けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe os braços pendurados ao lado do corpo, totalmente estendidos e apontando para o chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте рукам свисать по бокам полностью вытянутыми, направленными к полу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让手臂完全伸直，自然垂在身体两侧，指向地面。"
          }
        }
      }
    },
    "Let the bell fall back, hinge again as it passes between your legs, and repeat." : {
      "comment" : "A step of how to do the exercise “Kettlebell Swing”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع الكيتل بيل يسقط للخلف، واثنِ وركيك مرة أخرى عند مروره بين ساقيك، ثم كرر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Kettlebell zurückfallen, beuge dich erneut in der Hüfte, wenn sie zwischen deinen Beinen durchgeht, und wiederhole die Bewegung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que la pesa caiga de nuevo, flexiona las caderas otra vez cuando pase entre las piernas y repite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le kettlebell retomber, chargez de nouveau les hanches quand il passe entre vos jambes, et répétez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेल को वापस गिरने दें, जब वह टांगों के बीच से गुज़रे तो दोबारा हिंज करें, और दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベルを落とし、脚の間を通るときに再び股関節から折り曲げて、繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o kettlebell cair de volta, faça a dobradiça novamente quando ele passar entre as pernas e repita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте гире упасть обратно, снова наклонитесь в бёдрах, когда она проходит между ног, и повторяйте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让壶铃落回，经过双腿之间时再次屈髋，然后重复。"
          }
        }
      }
    },
    "Let the handles rise slowly until your arms are straight again." : {
      "comment" : "A step of how to do the exercise “Lat Pulldown (Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع المقبضين يرتفعان ببطء حتى تستقيم ذراعاك مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Griffe langsam wieder nach oben gehen, bis deine Arme wieder gestreckt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que las asas suban despacio hasta que los brazos queden rectos de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez les poignées remonter lentement jusqu'à ce que vos bras soient de nouveau tendus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हैंडल्स को धीरे-धीरे ऊपर जाने दें जब तक बाजुएं फिर से सीधी न हो जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕が再びまっすぐになるまで、ハンドルをゆっくり戻します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe as alças subirem lentamente até os braços ficarem esticados novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно позвольте рукоятям подняться, пока руки снова не выпрямятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让把手缓慢上升，直到手臂再次伸直。"
          }
        }
      }
    },
    "Let your arms extend and hang naturally in front of you so that they are perpendicular to the floor." : {
      "comment" : "A step of how to do the exercise “Prone Incline Bicep Curl (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع ذراعيك تمتدان وتتدليان بشكل طبيعي أمامك بحيث تكونان عموديتين على الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Arme gestreckt und locker vor dir hängen, sodass sie senkrecht zum Boden stehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que los brazos se extiendan y cuelguen de forma natural frente a ti, perpendiculares al suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vos bras s'étendre et pendre naturellement devant vous, perpendiculairement au sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजुओं को अपने सामने स्वाभाविक रूप से सीधा लटकने दें ताकि वे फ़र्श से लंबवत (90 डिग्री पर) रहें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕を伸ばして体の前に自然に垂らし、床に対して垂直にします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe os braços se estenderem e penderem naturalmente à sua frente, perpendiculares ao chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте рукам свободно повиснуть перед вами перпендикулярно полу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让双臂自然伸直下垂在身体前方，与地面垂直。"
          }
        }
      }
    },
    "Let your arms hang down on your sides, with the elbows in, and turn the palms of your hands forward with the thumbs pointing away from the body. You will keep this hand position throughout the movement as there should not be any twisting of the hands as they come up. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Incline Flexor Curl (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع ذراعيك تتدليان إلى جانبيك مع إبقاء المرفقين للداخل، وأدر راحتي يديك للأمام مع توجيه الإبهامين بعيدًا عن الجسم. ستحافظ على وضع اليدين هذا طوال الحركة إذ لا يجب أن يحدث أي التواء لليدين أثناء الصعود. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Arme seitlich hängen, die Ellbogen eng, und drehe die Handflächen nach vorn, die Daumen zeigen vom Körper weg. Du behältst diese Handstellung während der gesamten Bewegung bei, da die Hände beim Hochführen nicht gedreht werden sollten. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que los brazos cuelguen a los costados, con los codos pegados, y gira las palmas de las manos hacia delante con los pulgares apuntando lejos del cuerpo. Mantendrás esta posición de las manos durante todo el movimiento, ya que no debe haber ninguna torsión de las manos al subir. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez les bras pendre sur les côtés, les coudes près du corps, et tournez les paumes vers l'avant, les pouces pointant à l'opposé du corps. Vous garderez cette position des mains pendant tout le mouvement, car les mains ne doivent pas tourner en montant. Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजुओं को बगल में लटकने दें, कोहनियां अंदर हों, और हथेलियों को आगे की ओर घुमाएं, अंगूठे शरीर से दूर की ओर हों। आप पूरे मूवमेंट में हाथों की यही स्थिति रखेंगे क्योंकि ऊपर आते समय हाथों को घुमाना नहीं चाहिए। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肘を内側にして腕を体の横に垂らし、親指が体から離れる向きになるように手のひらを前に向けます。上げるときに手をひねってはいけないので、動作中ずっとこの手の向きを保ちます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe os braços pendurados ao lado do corpo, com os cotovelos junto ao corpo, e vire as palmas das mãos para a frente, com os polegares apontando para longe do corpo. Mantenha essa posição das mãos durante todo o movimento, pois não deve haver giro das mãos ao subir. Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте рукам свисать по бокам, локти прижаты, и поверните ладони вперёд, большие пальцы направлены от тела. Держите это положение кистей на протяжении всего движения, так как кисти не должны скручиваться при подъёме. Это будет ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让双臂垂在身体两侧，肘部内收，将掌心转向前方，拇指指向远离身体的方向。整个动作过程中保持这个手位，因为手向上弯举时不应有任何扭转。这就是起始姿势。"
          }
        }
      }
    },
    "Let your head drop gently between your arms until you feel a stretch between your shoulder blades." : {
      "comment" : "A step of how to do the exercise “Upper Back Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع رأسك يسقط برفق بين ذراعيك حتى تشعر بإطالة بين لوحي الكتف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den Kopf sanft zwischen die Arme sinken, bis du eine Dehnung zwischen den Schulterblättern spürst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja caer suavemente la cabeza entre los brazos hasta que sientas un estiramiento entre las escápulas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la tête tomber doucement entre vos bras jusqu'à ressentir un étirement entre les omoplates."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर को धीरे से अपनी बाजुओं के बीच गिरने दें जब तक कंधे के ब्लेड के बीच स्ट्रेच महसूस न हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩甲骨の間に伸びを感じるまで、頭を腕の間にそっと落とします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a cabeça cair suavemente entre os braços até sentir um alongamento entre as escápulas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте голове мягко опуститься между рук, пока не почувствуете растяжение между лопатками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让头轻轻垂在双臂之间，直到肩胛骨之间感到拉伸。"
          }
        }
      }
    },
    "Let your shoulder and the side of your head rest toward the floor for a breath, then reverse. Switch sides after your reps." : {
      "comment" : "A step of how to do the exercise “Thread the Needle”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع كتفك وجانب رأسك يستريحان نحو الأرض لنَفَس واحد، ثم اعكس الحركة. بدّل الجانب بعد تكراراتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Schulter und die Seite des Kopfes für einen Atemzug in Richtung Boden sinken und kehre die Bewegung dann um. Wechsle nach deinen Wiederholungen die Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que el hombro y un lado de la cabeza descansen hacia el suelo durante una respiración y luego invierte el movimiento. Cambia de lado después de tus repeticiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez l'épaule et le côté de la tête se poser vers le sol pendant une respiration, puis inversez le mouvement. Changez de côté après vos répétitions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक साँस तक कंधे और सिर की बगल को ज़मीन की ओर टिकने दें, फिर पलटें। रेप्स के बाद साइड बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩と頭の側面を床に向かって1呼吸分預けたら、逆の動きで戻ります。回数を終えたら、左右を入れ替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o ombro e o lado da cabeça descansarem em direção ao chão por uma respiração e depois inverta o movimento. Troque de lado após as repetições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте плечу и боковой части головы опуститься к полу на один вдох, затем выполните обратное движение. Смените сторону после повторений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让肩部和头部侧面朝地面放松一个呼吸，然后反向动作。完成次数后换边。"
          }
        }
      }
    },
