    },
    "Lower yourself as far as possible." : {
      "comment" : "A step of how to do the exercise “Advanced Windmill (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل بنفسك إلى أبعد مسافة ممكنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe so tief wie möglich nach unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja todo lo que puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez aussi bas que possible."
          }
        },
        "hi" : {
          "stringUnit" : {
