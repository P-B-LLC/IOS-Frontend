            "state" : "translated",
            "value" : "ارفع ساقيك مستقيمتين للأعلى بحيث تتجهان نحو السقف، أو اثنِ ركبتيك لتسهيل التمرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb die Beine gestreckt senkrecht an, sodass sie zur Decke zeigen, oder beuge die Knie, um es leichter zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
