          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich über zwei Kurzhanteln, die direkt außerhalb deiner Füße auf dem Boden liegen."
          }
        },
        "es" : {
          "stringUnit" : {
