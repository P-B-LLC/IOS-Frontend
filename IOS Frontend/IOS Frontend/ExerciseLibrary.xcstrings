        }
      }
    },
    "Raise the unsupported knee to 90 degrees. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Standing Hip Circle”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارفع الركبة غير المسنودة إلى زاوية 90 درجة. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebe das freie Knie auf 90 Grad an. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eleva la rodilla de la pierna libre a 90 grados. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez le genou libre à 90 degrés. Ceci sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना सहारे वाले घुटने को 90 डिग्री तक उठाएं। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支えのない側の膝を90度まで持ち上げます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
