          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixiere die Beine am Ende der Negativbank und lege dich langsam auf die Bank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegura las piernas en el extremo del banco declinado y acuéstate lentamente en el banco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
