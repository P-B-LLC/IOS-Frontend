          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich hüftbreit hin, ein Fuß steht leicht vor dem anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie con los pies separados al ancho de las caderas, un pie ligeramente por delante del otro."
