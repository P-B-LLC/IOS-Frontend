    "Go as deep as you can control, ideally until your hamstring rests on your calf, keeping your heel down." : {
      "comment" : "A step of how to do the exercise “Pistol Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل إلى أعمق مستوى تستطيع التحكم فيه، ويفضل حتى تستقر العضلات الخلفية للفخذ على السمانة، مع إبقاء كعبك على الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh so tief, wie du es kontrollieren kannst, idealerweise bis der Beinbeuger auf der Wade ruht, und halte die Ferse am Boden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja tan profundo como puedas controlar, idealmente hasta que el isquiotibial descanse sobre la pantorrilla, manteniendo el talón en el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez aussi bas que vous pouvez contrôler, idéalement jusqu'à ce que l'ischio-jambier repose sur le mollet, en gardant le talon au sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जितना गहरा नियंत्रण में जा सकें उतना जाएं, आदर्श रूप से जब तक हैमस्ट्रिंग पिंडली पर न टिक जाए, एड़ी नीचे रखते हुए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "かかとを床につけたまま、コントロールできる範囲で深く、理想的にはハムストリングスがふくらはぎにのるまで下ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça até onde conseguir controlar, idealmente até o posterior de coxa apoiar na panturrilha, mantendo o calcanhar no chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опускайтесь так глубоко, как можете контролировать, в идеале пока бицепс бедра не ляжет на икру, держа пятку на полу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下蹲到你能控制的最深位置，理想状态是大腿后侧贴到小腿，脚跟保持踩地。"
          }
        }
      }
    },
    "Go back slowly to the starting position as you breathe in by lowering your heels as you bend the ankles until calves are stretched." : {
      "comment" : "A step of how to do the exercise “Donkey Calf Raise”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد ببطء إلى وضع البداية مع الشهيق بخفض كعبيك وثني كاحليك حتى تتمدد عضلات السمانة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe beim Einatmen langsam in die Ausgangsposition zurück, indem du die Fersen absenkst und die Sprunggelenke beugst, bis die Waden gedehnt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve lentamente a la posición inicial mientras inhalas, bajando los talones y flexionando los tobillos hasta estirar las pantorrillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez lentement à la position de départ en inspirant, en abaissant les talons et en fléchissant les chevilles jusqu'à étirer les mollets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस लेते हुए टखनों को मोड़कर एड़ियां नीचे करते हुए धीरे-धीरे शुरुआती स्थिति में लौटें, जब तक पिंडलियों में खिंचाव न आ जाए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸いながら、足首を曲げてかかとを下ろし、ふくらはぎが伸びるまでゆっくりと開始姿勢に戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte lentamente à posição inicial enquanto inspira, abaixando os calcanhares e flexionando os tornozelos até alongar as panturrilhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно вернитесь в исходное положение на вдохе, опуская пятки и сгибая голеностопы, пока икры не растянутся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气，缓慢放下脚跟，弯曲脚踝直到小腿被拉伸，回到起始位置。"
          }
        }
      }
    },
    "Go back slowly to the starting position as you breathe in." : {
      "comment" : "A step of how to do the exercise “Hanging Leg Raise”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد ببطء إلى وضع البداية مع الشهيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe beim Einatmen langsam zurück in die Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve lentamente a la posición inicial mientras inhalas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez lentement à la position de départ en inspirant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस लेते हुए धीरे-धीरे शुरुआती स्थिति में लौटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸いながら、ゆっくりと開始姿勢に戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte lentamente à posição inicial enquanto inspira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно вернитесь в исходное положение на вдохе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气，缓慢回到起始位置。"
          }
        }
      }
    },
    "Go back to the initial position as you breathe in." : {
      "comment" : "A step of how to do the exercise “Bicycle Crunch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
