          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フラットベンチに仰向けになり、両手にダンベルを持って太ももの上に置きます。手のひらは向かい合わせにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
