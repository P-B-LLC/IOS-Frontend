    "Rock forward onto your hips and lower back, still holding the same shape." : {
      "comment" : "A step of how to do the exercise “Hollow Rock”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأرجح للأمام على وركيك وأسفل ظهرك، مع الحفاظ على الشكل نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wippe nach vorn auf Hüfte und unteren Rücken und halte dabei weiter dieselbe Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balancéate hacia delante sobre las caderas y la zona lumbar, manteniendo la misma forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculez vers l'avant sur les hanches et le bas du dos, en gardant toujours la même forme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे की ओर कूल्हों और निचली कमर पर झूलें, वही आकार बनाए रखते हुए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ形を保ったまま、腰と下背部に向かって前にロッキングします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance para a frente, sobre o quadril e a lombar, ainda mantendo a mesma forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перекатитесь вперёд на таз и поясницу, по-прежнему сохраняя ту же форму."
