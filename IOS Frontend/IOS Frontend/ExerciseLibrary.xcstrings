            "value" : "استلقِ على الأرض على بطنك وضع يديك على مسافة 90 سم تقريبًا بينهما مع رفع جذعك بطول الذراعين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg dich mit dem Bauch nach unten auf den Boden und setz die Hände etwa 90 cm auseinander, während du den Oberkörper mit gestreckten Armen oben hältst."
          }
        },
        "es" : {
          "stringUnit" : {
