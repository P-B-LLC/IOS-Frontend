          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez la charge en position initiale une seconde et répétez le mouvement pour le nombre de répétitions prescrit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न को शुरुआती स्थिति में एक सेकंड रोकें और तय रेप्स की संख्या तक गति दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタートポジションでウエイトを1秒間キープし、指定された回数この動作を繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o peso na posição inicial por um segundo e repita o movimento pelo número prescrito de repetições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержите вес в исходном положении на секунду и повторяйте движение предписанное количество повторений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
