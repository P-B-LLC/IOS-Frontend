            "state" : "translated",
            "value" : "Halte den Ab Roller mit beiden Händen und knie dich auf den Boden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujeta el rodillo abdominal con ambas manos y arrodíllate en el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez la roue abdominale à deux mains et mettez-vous à genoux sur le sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एब रोलर को दोनों हाथों से पकड़ें और फ़र्श पर घुटनों के बल बैठें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アブローラーを両手で持ち、床にひざまずきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure a roda abdominal com as duas mãos e ajoelhe-se no chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
