          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die Kurzhantel beim Einatmen langsam zurück in die Ausgangsposition ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja lentamente la mancuerna a la posición inicial mientras inhalas."
