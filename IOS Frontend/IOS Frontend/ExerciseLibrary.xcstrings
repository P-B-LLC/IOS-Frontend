        }
      }
    },
    "Walk it out and set your feet about shoulder-width apart with your toes turned out." : {
      "comment" : "A step of how to do the exercise “Low Bar Squat (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارفعه من الرف وابتعد عنه، وضع قدميك بعرض الكتفين تقريبًا مع توجيه أصابع القدمين للخارج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh mit der Stange zurück und stell die Füße etwa schulterbreit auf, die Zehen zeigen nach außen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sácala del rack y coloca los pies separados aproximadamente a la anchura de los hombros con las puntas hacia fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrochez-la, reculez et placez les pieds à peu près à la largeur des épaules, les orteils tournés vers l'extérieur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार को रैक से उतारकर पीछे हटें और पैरों को लगभग कंधों की चौड़ाई पर रखें, पंजे बाहर की ओर घुमे हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーを外して後ろに下がり、足を肩幅程度に開き、つま先を外に向けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire a barra do suporte, dê alguns passos para trás e posicione os pés na largura dos ombros, aproximadamente, com as pontas voltadas para fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите штангу со стоек, отойдите и поставьте ноги примерно на ширине плеч, носки развёрнуты наружу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取下杠铃后退几步站稳，双脚约与肩同宽，脚尖外展。"
          }
        }
      }
    },
