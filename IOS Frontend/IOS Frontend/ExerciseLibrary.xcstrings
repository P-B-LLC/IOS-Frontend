        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie frente a un banco o una plataforma elevada resistente. Coloca las manos en el borde del banco o la plataforma, ligeramente más anchas que los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
