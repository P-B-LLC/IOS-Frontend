    "Plant your feet firmly on the ground as you lean forward, extending through the hips and knees to jump up and forward." : {
      "comment" : "A step of how to do the exercise “Seated Box Jump”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت قدميك بإحكام على الأرض أثناء الميل للأمام، ثم مدّ وركيك وركبتيك للقفز للأعلى وللأمام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz die Füße fest auf den Boden, während du dich nach vorn lehnst, und streck Hüfte und Knie, um nach oben und vorn zu springen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya los pies firmemente en el suelo mientras te inclinas hacia delante, extendiendo caderas y rodillas para saltar hacia arriba y hacia delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantez fermement les pieds au sol en vous penchant en avant, puis étendez les hanches et les genoux pour sauter vers le haut et l'avant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे झुकते हुए पैरों को ज़मीन पर मज़बूती से जमाएं, कूल्हों और घुटनों को सीधा करके ऊपर और आगे की ओर कूदें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足を地面にしっかり付けて前傾し、股関節と膝を伸ばして上方かつ前方にジャンプします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie os pés firmemente no chão enquanto se inclina para a frente, estendendo quadril e joelhos para saltar para cima e para a frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твёрдо упритесь ступнями в землю, наклонитесь вперёд и, разгибая бёдра и колени, выпрыгните вверх и вперёд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双脚牢牢踩住地面，身体前倾，伸展髋部和膝盖，向上向前跳起。"
          }
        }
      }
    },
    "Plant your outside foot, touch the line with your hand and change direction." : {
      "comment" : "A step of how to do the exercise “Shuttle Run”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت قدمك الخارجية على الأرض، ولامس الخط بيدك وغيّر الاتجاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz den äußeren Fuß fest auf, berühre die Linie mit der Hand und wechsle die Richtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planta el pie exterior, toca la línea con la mano y cambia de dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantez le pied extérieur, touchez la ligne de la main et changez de direction."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहरी पैर को ज़मीन पर जमाएं, हाथ से रेखा को छुएं और दिशा बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外側の足を踏み込み、手でラインに触れて方向を変えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firme o pé de fora, toque a linha com a mão e mude de direção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте внешнюю ногу, коснитесь линии рукой и смените направление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外侧脚踩稳，用手触碰线并变向。"
          }
        }
      }
    },
