          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirf den Ball mit voller Wucht nach vorn, beuge dich dabei in der Hüfte und setze den ganzen Körper ein, um die Bewegung zu vollenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanza el balón hacia delante con fuerza, flexionando la cadera y usando todo el cuerpo para completar el movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez le ballon vers l'avant avec force, en fléchissant à la hanche et en utilisant tout votre corps pour terminer le mouvement."
