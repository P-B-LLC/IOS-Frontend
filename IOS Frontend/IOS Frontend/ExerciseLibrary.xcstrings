    "Hike the bell between your legs and drive your hips through powerfully." : {
      "comment" : "A step of how to do the exercise “American Kettlebell Swing”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر الكيتل بيل بين ساقيك ثم ادفع وركيك للأمام بقوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwinge die Kettlebell zwischen deinen Beinen nach hinten und treibe die Hüfte kraftvoll nach vorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanza la pesa hacia atrás entre las piernas y empuja las caderas con fuerza hacia delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez le kettlebell entre vos jambes et poussez les hanches vers l'avant avec puissance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केटलबेल को पैरों के बीच से पीछे ले जाएं (हाइक करें) और कूल्हों को पूरी ताकत से आगे धकेलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケトルベルを脚の間に振り込み、力強く股関節を前に押し出します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance o kettlebell para trás, entre as pernas, e projete o quadril para a frente com potência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустите гирю между ног и мощно подайте бёдра вперёд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将壶铃向后穿过双腿之间，然后有力地向前送髋。"
          }
        }
      }
    },
    "Hinge and swing both dumbbells back between your legs, then drive your hips forward to bring them overhead in one motion." : {
      "comment" : "A step of how to do the exercise “Devil Press (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ الورك وأرجح الدمبلين للخلف بين ساقيك، ثم ادفع وركيك للأمام لرفعهما فوق رأسك في حركة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge dich in der Hüfte und schwinge beide Kurzhanteln zwischen den Beinen nach hinten. Treibe dann die Hüfte nach vorn, um sie in einer Bewegung über den Kopf zu bringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexiona la cadera y lleva ambas mancuernas hacia atrás entre las piernas, luego impulsa las caderas hacia delante para llevarlas por encima de la cabeza en un solo movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penchez-vous en charnière et balancez les deux haltères vers l'arrière entre vos jambes, puis poussez les hanches vers l'avant pour les amener au-dessus de la tête en un seul mouvement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हिंज करें और दोनों डम्बल को पैरों के बीच से पीछे झुलाएं, फिर कूल्हों को आगे धकेलकर उन्हें एक ही गति में सिर के ऊपर लाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒンジしながら両方のダンベルを脚の間に振り戻し、続けて股関節を前に押し出して、ダンベルを一つの動作で頭上に持ち上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça a dobradiça do quadril e balance os dois halteres para trás, entre as pernas, depois impulsione o quadril para a frente para levá-los acima da cabeça em um único movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь в тазобедренных суставах и отведите обе гантели назад между ног, затем резко выведите таз вперёд, чтобы одним движением поднять их над головой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髋部后铰，将两只哑铃向后摆到两腿之间，然后髋部向前发力，一气呵成地将哑铃举过头顶。"
          }
        }
      }
    },
    "Hinge at the hips with a flat back and lift the bag to your lap." : {
      "comment" : "A step of how to do the exercise “Sandbag Clean”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ جذعك من الوركين بظهر مسطح وارفع الكيس إلى حجرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge dich mit geradem Rücken aus der Hüfte und hebe den Sack bis zu den Oberschenkeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexiona las caderas con la espalda plana y levanta el saco hasta el regazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penchez-vous au niveau des hanches, le dos plat, et soulevez le sac jusqu'à vos cuisses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पीठ सपाट रखते हुए कूल्हों से हिंज करें और बैग को गोद तक उठाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背中を平らにしたまま股関節から曲げ、バッグを太ももの上まで持ち上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexione o quadril com as costas retas e levante o saco até o colo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь в бёдрах с ровной спиной и поднимите мешок к бёдрам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背部平直，髋部折叠，将沙袋提到大腿处。"
          }
        }
      }
    },
    "Hinge at the hips, grab the handle with both hands and hike the bell back between your legs." : {
      "comment" : "A step of how to do the exercise “Kettlebell Swing”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ وركيك، وأمسك المقبض بكلتا يديك، وأرجح الكيتل بيل للخلف بين ساقيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge dich in der Hüfte, greif den Griff mit beiden Händen und schwing die Kettlebell nach hinten zwischen deine Beine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexiona las caderas, sujeta el asa con ambas manos y lanza la pesa hacia atrás entre las piernas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chargez les hanches en arrière, saisissez la poignée à deux mains et envoyez le kettlebell vers l'arrière entre vos jambes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों से हिंज करें, दोनों हाथों से हैंडल पकड़ें और बेल को अपनी टांगों के बीच से पीछे की ओर झुलाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "股関節から折り曲げて両手でハンドルをつかみ、ベルを脚の間に後ろへ引き込みます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça a dobradiça no quadril, segure a alça com as duas mãos e balance o kettlebell para trás, entre as pernas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь в бёдрах, возьмитесь за рукоять обеими руками и отведите гирю назад между ног."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髋部后移屈曲，双手抓住把手，将壶铃向后甩到双腿之间。"
          }
        }
      }
    },
    "Hinge at the hips, grab the handle with one hand and hike the bell back between your legs, keeping your free arm out to the side." : {
      "comment" : "A step of how to do the exercise “Single Arm Kettlebell Swing”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ جذعك من الوركين، وأمسك المقبض بيد واحدة وأرجح الكيتل بيل للخلف بين ساقيك، مع إبقاء ذراعك الحرة ممدودة إلى الجانب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge dich aus der Hüfte, greife den Griff mit einer Hand und schwing die Kettlebell nach hinten zwischen deine Beine, während der freie Arm seitlich ausgestreckt bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexiona las caderas, toma el asa con una mano y lanza la pesa hacia atrás entre las piernas, manteniendo el brazo libre extendido hacia un lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penchez-vous au niveau des hanches, saisissez la poignée d'une main et balancez la kettlebell vers l'arrière entre vos jambes, en gardant le bras libre écarté sur le côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों से हिंज करें, एक हाथ से हैंडल पकड़ें और केटलबेल को पैरों के बीच से पीछे की ओर झुलाएं, खाली बाजू को बगल में फैलाए रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "股関節から曲げて片手でハンドルを握り、ベルを脚の間の後ろに引き込みます。空いている腕は横に出しておきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexione o quadril, segure a alça com uma mão e jogue o kettlebell para trás, entre as pernas, mantendo o braço livre aberto para o lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь в бёдрах, возьмитесь за рукоять одной рукой и махом отведите гирю назад между ногами, свободная рука отведена в сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髋部折叠，单手抓住把手，将壶铃向后甩到两腿之间，空闲的手臂向身侧伸出。"
          }
        }
      }
    },
    "Hinge forward at the hip while your free leg extends straight behind you." : {
      "comment" : "A step of how to do the exercise “Single Leg Romanian Deadlift (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ جذعك للأمام من الورك بينما تمتد ساقك الحرة مستقيمة خلفك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge dich in der Hüfte nach vorn, während sich dein freies Bein gerade nach hinten streckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclínate hacia delante con la cadera mientras la pierna libre se extiende recta hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penchez-vous en avant à partir de la hanche tandis que votre jambe libre se tend droit derrière vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हे से आगे झुकें, जबकि आपका खाली पैर सीधा पीछे की ओर फैलता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空いている脚を後ろにまっすぐ伸ばしながら、股関節から前に倒します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incline o tronco para a frente a partir do quadril enquanto a perna livre se estende reta para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь вперёд в бедре, пока свободная нога отводится прямо назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髋部向前折叠，同时另一条腿向后伸直。"
          }
        }
      }
    },
    "Hinge forward, rest your free forearm on your front knee and grab the end of the bar with an overhand grip." : {
      "comment" : "A step of how to do the exercise “Meadows Row”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ جسمك للأمام من الورك، وأرح ساعدك الحر على ركبتك الأمامية، وأمسك طرف البار بقبضة علوية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge dich in der Hüfte nach vorn, leg den freien Unterarm auf das vordere Knie und greif das Stangenende im Obergriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclínate hacia delante con la cadera, apoya el antebrazo libre sobre la rodilla delantera y sujeta el extremo de la barra con agarre prono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penchez-vous en avant, posez votre avant-bras libre sur le genou avant et saisissez l'extrémité de la barre en pronation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे झुकें, अपनी खाली फ़ोरआर्म को आगे वाले घुटने पर टिकाएं और बार का सिरा ओवरहैंड ग्रिप से पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前に体を折り、空いている方の前腕を前の膝にのせて、オーバーハンドグリップでバーの端を握ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incline o tronco para a frente, apoie o antebraço livre no joelho da frente e segure a ponta da barra com pegada pronada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь вперёд, обопритесь свободным предплечьем о переднее колено и возьмитесь за конец грифа хватом сверху."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身体前倾屈髋，空闲手的前臂搭在前侧膝盖上，用正握抓住杠铃末端。"
          }
        }
      }
    },
    "Hinge to lower the bar to just above your knees with a flat back." : {
      "comment" : "A step of how to do the exercise “Hang Power Clean (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ الورك لإنزال البار إلى فوق ركبتيك مباشرة بظهر مسطح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge dich in der Hüfte, um die Stange mit flachem Rücken bis knapp über die Knie abzusenken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexiona la cadera para bajar la barra hasta justo por encima de las rodillas con la espalda plana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penchez-vous en charnière pour descendre la barre juste au-dessus des genoux, le dos plat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सपाट पीठ के साथ हिंज करके बार को घुटनों के ठीक ऊपर तक नीचे लाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背中を平らに保ってヒンジし、バーを膝のすぐ上まで下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça a dobradiça do quadril para abaixar a barra até logo acima dos joelhos, com as costas retas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь в тазобедренных суставах, опуская гриф чуть выше колен с ровной спиной."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髋部后铰，保持背部平直，将杠铃放低到略高于膝盖的位置。"
          }
        }
      }
    },
