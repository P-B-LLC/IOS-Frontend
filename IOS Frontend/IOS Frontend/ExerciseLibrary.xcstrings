        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हैंडल्स को ऊपरी छाती की ओर नीचे खींचें, कोहनियों को नीचे और पीछे ले जाते हुए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肘を下と後ろに引きながら、ハンドルを上部の胸の方へ引き下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe as alças para baixo, em direção à parte superior do peito, levando os cotovelos para baixo e para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяните рукояти вниз к верхней части груди, направляя локти вниз и назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将把手向下拉向上胸，肘部向下、向后发力。"
          }
        }
      }
    },
    "Pull the handles toward your torso, driving your elbows back and squeezing your shoulder blades together." : {
      "comment" : "A step of how to do the exercise “Seated Row (Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب المقبضين نحو جذعك، مع دفع مرفقيك للخلف وضم لوحي كتفيك معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Griffe zum Oberkörper, führe die Ellbogen nach hinten und drück die Schulterblätter zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira de las asas hacia el torso, llevando los codos hacia atrás y juntando los omóplatos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez les poignées vers votre tronc en poussant les coudes vers l'arrière et en serrant les omoplates l'une contre l'autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहनियों को पीछे ले जाते और शोल्डर ब्लेड को आपस में दबाते हुए हैंडल को धड़ की ओर खींचें।"
