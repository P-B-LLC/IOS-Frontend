    "Lateral to Front Raise (Dumbbell)" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفع جانبي ثم أمامي (دمبل)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit- und Frontheben (Kurzhantel)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elevación lateral a frontal (Mancuerna)"
          }
        },
        "fr" : {
