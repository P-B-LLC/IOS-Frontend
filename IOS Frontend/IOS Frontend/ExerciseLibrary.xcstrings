            "value" : "Abaixe os pesos com um movimento controlado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опустите вес подконтрольным движением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有控制地放下重量。"
          }
        }
      }
    },
    "Lower them slowly, stopping before your lower back lifts off the floor." : {
      "comment" : "A step of how to do the exercise “Lying Leg Raise”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزلهما ببطء، مع التوقف قبل أن يرتفع أسفل ظهرك عن الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke sie langsam ab und halte an, bevor sich der untere Rücken vom Boden abhebt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bájalas despacio, deteniéndote antes de que la zona lumbar se despegue del suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescendez-les lentement, en vous arrêtant avant que le bas du dos ne se décolle du sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्हें धीरे-धीरे नीचे लाएं, निचली कमर के फ़र्श से उठने से पहले ही रुक जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腰が床から浮く手前で止めて、ゆっくり下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixe-as lentamente, parando antes que a lombar saia do chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно опускайте их, остановившись до того, как поясница оторвётся от пола."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓慢放下，在下背部离开地面之前停止。"
          }
        }
      }
    },
    "Lower under control and alternate sides." : {
      "comment" : "A step of how to do the exercise “Archer Pull Up”.",
