    },
    "Lower yourself under control, drop back to the floor and begin the next rep." : {
      "comment" : "A step of how to do the exercise “Burpee Pull Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل بتحكم، وعد إلى الأرض وابدأ التكرار التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich kontrolliert ab, lass dich zurück auf den Boden fallen und beginne die nächste Wiederholung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bájate con control, déjate caer al suelo y empieza la siguiente repetición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescendez avec contrôle, retombez au sol et commencez la répétition suivante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नियंत्रण के साथ खुद को नीचे लाएं, फ़र्श पर वापस उतरें और अगली रेप शुरू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールしながら体を下ろし、床に降りて次の回を始めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça com controle, volte ao chão e comece a próxima repetição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Под контролем опуститесь, спрыгните на пол и начните следующее повторение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有控制地放下，落回地面，然后开始下一次重复。"
          }
        }
      }
    },
    "Lower yourself until your chest almost touches the floor as you inhale." : {
      "comment" : "A step of how to do the exercise “Decline Push Up (Stability Ball)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل حتى يكاد صدرك يلمس الأرض مع الشهيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich beim Einatmen ab, bis deine Brust fast den Boden berührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja el cuerpo hasta que el pecho casi toque el suelo mientras inhalas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez jusqu'à ce que la poitrine frôle presque le sol, en inspirant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस लेते हुए खुद को तब तक नीचे लाएं जब तक आपकी छाती फ़र्श को लगभग छूने न लगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸いながら、胸が床につきそうになるまで体を下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça até que o peito quase toque o chão enquanto inspira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опуститесь, пока грудь почти не коснётся пола, на вдохе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气，降低身体，直到胸部几乎碰到地面。"
          }
        }
      }
    },
