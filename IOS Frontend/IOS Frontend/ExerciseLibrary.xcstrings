            "value" : "Жим Арнольда (Гиря)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿诺德推举（壶铃）"
          }
        }
      }
    },
    "Around the World (Dumbbell)" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
