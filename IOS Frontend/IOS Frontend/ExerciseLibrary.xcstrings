        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将悬挂训练带牢固地固定在架子顶部或其他物体上。"
          }
        }
      }
    },
    "Angle that shin across your body and slide your other leg straight back." : {
      "comment" : "A step of how to do the exercise “Pigeon Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمِل مقدمة تلك الساق عبر جسمك وأزلق ساقك الأخرى مستقيمة للخلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh das Schienbein schräg quer zum Körper und schieb das andere Bein gerade nach hinten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclina esa espinilla cruzándola sobre el cuerpo y desliza la otra pierna recta hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclinez ce tibia en travers du corps et faites glisser l'autre jambe droit vers l'arrière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस पिंडली को शरीर के आर-पार तिरछा करें और दूसरे पैर को सीधा पीछे खिसकाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのすねを体の前で斜めに倒し、もう一方の脚を後ろにまっすぐ滑らせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incline essa canela diagonalmente pelo corpo e deslize a outra perna reta para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разверните эту голень поперёк тела и вытяните другую ногу прямо назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让这条小腿斜着横过身体，另一条腿向后滑直。"
          }
        }
      }
    },
