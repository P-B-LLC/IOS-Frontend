        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घुटनों को छाती की ओर उठाएं, ऊपर पहुंचकर श्रोणि को ऊपर कर्ल करें।"
          }
        },
        "ja" : {
