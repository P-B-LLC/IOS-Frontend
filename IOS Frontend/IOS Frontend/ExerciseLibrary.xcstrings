    "Lying Windshield Wiper" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسّاحة الزجاج مستلقيًا"
          }
        },
        "de" : {
