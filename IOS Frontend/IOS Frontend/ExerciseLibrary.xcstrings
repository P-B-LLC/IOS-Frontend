    "Dip a few inches by bending your knees while keeping your torso upright and your heels down." : {
      "comment" : "A step of how to do the exercise “Push Press (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل بضعة سنتيمترات (نحو 5-8 سم) بثني ركبتيك مع إبقاء جذعك منتصبًا وكعبيك على الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh durch Beugen der Knie ein paar Zentimeter in die Knie, während der Oberkörper aufrecht und die Fersen unten bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja unos centímetros flexionando las rodillas, manteniendo el torso erguido y los talones apoyados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fléchissez les genoux d'une dizaine de centimètres en gardant le tronc droit et les talons au sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धड़ को सीधा और एड़ियों को ज़मीन पर रखते हुए घुटने मोड़कर कुछ इंच (लगभग 5-8 सेमी) नीचे जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上体を起こしてかかとを床に付けたまま、膝を曲げて数センチ沈み込みます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça alguns centímetros flexionando os joelhos, mantendo o tronco ereto e os calcanhares no chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слегка присядьте на несколько сантиметров, сгибая колени, при этом держите корпус вертикально, а пятки прижатыми к полу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持躯干直立、脚跟踩实，屈膝下沉几厘米。"
          }
        }
      }
    },
    "Dip into a quarter squat and swing your arms back." : {
      "comment" : "A step of how to do the exercise “Box Jump Over”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل في ربع سكوات وأرجح ذراعيك إلى الخلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe in eine Viertel-Kniebeuge und schwinge die Arme nach hinten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja en un cuarto de sentadilla y lleva los brazos hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en quart de squat et balancez les bras vers l'arrière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्वार्टर स्क्वॉट में नीचे जाएं और बाजू को पीछे घुमाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4分の1スクワットの位置まで沈み込み、腕を後ろに振ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça em um quarto de agachamento e balance os braços para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните четверть приседа и отведите руки назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下沉成四分之一深蹲，同时双臂向后摆。"
          }
        }
      }
    },
    "Dip your body by bending the knees, keeping your torso upright." : {
      "comment" : "A step of how to do the exercise “Double Jerk (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اهبط بجسمك بثني الركبتين مع إبقاء الجذع منتصبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tauche mit dem Körper ab, indem du die Knie beugst, und halte den Oberkörper aufrecht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja el cuerpo flexionando las rodillas, manteniendo el torso erguido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fléchissez les genoux pour descendre légèrement, en gardant le buste droit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धड़ को सीधा रखते हुए घुटनों को मोड़कर अपने शरीर को नीचे डिप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上体を起こしたまま、膝を曲げて体を沈めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um agachamento curto flexionando os joelhos, mantendo o tronco ereto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слегка присядьте, сгибая колени и сохраняя корпус вертикальным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屈膝下沉身体，保持躯干直立。"
          }
        }
      }
    },
    "Do a push-up, then row one dumbbell to your hip and then the other while keeping your hips level." : {
      "comment" : "A step of how to do the exercise “Man Maker (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدِّ تمرين ضغط، ثم اسحب أحد الدمبلين نحو وركك ثم الآخر مع إبقاء وركيك متوازنين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach einen Liegestütz, rudere dann eine Kurzhantel zur Hüfte und danach die andere, ohne die Hüfte zu verdrehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una flexión, luego rema una mancuerna hacia la cadera y después la otra, manteniendo las caderas niveladas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites une pompe, puis tirez un haltère vers la hanche, puis l'autre, en gardant les hanches à niveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पुश-अप करें, फिर एक डम्बल को कूल्हे तक रो करें और फिर दूसरे को, कूल्हों को बराबर रखते हुए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュアップをしてから、腰の高さを水平に保ったまま、片方のダンベルを腰に向けてロウし、続けてもう片方もロウします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma flexão, depois reme um halter até o quadril e em seguida o outro, mantendo o quadril nivelado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните отжимание, затем подтяните одну гантель к бедру, а потом другую, удерживая таз на одном уровне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做一个俯卧撑，然后依次将一个哑铃划船拉向髋部，再拉另一个，同时保持髋部水平。"
          }
        }
      }
    },
    "Do one pushup and as you come up, shift your weight on the left side of the body, twist to the side while bringing the right arm up towards the ceiling in a side plank." : {
      "comment" : "A step of how to do the exercise “Push Up to Side Plank”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدِّ ضغطة واحدة، وعند الصعود انقل وزنك إلى الجانب الأيسر من الجسم، والتفّ إلى الجانب مع رفع الذراع اليمنى نحو السقف في وضع البلانك الجانبي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach einen Liegestütz, verlagere beim Hochkommen dein Gewicht auf die linke Körperseite und dreh dich zur Seite, während du den rechten Arm in einem seitlichen Unterarmstütz zur Decke streckst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una flexión y, al subir, desplaza tu peso hacia el lado izquierdo del cuerpo y gira hacia ese lado llevando el brazo derecho hacia el techo en una plancha lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites une pompe et, en remontant, déplacez votre poids sur le côté gauche du corps, pivotez sur le côté en levant le bras droit vers le plafond pour passer en gainage latéral."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पुश-अप करें और ऊपर आते समय वज़न को शरीर के बाईं ओर शिफ़्ट करें, बगल की ओर मुड़ें और दाहिनी बाजू को छत की ओर उठाकर साइड प्लैंक में आ जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕立て伏せを1回行い、上がってくるときに体重を体の左側に移し、体をひねりながら右腕を天井に向けて上げ、サイドプランクの姿勢になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma flexão e, ao subir, transfira o peso para o lado esquerdo do corpo, gire para o lado levando o braço direito em direção ao teto, em uma prancha lateral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте одно отжимание, и при подъёме перенесите вес на левую сторону тела, развернитесь вбок, поднимая правую руку к потолку в боковой планке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做一个俯卧撑，撑起时将重心移到身体左侧，转体成侧平板，同时右臂向天花板方向抬起。"
          }
        }
      }
    },
