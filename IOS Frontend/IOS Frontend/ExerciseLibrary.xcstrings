    "Return to the starting position and repeat the exercise, working all the way around until you are back where you started." : {
      "comment" : "A step of how to do the exercise “Clock Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد إلى وضع البداية وكرر التمرين، مواصلًا الدوران حتى تعود إلى حيث بدأت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre in die Ausgangsposition zurück und wiederhole die Übung, bis du einmal ganz herum bist und wieder am Ausgangspunkt stehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
