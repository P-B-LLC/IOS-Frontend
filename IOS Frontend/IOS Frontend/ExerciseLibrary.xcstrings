      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدلَّ من البار بذراعين مستقيمتين وجسم مشدود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge mit gestreckten Armen und angespanntem Körper an der Stange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuélgate de la barra con los brazos rectos y el cuerpo tenso."
          }
        },
        "fr" : {
