    "Alternating Bicep Curl (Dumbbell)" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثني الذراع بالتناوب (دمبل)"
          }
        },
        "de" : {
