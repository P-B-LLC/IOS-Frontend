    "Measure the distance from your landing point to the starting point and track results." : {
      "comment" : "A step of how to do the exercise “Broad Jump”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قس المسافة من نقطة الهبوط إلى نقطة البداية وسجّل نتائجك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miss die Entfernung von deinem Landepunkt zum Startpunkt und halte die Ergebnisse fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide la distancia desde el punto de aterrizaje hasta el punto de partida y registra los resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesurez la distance entre votre point de réception et le point de départ et suivez vos résultats."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उतरने की जगह से शुरुआती जगह तक की दूरी नापें और नतीजों को ट्रैक करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "着地点からスタート地点までの距離を測り、結果を記録します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meça a distância do ponto de aterrissagem até o ponto de partida e registre os resultados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измерьте расстояние от точки приземления до места старта и записывайте результаты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测量落地点到起点的距离，并记录成绩。"
          }
        }
      }
    },
