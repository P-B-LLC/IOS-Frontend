          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétez 3 à 5 fois, puis continuez avec un poids plus lourd, en vous déplaçant le plus vite possible."
          }
        },
        "hi" : {
