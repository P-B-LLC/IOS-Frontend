            "value" : "اقفز أعلى قليلًا من القفز العادي، مع البقاء على مقدمة قدميك وساقاك شبه مستقيمتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Springe etwas höher als bei einem normalen Hüpfer, bleibe auf den Fußballen und halte die Beine fast gestreckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta un poco más alto que en un salto normal, manteniéndote sobre las puntas de los pies y con las piernas casi estiradas."
          }
