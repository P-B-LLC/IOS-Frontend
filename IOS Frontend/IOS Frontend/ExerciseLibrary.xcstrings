          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la cuerda con giros rápidos de muñeca para que pase dos veces bajo tus pies antes de aterrizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
