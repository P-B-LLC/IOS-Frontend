          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tritt vom Ständer weg und stelle die Beine in einem mittleren, schulterbreiten Stand auf, die Zehen zeigen leicht nach außen. Halte den Kopf die ganze Zeit oben, denn der Blick nach unten bringt dich aus dem Gleichgewicht, und halte den Rücken gerade. Die Knie sollten leicht gebeugt bleiben, niemals durchgestreckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
