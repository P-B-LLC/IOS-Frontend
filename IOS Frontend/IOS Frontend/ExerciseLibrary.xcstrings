            "state" : "translated",
            "value" : "Après une pause d'une seconde, revenez à la position de départ en inspirant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक सेकंड रुकने के बाद साँस लेते हुए वापस शुरुआती स्थिति में लौटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1秒間止まってから、息を吸いながら開始姿勢に戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após uma pausa de um segundo, volte à posição inicial enquanto inspira."
          }
        },
        "ru" : {
          "stringUnit" : {
