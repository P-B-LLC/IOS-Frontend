            "value" : "Mantén los brazos rectos y desplaza los hombros hacia delante, más allá de las manos, quedando sobre las puntas de los pies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les bras tendus et avancez les épaules au-delà des mains, en vous mettant sur la pointe des pieds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजुओं को सीधा रखें और कंधों को हाथों से आगे ले जाएं, पंजों पर आ जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕をまっすぐに保ったまま、肩を手の前に出し、つま先立ちになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
