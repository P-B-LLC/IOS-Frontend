          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraia os glúteos no topo e depois abaixe o quadril de forma controlada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сожмите ягодицы вверху, затем подконтрольно опустите таз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在顶端挤压臀部，然后控制着放下髋部。"
          }
        }
      }
    },
    "Squeeze your legs together and keep your ribs down so your body stays in a straight line." : {
      "comment" : "A step of how to do the exercise “Handstand Walk”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضم ساقيك معًا وأبقِ أضلاعك للأسفل ليبقى جسمك في خط مستقيم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke die Beine zusammen und halte die Rippen unten, damit dein Körper in einer geraden Linie bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprieta las piernas juntas y mantén las costillas hacia abajo para que el cuerpo permanezca en línea recta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serrez les jambes l'une contre l'autre et gardez les côtes basses pour que votre corps reste en ligne droite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों को आपस में भींचें और पसलियों को नीचे रखें ताकि आपका शरीर एक सीधी रेखा में रहे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚をぴったり閉じ、肋骨を下げて、体が一直線になるようにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperte as pernas uma contra a outra e mantenha as costelas para baixo, de modo que o corpo permaneça em linha reta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сожмите ноги вместе и держите рёбра опущенными, чтобы тело оставалось на одной прямой линии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双腿夹紧，肋骨下沉，使身体保持成一条直线。"
          }
        }
      }
    },
    "Squeeze your side to lift your top leg and bring your top elbow toward it at the same time." : {
      "comment" : "A step of how to do the exercise “Side Jackknife”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على جانبك لرفع ساقك العلوية وتقريب مرفقك العلوي منها في الوقت نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spann die Körperseite an, um das obere Bein zu heben und gleichzeitig den oberen Ellbogen zu ihm zu bringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprieta el costado para levantar la pierna de arriba y llevar al mismo tiempo el codo de arriba hacia ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contractez votre flanc pour lever la jambe du dessus et amener en même temps le coude du dessus vers elle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बगल को दबाते हुए ऊपर वाला पैर उठाएं और साथ ही ऊपर वाली कोहनी को उसकी ओर लाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体の側面を絞って上側の脚を持ち上げ、同時に上側の肘をその脚に近づけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraia a lateral do corpo para levantar a perna de cima e levar o cotovelo de cima em direção a ela ao mesmo tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напрягите бок, чтобы поднять верхнюю ногу и одновременно подтянуть к ней верхний локоть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收紧身体侧面，同时抬起上侧腿，并让上侧肘部朝它靠拢。"
          }
        }
      }
    },
    "Stack your hips so your top hip is directly over the bottom one." : {
      "comment" : "A step of how to do the exercise “Clamshell”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رتّب وركيك فوق بعضهما بحيث يكون الورك العلوي فوق السفلي مباشرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stapele deine Hüften, sodass die obere Hüfte direkt über der unteren liegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apila las caderas de modo que la cadera de arriba quede directamente sobre la de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empilez vos hanches de façon que la hanche du dessus soit directement au-dessus de celle du dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों को एक के ऊपर एक रखें ताकि ऊपर वाला कूल्हा नीचे वाले के ठीक ऊपर हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上側の股関節が下側の真上に来るように、腰を重ねます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empilhe o quadril de modo que o quadril de cima fique diretamente sobre o de baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расположите бёдра одно над другим, чтобы верхнее бедро находилось прямо над нижним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将髋部上下叠放，使上方的髋部正好在下方髋部之上。"
          }
        }
      }
    },
    "Stagger your stance and curl the handle forward and up while keeping your elbow behind your torso." : {
      "comment" : "A step of how to do the exercise “Bayesian Curl (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتخذ وقفة متدرجة (إحدى القدمين أمام الأخرى) وارفع المقبض إلى الأمام وإلى الأعلى في حركة كيرل مع إبقاء مرفقك خلف جذعك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stehe in Schrittstellung und führe den Griff im Curl nach vorn und oben, während der Ellbogen hinter dem Oberkörper bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa los pies, uno delante del otro, y haz el curl del asa hacia delante y hacia arriba manteniendo el codo detrás del torso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez-vous en position décalée et faites monter la poignée vers l'avant et le haut en curl, tout en gardant le coude derrière le buste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टांस को आगे-पीछे रखें और कोहनी को धड़ के पीछे रखते हुए हैंडल को आगे और ऊपर की ओर कर्ल करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足を前後にずらして立ち、肘を上体の後ろに置いたまま、ハンドルを前上方にカールします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em base escalonada e faça a rosca do pegador para a frente e para cima, mantendo o cotovelo atrás do tronco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте ноги в шаговую стойку и сгибайте руку с рукоятью вперёд и вверх, удерживая локоть позади корпуса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错开站姿，将把手向前向上弯举，同时保持肘部位于躯干后方。"
          }
        }
      }
    },
    "Stair Climber" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهاز صعود الدرج"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treppensteiger"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaladora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stepper"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टेयर क्लाइंबर"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステアクライマー"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulador de escada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Степпер"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "踏步机"
          }
        }
      }
    },
    "Stairmasters offer convenience, cardiovascular benefits, and usually have less impact than running outside. They are typically much harder than other cardio equipment. A 150 lb person will typically burn over 300 calories in 30 minutes, compared to about 175 calories walking." : {
      "comment" : "A step of how to do the exercise “Stair Climber”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توفر أجهزة الدرج الراحة والفوائد القلبية الوعائية، وعادةً ما يكون تأثيرها أقل من الجري في الخارج. وهي عادةً أصعب بكثير من أجهزة الكارديو الأخرى. سيحرق شخص وزنه 70 كجم عادةً أكثر من 300 سعر حراري في 30 دقيقة، مقارنةً بحوالي 175 سعرًا حراريًا عند المشي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stairmaster bieten Komfort und Vorteile für das Herz-Kreislauf-System und sind in der Regel gelenkschonender als Laufen im Freien. Sie sind normalerweise deutlich anstrengender als andere Cardiogeräte. Eine Person mit 70 kg verbrennt in 30 Minuten typischerweise über 300 Kalorien, verglichen mit etwa 175 Kalorien beim Gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las escaladoras ofrecen comodidad y beneficios cardiovasculares, y normalmente tienen menos impacto que correr al aire libre. Suelen ser mucho más exigentes que otros equipos de cardio. Una persona de 70 kg suele quemar más de 300 calorías en 30 minutos, frente a unas 175 calorías caminando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les stairmasters offrent de la praticité et des bénéfices cardiovasculaires, et ont généralement moins d'impact que la course en extérieur. Ils sont généralement bien plus difficiles que les autres machines de cardio. Une personne de 68 kg brûle généralement plus de 300 calories en 30 minutes, contre environ 175 calories en marchant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टेयरमास्टर सुविधा, कार्डियोवैस्कुलर लाभ देते हैं, और आमतौर पर बाहर दौड़ने की तुलना में कम इम्पैक्ट वाले होते हैं। ये आमतौर पर दूसरी कार्डियो मशीनों से काफ़ी कठिन होते हैं। 68 किलो वज़न का व्यक्ति आमतौर पर 30 मिनट में 300 से ज़्यादा कैलोरी जलाता है, जबकि पैदल चलने में लगभग 175 कैलोरी जलती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステアマスターは手軽で、心肺機能の向上に役立ち、通常は屋外でのランニングより衝撃が少なくなります。他の有酸素マシンより通常ずっときつくなります。体重約68kgの人は、30分で通常300kcal以上を消費しますが、ウォーキングでは約175kcalです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O stairmaster oferece praticidade e benefícios cardiovasculares, e geralmente tem menos impacto do que correr ao ar livre. Em geral, é bem mais difícil do que outros aparelhos de cardio. Uma pessoa de 68 kg normalmente queima mais de 300 calorias em 30 minutos, em comparação com cerca de 175 calorias caminhando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Степперы удобны, полезны для сердечно-сосудистой системы и обычно создают меньшую ударную нагрузку, чем бег на улице. Как правило, они значительно тяжелее другого кардиооборудования. Человек весом 68 кг обычно сжигает более 300 калорий за 30 минут, по сравнению с примерно 175 калориями при ходьбе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登阶机方便易用，有益心血管，而且通常比户外跑步冲击更小。它通常比其他有氧器械难得多。一个 70 公斤的人 30 分钟通常能消耗 300 多卡路里，而步行约消耗 175 卡路里。"
          }
        }
      }
    },
    "Stand (torso upright) with a dumbbell in each hand held at arms length. The elbows should be close to the torso and the palms of your hand should be facing your thighs." : {
      "comment" : "A step of how to do the exercise “Alternating Bicep Curl (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف بجذع مستقيم وفي كل يد دمبل، مع مد الذراعين إلى الأسفل. يجب أن يكون المرفقان قريبين من الجذع وراحتا يديك متجهتين نحو فخذيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich aufrecht hin, in jeder Hand eine Kurzhantel mit hängenden Armen. Die Ellbogen sollten nah am Oberkörper sein und die Handflächen zu den Oberschenkeln zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie (con el torso erguido) con una mancuerna en cada mano, con los brazos extendidos a los lados. Los codos deben estar cerca del torso y las palmas de las manos deben mirar hacia los muslos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout (buste droit) avec un haltère dans chaque main, bras tendus le long du corps. Les coudes doivent être près du buste et les paumes tournées vers vos cuisses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीधे खड़े हों और हर हाथ में एक डम्बल पकड़ें, हाथ पूरी तरह सीधे नीचे रखें। कोहनियां धड़ के पास हों और हथेलियां आपकी जांघों की ओर हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上体を起こして立ち、両手にダンベルを持って腕を下に伸ばします。肘は体の近くに置き、手のひらは太ももに向けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé (tronco ereto) com um halter em cada mão, com os braços estendidos. Os cotovelos devem ficar junto ao tronco e as palmas das mãos voltadas para as coxas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте прямо, держа в каждой руке по гантели на опущенных руках. Локти прижаты к корпусу, ладони обращены к бёдрам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站直（躯干挺直），双手各持一个哑铃，手臂自然下垂。肘部靠近躯干，掌心朝向大腿。"
          }
        }
      }
    },
    "Stand about two feet in front of a bench and rest the top of your back foot on it." : {
      "comment" : "A step of how to do the exercise “Bulgarian Split Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على بعد نحو 60 سم أمام مقعد وضع أعلى قدمك الخلفية عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich etwa 60 cm vor eine Bank und lege die Oberseite des hinteren Fußes darauf ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate a unos 60 cm frente a un banco y apoya el empeine del pie trasero sobre él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous à environ 60 cm devant un banc et posez le dessus du pied arrière dessus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेंच के लगभग 60 सेमी आगे खड़े हों और अपने पिछले पैर का ऊपरी हिस्सा उस पर टिकाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベンチの約60cm手前に立ち、後ろ足の甲をベンチに乗せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé a cerca de 60 cm à frente de um banco e apoie o peito do pé de trás sobre ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте примерно в 60 см перед скамьёй и положите верх задней стопы на неё."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在凳子前方约60厘米处，将后脚脚背放在凳子上。"
          }
        }
      }
    },
    "Stand an arm's length from a wall with your feet shoulder-width apart, holding a medicine ball at chest height with your elbows under the ball." : {
      "comment" : "A step of how to do the exercise “Wall Ball”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على بعد طول ذراع من جدار وقدماك متباعدتان بعرض الكتفين، وأنت تمسك كرة طبية عند مستوى الصدر ومرفقاك تحت الكرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich eine Armlänge von einer Wand entfernt hin, die Füße schulterbreit auseinander, und halte einen Medizinball auf Brusthöhe, die Ellbogen unter dem Ball."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate a un brazo de distancia de una pared con los pies separados al ancho de los hombros, sosteniendo un balón medicinal a la altura del pecho con los codos debajo del balón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous à bout de bras d'un mur, les pieds écartés à la largeur des épaules, un médecine-ball tenu à hauteur de poitrine, les coudes sous le ballon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दीवार से एक बाजू की दूरी पर पैरों को कंधों की चौड़ाई पर रखकर खड़े हों, मेडिसिन बॉल को छाती की ऊंचाई पर पकड़ें और कोहनियां गेंद के नीचे हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁から腕の長さほど離れて、足を肩幅に開いて立ちます。メディシンボールを胸の高さで、ボールの下に肘が来るように持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé a um braço de distância de uma parede, com os pés afastados na largura dos ombros, segurando uma medicine ball na altura do peito, com os cotovelos sob a bola."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на расстоянии вытянутой руки от стены, стопы на ширине плеч, медбол удерживайте на уровне груди, локти под мячом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在距墙一臂远的位置，双脚与肩同宽，双手在胸部高度持药球，肘部位于球下方。"
          }
        }
      }
    },
    "Stand between a couple of high pulleys and grab a handle in each arm. Position your upper arms in a way that they are parallel to the floor with the palms of your hands facing you. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Overhead Bicep Curl (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف بين بكرتين علويتين وأمسك مقبضًا في كل يد. ضع ذراعيك العلويتين بحيث تكونان موازيتين للأرض وراحتا يديك متجهتان نحوك. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich zwischen zwei hohe Umlenkrollen und greif mit jeder Hand einen Griff. Halte die Oberarme parallel zum Boden, die Handflächen zeigen zu dir. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie entre dos poleas altas y sujeta un asa con cada mano. Coloca la parte superior de los brazos paralela al suelo con las palmas de las manos hacia ti. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez-vous entre deux poulies hautes et saisissez une poignée dans chaque main. Placez le haut des bras parallèle au sol, les paumes tournées vers vous. Voici votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो ऊंची पुलियों के बीच खड़े हों और हर बाजू से एक हैंडल पकड़ें। ऊपरी बाजुओं को इस तरह रखें कि वे फ़र्श के समानांतर हों और हथेलियां आपकी ओर हों। यही आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つのハイプーリーの間に立ち、両手にハンドルを1つずつ握ります。上腕が床と平行になり、手のひらが自分の方を向くようにします。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé entre duas polias altas e segure uma alça em cada mão. Posicione a parte superior dos braços paralela ao chão, com as palmas das mãos voltadas para você. Esta será sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте между двумя верхними блоками и возьмитесь за рукоять в каждую руку. Расположите плечи параллельно полу, ладони обращены к вам. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在两个高位滑轮之间，双手各抓住一个把手。上臂与地面平行，掌心朝向自己。这就是起始姿势。"
          }
        }
      }
    },
    "Stand directly between both pulleys with your arms extended out to your sides. Your head and chest should be up while your arms form a \"T\". This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Iron Cross (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف بين البكرتين مباشرة وذراعاك ممدودتان إلى الجانبين. يجب أن يكون رأسك وصدرك مرتفعين بينما تشكل ذراعاك حرف \"T\". هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich direkt zwischen beide Kabelzüge, die Arme seitlich ausgestreckt. Kopf und Brust sollten oben sein, während deine Arme ein „T“ bilden. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate justo entre ambas poleas con los brazos extendidos hacia los lados. La cabeza y el pecho deben estar en alto y los brazos formar una \"T\". Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout juste entre les deux poulies, les bras tendus sur les côtés. La tête et la poitrine sont hautes et vos bras forment un « T ». Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों पुली के ठीक बीच में खड़े हों, बाजुएं अपने बगल में फैली हों। आपका सिर और छाती ऊपर हों जबकि बाजुएं \"T\" का आकार बनाएं। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のプーリーのちょうど真ん中に立ち、腕を左右に伸ばします。頭と胸を上げ、腕が「T」の字になるようにします。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé exatamente entre as duas polias, com os braços estendidos para os lados. A cabeça e o peito devem ficar erguidos, e os braços devem formar um \"T\". Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте точно между блоками, руки вытянуты в стороны. Голова и грудь подняты, руки образуют букву «Т». Это будет ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在两个滑轮正中间，双臂向两侧伸直。头部和胸部抬起，双臂与身体形成“T”字形。这就是起始姿势。"
          }
        }
      }
    },
    "Stand directly in between the uprights. Grasp the cables and hold them at shoulder height, palms facing forward. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Standing Shoulder Press (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف مباشرة بين العمودين. أمسك الكابلين وثبّتهما عند مستوى الكتفين، والراحتان للأمام. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich direkt zwischen die Pfosten. Greife die Kabel und halte sie auf Schulterhöhe, die Handflächen zeigen nach vorn. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie justo entre los postes. Agarra los cables y sostenlos a la altura de los hombros, con las palmas hacia delante. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous directement entre les montants. Saisissez les câbles et tenez-les à hauteur d'épaule, paumes vers l'avant. Ceci sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों खंभों के ठीक बीच में खड़े हों। केबल को पकड़ें और कंधे की ऊंचाई पर रखें, हथेलियां आगे की ओर। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本の支柱のちょうど間に立ちます。ケーブルをつかみ、手のひらを前に向けて肩の高さで保持します。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé exatamente entre as colunas. Segure os cabos e mantenha-os na altura dos ombros, com as palmas voltadas para a frente. Esta será sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте точно между стойками. Возьмите рукояти и держите их на уровне плеч, ладони обращены вперёд. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在两根立柱的正中间。抓住绳索，举到肩部高度，掌心朝前。这就是起始姿势。"
          }
        }
      }
    },
    "Stand erect close to the pulley with your arms extended in front of you holding the bar. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Shrug (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف منتصبًا قرب البكرة وذراعاك ممدودتان أمامك وتمسكان البار. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich aufrecht nah an den Kabelzug, die Arme mit der Stange vor dir gestreckt. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie, erguido y cerca de la polea, con los brazos extendidos frente a ti sosteniendo la barra. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous bien droit près de la poulie, les bras tendus devant vous, en tenant la barre. Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुली के पास सीधे खड़े हों, बाजुएँ आपके सामने सीधी हों और बार को पकड़े हुए हों। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プーリーの近くにまっすぐ立ち、バーを持って腕を体の前に伸ばします。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique ereto, perto da polia, com os braços estendidos à sua frente segurando a barra. Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте прямо близко к блоку, руки вытянуты перед вами и держат гриф. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靠近滑轮直立，手臂在身前伸直握住杆。这是你的起始姿势。"
          }
        }
      }
    },
    "Stand erect while holding a barbell with a supinated grip (palms facing up)." : {
      "comment" : "A step of how to do the exercise “Bent Over Row - Reverse Grip (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف منتصبًا وأنت تمسك بار أثقال بقبضة سفلية (راحتا اليدين للأعلى)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stehe aufrecht und halte eine Langhantel im Untergriff (Handflächen zeigen nach oben)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie, erguido, sosteniendo una barra con un agarre supino (palmas hacia arriba)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous bien droit en tenant une barre avec une prise en supination (paumes tournées vers le haut)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारबेल को सुपिनेटेड ग्रिप (हथेलियां ऊपर की ओर) से पकड़कर सीधे खड़े हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーベルをアンダーハンドグリップ(手のひらを上に向ける)で持って、まっすぐ立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé, com o corpo ereto, segurando uma barra com pegada supinada (palmas voltadas para cima)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте прямо, держа штангу обратным хватом (ладони вверх)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站直，用反握（掌心朝上）握住杠铃。"
          }
        }
      }
    },
    "Stand erect with a dumbbell on each hand (palms facing your torso), arms extended on the sides." : {
      "comment" : "A step of how to do the exercise “Shrug (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف منتصبًا وفي كل يد دمبل (الراحتان متجهتان نحو جذعك) وذراعاك ممدودتان إلى الجانبين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich aufrecht hin, in jeder Hand eine Kurzhantel (Handflächen zeigen zu deinem Oberkörper), die Arme seitlich gestreckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie, erguido, con una mancuerna en cada mano (palmas hacia el torso) y los brazos extendidos a los lados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous bien droit avec un haltère dans chaque main (paumes tournées vers votre tronc), les bras tendus sur les côtés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हाथ में एक डम्बल (हथेलियाँ धड़ की ओर) पकड़कर सीधे खड़े हों, बाजुएँ बगल में सीधी हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両手にダンベルを1つずつ持ち（手のひらは体幹に向ける）、腕を体の横に伸ばしてまっすぐ立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique ereto com um halter em cada mão (palmas voltadas para o tronco), com os braços estendidos ao lado do corpo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте прямо с гантелью в каждой руке (ладони обращены к корпусу), руки опущены вдоль тела."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直立，双手各握一个哑铃（掌心朝向躯干），手臂在两侧伸直。"
          }
        }
      }
    },
    "Stand facing a Smith machine bar or sturdy elevated platform at an appropriate height." : {
      "comment" : "A step of how to do the exercise “Incline Push Up - Close Grip”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف في مواجهة بار جهاز سميث أو منصة مرتفعة متينة بارتفاع مناسب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich mit dem Gesicht zu einer Multipresse-Stange oder einer stabilen erhöhten Plattform in passender Höhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie frente a la barra de una máquina Smith o una plataforma elevada resistente a una altura adecuada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout face à la barre d'une Smith machine ou à une plateforme surélevée solide, à une hauteur appropriée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्मिथ मशीन के बार या उचित ऊंचाई पर मज़बूत ऊंचे प्लेटफ़ॉर्म की ओर मुंह करके खड़े हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スミスマシンのバー、または適切な高さの頑丈な台に向かって立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé de frente para a barra da Smith ou uma plataforma elevada firme, em uma altura adequada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте лицом к грифу тренажёра Смита или устойчивой приподнятой платформе на подходящей высоте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面向史密斯机的杠或高度合适的牢固高台站立。"
          }
        }
      }
    },
    "Stand facing a barbell on the floor, parallel to it, with your toes close to the bar." : {
      "comment" : "A step of how to do the exercise “Bar Facing Burpee”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
