        }
      }
    },
    "Hold your hips level with your shoulders and keep pushing the floor away." : {
      "comment" : "A step of how to do the exercise “Advanced Tuck Planche”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
