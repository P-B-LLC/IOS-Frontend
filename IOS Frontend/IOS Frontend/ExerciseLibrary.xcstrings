            "state" : "translated",
            "value" : "膝を胸に向かって引き上げ、頂点で骨盤を丸め上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve os joelhos em direção ao peito, enrolando a pelve para cima no topo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимите колени к груди, подкручивая таз вверх в верхней точке."
