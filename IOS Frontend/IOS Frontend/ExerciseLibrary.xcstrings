          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe sie zurück zur Schulter, beende den Satz und wechsle dann die Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuélvela al hombro, termina la serie y luego cambia de lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
