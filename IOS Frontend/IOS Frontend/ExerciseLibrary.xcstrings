          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle zunächst eine flache Bank vor einen unteren Kabelzug mit einem geraden Stangenaufsatz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comienza colocando un banco plano frente a una polea baja con un accesorio de barra recta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par placer un banc plat devant une poulie basse équipée d'une barre droite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीधे बार अटैचमेंट वाली लो पुली केबल के सामने एक फ़्लैट बेंच रखकर शुरू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず、ストレートバーのアタッチメントを付けたロープーリーケーブルの前にフラットベンチを置きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece colocando um banco reto à frente de uma polia baixa com uma barra reta acoplada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с того, что поставьте горизонтальную скамью перед нижним блоком с прямой рукоятью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先将一张平凳放在装有直杆握把的低位滑轮绳索前。"
          }
        }
      }
    },
    "Start out by placing two dumbbells on one side of a flat bench." : {
      "comment" : "A step of how to do the exercise “Reverse Wrist Curl Over Bench (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
