    "Sit toward the front of a sturdy chair with your feet flat and about hip-width apart." : {
      "comment" : "A step of how to do the exercise “Sit to Stand”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
