    "Skip by executing a step-hop pattern of right-right-step to left-left-step, and so on, alternating back and forth." : {
      "comment" : "A step of how to do the exercise “Fast Skipping”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفّذ القفز بنمط خطوة-نطة: يمين-يمين-خطوة إلى يسار-يسار-خطوة، وهكذا بالتبديل ذهابًا وإيابًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe das Skipping aus, indem du ein Schritt-Hopser-Muster rechts-rechts-Schritt, dann links-links-Schritt ausführst und so hin und her wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta alternando un patrón de paso y brinco: derecha-derecha-paso a izquierda-izquierda-paso, y así sucesivamente, alternando de un lado a otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sautillez en exécutant un enchaînement pas-saut : droite-droite-pas vers gauche-gauche-pas, et ainsi de suite, en alternant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दाएं-दाएं-कदम से बाएं-बाएं-कदम के स्टेप-हॉप पैटर्न में स्किप करें, और इसी तरह बारी-बारी से आगे-पीछे करते रहें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右・右・ステップから左・左・ステップへと、ステップとホップを組み合わせたパターンで、左右交互にスキップします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o skipping executando um padrão de passo e saltito: direito-direito-passo para esquerdo-esquerdo-passo, e assim por diante, alternando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняйте скиппинг в ритме шаг-подскок: правая-правая-шаг на левую, левая-левая-шаг и так далее, чередуя стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以右-右-步到左-左-步的步跳节奏做跨步跳，左右交替进行。"
          }
        }
      }
    },
