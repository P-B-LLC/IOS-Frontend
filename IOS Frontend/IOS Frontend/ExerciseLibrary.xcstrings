    "Pass the ball to your partner, and both of you can now twist in the opposite direction to repeat the procedure." : {
      "comment" : "A step of how to do the exercise “Partner Full Twist (Medicine Ball)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر الكرة إلى شريكك، وبعدها يمكنكما الالتفاف في الاتجاه المعاكس لتكرار العملية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den Ball an deinen Partner weiter, dann könnt ihr beide in die entgegengesetzte Richtung drehen und den Ablauf wiederholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el balón a tu compañero, y ahora ambos pueden girar en la dirección opuesta para repetir el procedimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez le ballon à votre partenaire, puis vous pouvez tous deux pivoter dans le sens opposé pour répéter la procédure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बॉल को अपने पार्टनर को पास करें, और अब आप दोनों प्रक्रिया दोहराने के लिए विपरीत दिशा में घूम सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーにボールを渡します。今度は2人とも反対方向にひねって、同じ手順を繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe a bola para seu parceiro e, agora, os dois podem girar na direção oposta para repetir o procedimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передайте мяч партнёру, и теперь вы оба можете скрутиться в обратную сторону, чтобы повторить процедуру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把球传给搭档，然后你们两人再朝相反方向扭转，重复这个过程。"
          }
        }
      }
    },
