    "Start out by curling your wrist upwards and exhaling." : {
      "comment" : "A step of how to do the exercise “Reverse Wrist Curl (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بثني معصميك للأعلى مع الزفير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne, indem du die Handgelenke nach oben curlst und dabei ausatmest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza flexionando las muñecas hacia arriba mientras exhalas."
          }
