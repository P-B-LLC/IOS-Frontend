        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双腿和髋部爆发发力，哑铃上升时让它贴近身体。"
          }
        }
      }
    },
    "Drive through your legs and hips to stand up with the bar, locking out your hips and knees together." : {
      "comment" : "A step of how to do the exercise “Block Pull (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع بساقيك ووركيك لتقف بالبار، مع قفل الوركين والركبتين معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich mit Beinen und Hüfte hoch und stehe mit der Stange auf, sodass Hüfte und Knie gemeinsam durchgestreckt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
