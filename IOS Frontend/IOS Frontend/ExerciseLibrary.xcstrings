        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दाईं करवट लेकर लेट जाएं, पैर एक के ऊपर एक रखें। ध्यान रखें कि घुटने थोड़े मुड़े हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず、脚を重ねて右側を下にして横になります。膝は少し曲げておきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
