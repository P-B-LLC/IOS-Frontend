        }
      }
    },
    "Set up as for a back squat with the bar across your upper back." : {
      "comment" : "A step of how to do the exercise “Pause Squat (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعد كما في سكوات الظهر مع وضع البار على أعلى ظهرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereite dich wie für eine Kniebeuge mit der Stange auf dem oberen Rücken vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate como para una sentadilla trasera, con la barra sobre la parte alta de la espalda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous comme pour un squat arrière, la barre posée sur le haut du dos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैक स्क्वॉट की तरह सेटअप करें, बार ऊपरी पीठ पर टिका हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーを上背部に担いで、バックスクワットと同じようにセットアップします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione-se como para um agachamento livre, com a barra apoiada na parte superior das costas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Займите положение, как для приседа со штангой на спине, гриф лежит на верхней части спины."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像后蹲一样准备，杠铃横放在上背部。"
          }
        }
      }
    },
    "Set up as for a deadlift with your shins close to the bar and your back flat." : {
      "comment" : "A step of how to do the exercise “Block Pull (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعد كما في الرفعة الميتة (ديدلفت) مع قرب مقدمة ساقيك من البار وظهرك مسطح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereite dich wie für ein Kreuzheben vor, die Schienbeine nah an der Stange und der Rücken flach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárate como para un peso muerto, con las espinillas cerca de la barra y la espalda plana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous comme pour un soulevé de terre, les tibias près de la barre et le dos plat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेडलिफ़्ट की तरह सेटअप करें, पिंडलियां बार के पास और पीठ सपाट रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すねをバーに近づけ、背中を平らにして、デッドリフトのようにセットアップします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione-se como para um levantamento terra, com as canelas perto da barra e as costas retas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примите положение, как для становой тяги: голени близко к грифу, спина ровная."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像硬拉那样准备，小腿靠近杠铃杆，背部平直。"
          }
        }
      }
    },
    "Set up as for a kettlebell swing, holding the handle with both hands." : {
      "comment" : "A step of how to do the exercise “American Kettlebell Swing”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعد كما في أرجحة الكيتل بيل، وأمسك المقبض بكلتا يديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereite dich wie für einen Kettlebell Swing vor und halte den Griff mit beiden Händen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárate como para un swing con pesa rusa, sujetando el asa con ambas manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous comme pour un swing au kettlebell, en tenant la poignée à deux mains."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केटलबेल स्विंग की तरह सेटअप करें, हैंडल को दोनों हाथों से पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケトルベルスイングの要領でセットアップし、ハンドルを両手で持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione-se como para um swing com kettlebell, segurando a alça com as duas mãos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примите положение, как для маха гирей, держа ручку обеими руками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像做壶铃摆荡一样准备，双手握住把手。"
          }
        }
      }
    },
    "Set up in a power rack with the bar on the pins. The pins should be set to the desired point; just below the knees, just above, or in the mid thigh position. Attach bands to the base of the rack, or secure them with dumbbells. Attach the other end to the bar. You may need to choke the bands to provide tension." : {
      "comment" : "A step of how to do the exercise “Rack Pull with Bands (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهّز نفسك في حامل القوة (باور راك) مع وضع البار على الدبابيس. يجب ضبط الدبابيس عند النقطة المطلوبة: أسفل الركبتين مباشرة، أو فوقهما مباشرة، أو عند منتصف الفخذ. ثبّت الأشرطة بقاعدة الحامل أو أمسكها بدمبلات. ثم ثبّت الطرف الآخر بالبار. قد تحتاج إلى لف الأشرطة على نفسها لتوفير الشد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell die Stange in einem Powerrack auf die Pins. Die Pins sollten auf die gewünschte Höhe gestellt sein: knapp unter den Knien, knapp darüber oder in der Mitte der Oberschenkel. Befestige Bänder am Fuß des Racks oder sichere sie mit Kurzhanteln. Befestige das andere Ende an der Stange. Eventuell musst du die Bänder verkürzen, damit Spannung entsteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárate en un rack de potencia con la barra sobre los pines. Los pines deben ajustarse al punto deseado: justo debajo de las rodillas, justo encima o a la altura de la mitad del muslo. Engancha las bandas a la base del rack o fíjalas con mancuernas. Engancha el otro extremo a la barra. Puede que necesites acortar las bandas para generar tensión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous dans un power rack avec la barre sur les taquets. Les taquets doivent être réglés à la hauteur voulue : juste sous les genoux, juste au-dessus, ou à mi-cuisse. Fixez des bandes élastiques à la base du rack, ou bloquez-les avec des haltères. Fixez l'autre extrémité à la barre. Vous devrez peut-être raccourcir les bandes en les nouant pour créer de la tension."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार को पिन्स पर रखकर पावर रैक में सेटअप करें। पिन्स को मनचाहे बिंदु पर सेट करें: घुटनों के ठीक नीचे, ठीक ऊपर, या जाँघ के बीच में। बैंड्स को रैक के आधार से जोड़ें या डम्बल से दबाकर सुरक्षित करें। दूसरे सिरे को बार से जोड़ें। तनाव पाने के लिए बैंड्स को कसकर लपेटना पड़ सकता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パワーラックの中で、バーをピンの上に置いてセットします。ピンは、膝のすぐ下、すぐ上、または太ももの中間など、目的の高さに設定します。バンドをラックの土台に取り付けるか、ダンベルで固定します。もう一方の端をバーに取り付けます。張力を出すために、バンドを短く持つ必要があるかもしれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare-se em um power rack com a barra nos pinos. Os pinos devem ser ajustados no ponto desejado: logo abaixo dos joelhos, logo acima ou na altura do meio da coxa. Prenda as faixas elásticas na base do rack ou fixe-as com halteres. Prenda a outra extremidade à barra. Talvez seja necessário encurtar as faixas para gerar tensão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подготовьтесь в силовой раме, поставив гриф на упоры. Упоры должны быть выставлены на нужной высоте: чуть ниже колен, чуть выше или на середине бедра. Прикрепите резинки к основанию рамы или зафиксируйте их гантелями. Другой конец прикрепите к грифу. Возможно, придётся перехватить резинки петлёй, чтобы создать натяжение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在力量架中设置，杠铃放在安全销上。安全销调到所需位置：膝盖下方、膝盖上方或大腿中部。将弹力带系在力量架底座上，或用哑铃压住固定，另一端挂在杠铃上。你可能需要缩短弹力带的有效长度以产生张力。"
          }
        }
      }
    },
    "Set up in a power rack with the bar on the pins. The pins should be set to the desired point; just below the knees, just above, or in the mid thigh position. Position yourself against the bar in proper deadlifting position." : {
      "comment" : "A step of how to do the exercise “Rack Pull (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهّز نفسك في حامل القوة (باور راك) مع وضع البار على الدبابيس. يجب ضبط الدبابيس عند النقطة المطلوبة: أسفل الركبتين مباشرة، أو فوقهما مباشرة، أو عند منتصف الفخذ. ضع نفسك مقابل البار في وضع الرفعة الميتة الصحيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell die Stange in einem Powerrack auf die Pins. Die Pins sollten auf die gewünschte Höhe gestellt sein: knapp unter den Knien, knapp darüber oder in der Mitte der Oberschenkel. Geh in der richtigen Kreuzheben-Position an die Stange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárate en un rack de potencia con la barra sobre los pines. Los pines deben ajustarse al punto deseado: justo debajo de las rodillas, justo encima o a la altura de la mitad del muslo. Colócate junto a la barra en la posición correcta de peso muerto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous dans un power rack avec la barre sur les taquets. Les taquets doivent être réglés à la hauteur voulue : juste sous les genoux, juste au-dessus, ou à mi-cuisse. Placez-vous contre la barre en bonne position de soulevé de terre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार को पिन्स पर रखकर पावर रैक में सेटअप करें। पिन्स को मनचाहे बिंदु पर सेट करें: घुटनों के ठीक नीचे, ठीक ऊपर, या जाँघ के बीच में। बार के पास सही डेडलिफ़्ट पोज़ीशन में खड़े हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パワーラックの中で、バーをピンの上に置いてセットします。ピンは、膝のすぐ下、すぐ上、または太ももの中間など、目的の高さに設定します。デッドリフトの正しい姿勢でバーに向かって構えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare-se em um power rack com a barra nos pinos. Os pinos devem ser ajustados no ponto desejado: logo abaixo dos joelhos, logo acima ou na altura do meio da coxa. Posicione-se junto à barra na posição correta de levantamento terra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подготовьтесь в силовой раме, поставив гриф на упоры. Упоры должны быть выставлены на нужной высоте: чуть ниже колен, чуть выше или на середине бедра. Займите правильное для становой тяги положение у грифа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在力量架中设置，杠铃放在安全销上。安全销调到所需位置：膝盖下方、膝盖上方或大腿中部。以正确的硬拉姿势站到杠铃前。"
          }
        }
      }
    },
    "Set up on the bench as for a normal bench press with your shoulder blades pulled back." : {
      "comment" : "A step of how to do the exercise “Paused Bench Press (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعد على المقعد كما في ضغط البنش المعتاد مع سحب لوحي كتفيك للخلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereite dich auf der Bank wie für normales Bankdrücken vor, die Schulterblätter sind zurückgezogen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate en el banco como para un press de banca normal, con las escápulas hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous sur le banc comme pour un développé couché normal, les omoplates rétractées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेंच पर सामान्य बेंच प्रेस की तरह सेटअप करें, शोल्डर ब्लेड पीछे खिंचे हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩甲骨を引き寄せ、通常のベンチプレスと同じようにベンチでセットアップします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione-se no banco como em um supino normal, com as escápulas puxadas para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примите положение на скамье, как для обычного жима лёжа, со сведёнными лопатками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像普通卧推一样在训练凳上准备，肩胛骨向后收紧。"
          }
        }
      }
    },
    "Set up on the bench as for a normal bench press." : {
      "comment" : "A step of how to do the exercise “Spoto Press (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهّز نفسك على المقعد كما في تمرين ضغط البنش العادي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte dich auf der Bank ein wie beim normalen Bankdrücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate en el banco como para un press de banca normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous sur le banc comme pour un développé couché classique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेंच पर वैसे ही सेटअप करें जैसे सामान्य बेंच प्रेस के लिए करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のベンチプレスと同じようにベンチにセットします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione-se no banco como para um supino normal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лягте на скамью так же, как для обычного жима лёжа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像普通卧推一样在凳上就位。"
          }
        }
      }
    },
    "Set up on the machine with your forearms or chest on the pad and one foot on the footplate." : {
      "comment" : "A step of how to do the exercise “Glute Kickback (Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجلس على الجهاز مع وضع ساعديك أو صدرك على الوسادة وإحدى قدميك على لوح القدمين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte dich am Gerät ein, die Unterarme oder die Brust auf dem Polster und ein Fuß auf der Fußplatte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate en la máquina con los antebrazos o el pecho sobre la almohadilla y un pie en la plataforma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous sur la machine, les avant-bras ou la poitrine sur le coussin et un pied sur le repose-pieds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मशीन पर इस तरह सेट हों कि अग्रबाजुएं या छाती पैड पर हों और एक पैर फ़ुटप्लेट पर हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンに前腕または胸をパッドにつけ、片足をフットプレートに乗せてセットします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione-se no aparelho com os antebraços ou o peito no apoio e um pé na plataforma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Займите место в тренажёре, положив предплечья или грудь на подушку и поставив одну ногу на платформу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在器械上就位，前臂或胸部靠在垫子上，一只脚踩在脚踏板上。"
          }
        }
      }
    },
    "Set up over the bar as for a clean, with a flat back and the bar over the middle of your feet." : {
      "comment" : "A step of how to do the exercise “Cluster (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعد فوق البار كما في الكلين، بظهر مسطح والبار فوق منتصف قدميك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positioniere dich wie beim Umsetzen über der Stange, mit flachem Rücken und der Stange über der Mitte deiner Füße."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate sobre la barra como para un clean, con la espalda plana y la barra sobre la mitad de los pies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous au-dessus de la barre comme pour un clean, le dos plat et la barre au-dessus du milieu de vos pieds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लीन की तरह बार के ऊपर सेटअप करें, पीठ सपाट और बार पैरों के बीच के ऊपर हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンと同様に、背中を平らにして、バーが足の中央の真上に来るようにバーの上でセットアップします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione-se sobre a barra como para um clean, com as costas retas e a barra sobre o meio dos pés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте над грифом, как для взятия на грудь: спина ровная, гриф над серединой стоп."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像做翻举一样站在杠铃杆上方，背部平直，杠铃杆位于脚掌中部上方。"
          }
        }
      }
    },
    "Set up the bands on the sleeves, secured to either band pegs, the rack, or dumbbells so that there is appropriate tension." : {
      "comment" : "A step of how to do the exercise “Squat with Bands (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت الأشرطة على أطراف البار، وثبّتها إما بمساند الأشرطة أو الحامل أو الدمبلات بحيث يكون الشد مناسبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befestige die Bänder an den Hantelenden und sichere sie entweder an Bandhaltern, am Rack oder an Kurzhanteln, sodass eine passende Spannung entsteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca las bandas en los extremos de la barra, aseguradas a los ganchos para bandas, al rack o a mancuernas, de modo que haya la tensión adecuada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez les bandes élastiques sur les manchons de la barre, fixées aux supports de bandes, au rack ou à des haltères, de façon à obtenir une tension appropriée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंड को स्लीव्स पर सेट करें, उन्हें बैंड पेग्स, रैक या डम्बल से सुरक्षित करें ताकि उचित तनाव मिले।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適切な張力がかかるように、バンドをスリーブに取り付け、バンドペグ、ラック、またはダンベルに固定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenda as faixas elásticas nas extremidades da barra, fixadas nos suportes de faixa, no rack ou em halteres, de modo a obter a tensão adequada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите резинки на втулках грифа, зафиксировав их за крепления для резинок, стойку или гантели так, чтобы было подходящее натяжение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将弹力带挂在杠铃杆两端，固定在弹力带挂钩、深蹲架或哑铃上，使张力合适。"
          }
        }
      }
    },
    "Shift across toward one hand, straightening the other arm, while staying at bar height." : {
      "comment" : "A step of how to do the exercise “Typewriter Pull Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل جانبيًا نحو إحدى اليدين، مع فرد الذراع الأخرى، مع البقاء عند ارتفاع البار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere dich zu einer Hand hin, strecke dabei den anderen Arm und bleibe auf Stangenhöhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate hacia una mano, estirando el otro brazo, manteniéndote a la altura de la barra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez-vous latéralement vers une main en tendant l'autre bras, en restant à la hauteur de la barre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार की ऊंचाई पर रहते हुए, एक हाथ की ओर खिसकें और दूसरी बाजू को सीधा करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーの高さを保ったまま、片方の手の方へ体を寄せ、もう一方の腕を伸ばします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloque-se em direção a uma das mãos, esticando o outro braço, mantendo-se na altura da barra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сместитесь в сторону одной руки, выпрямляя другую руку, оставаясь на высоте перекладины."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向一只手的方向横移，同时伸直另一只手臂，保持在杠的高度。"
          }
        }
      }
    },
    "Shift gears to keep the effort at the level your session calls for, and finish with a few easy minutes." : {
      "comment" : "A step of how to do the exercise “Cycling”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر السرعات للحفاظ على الجهد عند المستوى الذي تتطلبه حصتك، واختم ببضع دقائق سهلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte so, dass die Belastung dem Niveau entspricht, das deine Einheit verlangt, und beende die Einheit mit ein paar lockeren Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia de marcha para mantener el esfuerzo al nivel que pide tu sesión y termina con unos minutos suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de vitesse pour maintenir l'effort au niveau voulu par votre séance, et terminez par quelques minutes faciles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गियर बदलकर मेहनत को उस स्तर पर रखें जो आपका सेशन मांगता है, और अंत में कुछ मिनट आसान गति से चलाकर समाप्त करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションに必要な強度を保つようにギアを変え、最後の数分間は楽に漕いで終えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque as marchas para manter o esforço no nível que o seu treino pede e termine com alguns minutos fáceis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключайте передачи, чтобы поддерживать нагрузку на уровне, который требуется для вашей тренировки, и закончите несколькими минутами лёгкой езды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过换挡将强度保持在训练所要求的水平，最后再轻松骑行几分钟收尾。"
          }
        }
      }
    },
    "Shift your weight between your feet as you twist and crunch forward, pulling the cable downward." : {
      "comment" : "A step of how to do the exercise “Judo Flip (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل وزنك بين قدميك أثناء الالتفاف والانحناء للأمام، مع سحب الكابل للأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere dein Gewicht von einem Fuß auf den anderen, während du dich drehst und nach vorn crunchst und dabei das Kabel nach unten ziehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el peso de un pie a otro mientras giras y te contraes hacia delante, tirando de la polea hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transférez votre poids d'un pied à l'autre pendant que vous pivotez et vous enroulez vers l'avant, en tirant la poulie vers le bas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घुमाते और आगे क्रंच करते समय अपना वज़न दोनों पैरों के बीच शिफ़्ट करें, और केबल को नीचे की ओर खींचें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひねりながら前に体を丸め、左右の足に体重を移しつつ、ケーブルを下に引き下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfira o peso de um pé para o outro enquanto gira e flexiona o tronco para a frente, puxando o cabo para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносите вес с ноги на ногу, скручиваясь и сгибаясь вперёд, и тяните трос вниз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扭转并向前卷腹时，重心在两脚之间转移，将绳索向下拉。"
          }
        }
      }
    },
    "Shift your weight forward until you feel a stretch in your hip. Hold for 15 seconds, then repeat for your other side." : {
      "comment" : "A step of how to do the exercise “Kneeling Hip Flexor Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل وزنك للأمام حتى تشعر بإطالة في وركك. اثبت 15 ثانية، ثم كرر على الجهة الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere dein Gewicht nach vorn, bis du eine Dehnung in der Hüfte spürst. Halte 15 Sekunden und wiederhole dann auf der anderen Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el peso hacia delante hasta sentir un estiramiento en la cadera. Mantén 15 segundos y repite del otro lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez votre poids vers l'avant jusqu'à sentir un étirement dans la hanche. Maintenez 15 secondes, puis répétez de l'autre côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न आगे की ओर शिफ़्ट करें, जब तक कूल्हे में खिंचाव महसूस न हो। 15 सेकंड रुकें, फिर दूसरी तरफ़ दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "股関節に伸びを感じるまで体重を前に移します。15秒間キープし、反対側でも繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloque o peso para a frente até sentir um alongamento no quadril. Segure por 15 segundos e repita do outro lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносите вес вперёд, пока не почувствуете растяжение в тазобедренном суставе. Удерживайте 15 секунд, затем повторите на другую сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重心向前移，直到髋部有拉伸感。保持15秒，然后换另一侧重复。"
          }
        }
      }
    },
    "Shift your weight onto one foot and lift the other foot slightly off the floor." : {
      "comment" : "A step of how to do the exercise “Single Leg Balance”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل وزنك إلى قدم واحدة وارفع القدم الأخرى قليلًا عن الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere dein Gewicht auf einen Fuß und hebe den anderen Fuß leicht vom Boden ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada tu peso a un pie y levanta ligeramente el otro del suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transférez votre poids sur un pied et soulevez légèrement l'autre pied du sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना वज़न एक पैर पर डालें और दूसरे पैर को ज़मीन से थोड़ा ऊपर उठाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重を片足に移し、もう一方の足を床から少し浮かせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfira o peso para um pé e tire o outro levemente do chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесите вес на одну ногу и слегка оторвите другую ногу от пола."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将重心移到一只脚上，另一只脚稍微离地。"
          }
        }
      }
    },
    "Shift your weight onto one hand and take a small step forward with the other." : {
      "comment" : "A step of how to do the exercise “Handstand Walk”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل وزنك إلى إحدى اليدين وخذ خطوة صغيرة للأمام باليد الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere dein Gewicht auf eine Hand und mache mit der anderen einen kleinen Schritt nach vorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el peso a una mano y da un pequeño paso hacia delante con la otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportez votre poids sur une main et faites un petit pas vers l'avant avec l'autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना वज़न एक हाथ पर शिफ़्ट करें और दूसरे हाथ से आगे एक छोटा कदम रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重を片手に移し、もう一方の手を小さく前に踏み出します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfira o peso para uma das mãos e dê um pequeno passo à frente com a outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесите вес на одну руку и сделайте небольшой шаг вперёд другой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将重心转移到一只手上，另一只手向前迈一小步。"
          }
        }
      }
    },
    "Shift your weight to one side and squat deeply on that leg while the other leg straightens with its toes pointing up." : {
      "comment" : "A step of how to do the exercise “Cossack Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل وزنك إلى أحد الجانبين وانزل في سكوات عميق على تلك الساق بينما تستقيم الساق الأخرى وأصابع قدمها متجهة للأعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere dein Gewicht auf eine Seite und gehe auf diesem Bein tief in die Kniebeuge, während sich das andere Bein mit nach oben zeigenden Zehen streckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el peso hacia un lado y haz una sentadilla profunda sobre esa pierna mientras la otra pierna se estira con los dedos de los pies apuntando hacia arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportez votre poids sur un côté et descendez profondément en squat sur cette jambe tandis que l'autre jambe se tend, orteils pointant vers le haut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना वज़न एक तरफ डालें और उस पैर पर गहराई तक स्क्वॉट करें जबकि दूसरा पैर पंजे ऊपर की ओर करके सीधा हो जाए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重を片側に移し、その脚で深くしゃがみます。もう一方の脚はつま先を上に向けてまっすぐ伸ばします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfira o peso para um lado e agache profundamente sobre essa perna, enquanto a outra perna se estende com os dedos do pé apontando para cima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесите вес на одну сторону и глубоко присядьте на этой ноге, пока другая нога выпрямляется носком вверх."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将重心移向一侧，在这条腿上深蹲，同时另一条腿伸直，脚尖朝上。"
          }
        }
      }
    },
    "Shift your weight to the side of the crossed leg, rolling over the buttocks until you feel tension in your upper glute. You may assist the stretch by using one hand to pull the bent knee towards your chest. Hold this position for 10-30 seconds, and then switch sides." : {
      "comment" : "A step of how to do the exercise “Piriformis Foam Roll”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل وزنك إلى جهة الساق المتقاطعة، مع تمرير الأسطوانة على المؤخرة حتى تشعر بشد في أعلى عضلات الأرداف. يمكنك المساعدة في الإطالة باستخدام يد واحدة لسحب الركبة المثنية نحو صدرك. اثبت في هذا الوضع من 10 إلى 30 ثانية، ثم بدّل الجهة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere dein Gewicht auf die Seite des überkreuzten Beins und roll über das Gesäß, bis du eine Spannung im oberen Gesäßmuskel spürst. Du kannst die Dehnung unterstützen, indem du das gebeugte Knie mit einer Hand zur Brust ziehst. Halte diese Position 10-30 Sekunden und wechsle dann die Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el peso hacia el lado de la pierna cruzada, rodando sobre los glúteos hasta sentir tensión en la parte alta del glúteo. Puedes ayudar al estiramiento usando una mano para tirar de la rodilla flexionada hacia el pecho. Mantén esta posición de 10 a 30 segundos y luego cambia de lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportez votre poids sur le côté de la jambe croisée, en roulant sur les fessiers jusqu'à sentir une tension dans le haut du fessier. Vous pouvez faciliter l'étirement en tirant le genou fléchi vers la poitrine avec une main. Maintenez cette position 10 à 30 secondes, puis changez de côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न को क्रॉस किए हुए पैर की तरफ़ शिफ़्ट करें, नितंब पर रोल करें जब तक ऊपरी ग्लूट में तनाव महसूस न हो। स्ट्रेच में मदद के लिए आप एक हाथ से मुड़े हुए घुटने को छाती की ओर खींच सकते हैं। इस स्थिति में 10-30 सेकंड रुकें, फिर साइड बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交差させた脚の側に体重を移し、上部の臀筋に張りを感じるまで臀部の上を転がします。曲げた膝を片手で胸の方へ引き寄せて、ストレッチを補助してもかまいません。この姿勢を10〜30秒間キープし、反対側に替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloque o peso para o lado da perna cruzada, rolando sobre o bumbum até sentir tensão na parte superior do glúteo. Você pode ajudar o alongamento usando uma mão para puxar o joelho flexionado em direção ao peito. Segure essa posição por 10 a 30 segundos e depois troque de lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместите вес на сторону закинутой ноги, прокатываясь по ягодицам, пока не почувствуете напряжение в верхней части ягодицы. Можно усилить растяжение, подтягивая согнутое колено к груди одной рукой. Удерживайте это положение 10–30 секунд, затем смените сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将重心转移到交叉腿的一侧，在臀部上滚动，直到臀部上方感到紧张。可以用一只手将弯曲的膝盖拉向胸部来辅助拉伸。保持这个姿势10-30秒，然后换另一侧。"
          }
        }
      }
    },
    "Shifting as much weight onto the leg to be stretched as is tolerable, roll over the foam from above the knee to below the hip, holding points of tension for 10-30 seconds. Switch sides." : {
      "comment" : "A step of how to do the exercise “Quad Foam Roll”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل أكبر قدر ممكن من الوزن إلى الساق التي تريد إطالتها بقدر ما تتحمل، ثم تدحرج فوق الفوم من فوق الركبة إلى أسفل الورك، مع الثبات عند نقاط التوتر من 10 إلى 30 ثانية. بدّل الجانب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlagere so viel Gewicht wie erträglich auf das Bein, das gedehnt wird, und rolle über die Rolle von oberhalb des Knies bis unterhalb der Hüfte. Halte Punkte mit Spannung 10–30 Sekunden lang. Wechsle die Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasando tanto peso como puedas tolerar a la pierna que vas a estirar, rueda sobre el rodillo desde encima de la rodilla hasta debajo de la cadera, manteniendo los puntos de tensión de 10 a 30 segundos. Cambia de lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En transférant sur la jambe à étirer autant de poids que vous le tolérez, roulez sur le rouleau depuis le dessus du genou jusqu'au-dessous de la hanche, en maintenant les points de tension pendant 10 à 30 secondes. Changez de côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस पैर को स्ट्रेच करना है, उस पर जितना वज़न सहन हो सके उतना डालें और घुटने के ऊपर से कूल्हे के नीचे तक फ़ोम पर रोल करें। तनाव वाले बिंदुओं पर 10-30 सेकंड रुकें। फिर दूसरी तरफ़ बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無理のない範囲でできるだけストレッチする脚に体重を乗せ、膝の上から股関節の下まで、フォームローラーの上を転がします。張りのある部分では10~30秒間止まります。反対側も同様に行います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfira para a perna que será alongada o máximo de peso que for tolerável e role sobre o rolo de espuma, de cima do joelho até abaixo do quadril, mantendo os pontos de tensão por 10-30 segundos. Troque de lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесите на растягиваемую ногу столько веса, сколько можете перенести, и прокатывайтесь по ролику от места выше колена до места ниже бедра, задерживаясь на болезненных точках на 10–30 секунд. Смените сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在能承受的范围内尽量把重量转移到被拉伸的腿上，让泡沫轴从膝盖上方滚到髋部下方，在紧张的部位停留10至30秒。然后换另一侧。"
          }
        }
      }
    },
