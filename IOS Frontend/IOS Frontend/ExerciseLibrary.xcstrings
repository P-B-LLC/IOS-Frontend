          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Hüfte auf Höhe der Schultern und drücke dich weiter vom Boden weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén las caderas a la altura de los hombros y sigue empujando el suelo hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
