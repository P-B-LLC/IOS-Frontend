          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque-a sobre o assento da máquina de remada na polia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите её на сиденье тренажёра для горизонтальной тяги на блоке."
          }
        },
        "zh-Hans" : {
