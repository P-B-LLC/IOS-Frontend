        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローププーリーの前に、正面を向いて立ち、片脚をプーリーの近くに、もう一方を遠くに置きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
