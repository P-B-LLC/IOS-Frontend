        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手を交互に動かしながら、コントロールして降ります。ロープを滑り降りてはいけません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça mão sobre mão, com controle; nunca deslize pela corda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спускайтесь вниз, перехватывая руку под руку, подконтрольно; никогда не соскальзывайте по канату."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手交替有控制地向下爬；千万不要顺着绳子滑下来。"
          }
        }
