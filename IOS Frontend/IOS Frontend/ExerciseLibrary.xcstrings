    "Stand so your feet are shoulder width apart and your hands are on your hips." : {
      "comment" : "A step of how to do the exercise “Middle Back Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
