            "value" : "पैर जोड़कर सीधे खड़े हों और बॉडीबार या झाड़ू का डंडा पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚を揃えてまっすぐ立ち、ボディバーまたはほうきの柄を持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé, bem reto, com as pernas juntas, segurando uma bodybar ou um cabo de vassoura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте прямо, ноги вместе, держа бодибар или палку от метлы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站直，双腿并拢，手握体操棒或扫帚柄。"
          }
        }
      }
    },
    "Stand up straight." : {
