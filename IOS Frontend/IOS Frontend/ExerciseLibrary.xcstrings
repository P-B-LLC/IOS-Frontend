          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre pelos pés para voltar a ficar em pé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оттолкнитесь ногами, чтобы встать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双脚发力蹬地站起。"
          }
        }
      }
    },
    "Drive through your front foot to bring your back foot forward to standing. Alternate legs." : {
      "comment" : "A step of how to do the exercise “Reverse Lunge”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
