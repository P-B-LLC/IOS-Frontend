        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次屈髋返回，尽可能向前拉动滑车。"
          }
        }
      }
    },
    "Return it to the shoulder, finish the set, then switch sides." : {
      "comment" : "A step of how to do the exercise “Single Arm Thruster (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
