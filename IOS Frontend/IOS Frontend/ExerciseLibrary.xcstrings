          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरी तरफ से कदम रखकर या कूदकर नीचे उतरें, मुड़ें और दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反対側に降りるか跳び降りて、向きを変え、繰り返します。"
          }
