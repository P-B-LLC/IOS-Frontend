          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg dich auf eine flache Bank. Eine SZ-Stange oder gerade Stange liegt hinter deinem Kopf auf dem Boden, deine Füße stehen auf dem Boden."
          }
        },
        "es" : {
          "stringUnit" : {
