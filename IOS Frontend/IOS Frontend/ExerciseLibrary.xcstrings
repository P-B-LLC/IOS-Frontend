            "state" : "translated",
            "value" : "सामान्य स्किप से थोड़ा ऊंचा कूदें, पंजों के अगले हिस्से पर रहें और पैर लगभग सीधे रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のスキップよりわずかに高く跳び、足の指の付け根で着地して、脚はほぼまっすぐに保ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
