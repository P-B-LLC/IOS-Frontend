        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सैंडबैग के ऊपर पैर फैलाकर खड़े हों और बाजुओं को उसके चारों ओर लपेटकर पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンドバッグをまたいで立ち、腕を回して抱え込みます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique sobre um saco de areia, com uma perna de cada lado, e segure-o com os braços envolvendo-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте над сэндбэгом и обхватите его руками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跨站在沙袋上方，双臂环抱抓住沙袋。"
          }
        }
      }
    },
    "Straddle an exercise ball between both legs and lower your hips down toward the floor." : {
      "comment" : "A step of how to do the exercise “Ball Hug Stretch (Stability Ball)”.",
