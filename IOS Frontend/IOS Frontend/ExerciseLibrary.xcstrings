    "Then inhale and slowly lower yourself back down to the starting position." : {
      "comment" : "A step of how to do the exercise “Weighted Crunch (Medicine Ball)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
