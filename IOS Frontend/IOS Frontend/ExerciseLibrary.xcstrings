          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke langsam bis zur vollen Dehnung ab und wechsle nach deinem Satz den Arm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja lentamente hasta un estiramiento completo y cambia de brazo después de tu serie."
          }
        },
        "fr" : {
          "stringUnit" : {
