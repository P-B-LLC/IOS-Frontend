          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme dann ein und senke dich langsam zurück in die Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego inhala y baja lentamente hasta la posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
