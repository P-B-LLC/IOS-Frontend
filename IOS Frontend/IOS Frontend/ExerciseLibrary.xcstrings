    },
    "Rest for the recommended amount of time and repeat with your hands placed on the back side of your head." : {
      "comment" : "A step of how to do the exercise “Isometric Neck Hold - Front and Back”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتح للمدة الموصى بها وكرر مع وضع يديك على مؤخرة رأسك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhe dich für die empfohlene Zeit aus und wiederhole die Übung mit den Händen auf dem Hinterkopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa el tiempo recomendado y repite con las manos colocadas en la parte posterior de la cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposez-vous pendant le temps recommandé et répétez avec les mains placées à l'arrière de la tête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझाए गए समय तक आराम करें और हाथों को सिर के पिछले हिस्से पर रखकर दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定された時間休んでから、両手を頭の後ろ側に当てて繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descanse pelo tempo recomendado e repita com as mãos na parte de trás da cabeça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдохните рекомендуемое время и повторите, положив ладони на заднюю часть головы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息建议的时间，然后将双手放在头部后侧重复。"
          }
        }
      }
    },
