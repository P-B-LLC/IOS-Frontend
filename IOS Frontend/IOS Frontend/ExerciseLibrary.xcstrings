        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agache com os cotovelos totalmente estendidos até a barra tocar o chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присядьте с полностью разогнутыми локтями, пока гриф не коснётся пола."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肘部完全伸直，下蹲，直到杠碰到地面。"
          }
        }
      }
    },
    "Squat down, place your hands on the floor and jump or step your feet back into a plank." : {
      "comment" : "A step of how to do the exercise “Burpee”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل في وضع القرفصاء، وضع يديك على الأرض، ثم اقفز أو ادفع قدميك إلى الخلف خطوة للوصول إلى وضع البلانك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe in die Hocke, setze die Hände auf den Boden und springe oder steige mit den Füßen zurück in die Plank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agáchate, apoya las manos en el suelo y salta o lleva los pies hacia atrás hasta una plancha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accroupissez-vous, posez les mains au sol et sautez ou reculez les pieds en position de gainage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्वॉट में नीचे जाएं, हाथ फ़र्श पर रखें और पैरों को कूदकर या कदम रखकर पीछे प्लैंक में ले जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しゃがんで床に手をつき、ジャンプするか歩いて足を後ろに引き、プランクの姿勢になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agache, apoie as mãos no chão e salte ou leve os pés para trás até a posição de prancha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присядьте, поставьте руки на пол и прыжком или шагом отведите ноги назад в планку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下蹲，双手撑在地面上，双脚跳或迈步向后，进入平板支撑姿势。"
          }
        }
      }
    },
