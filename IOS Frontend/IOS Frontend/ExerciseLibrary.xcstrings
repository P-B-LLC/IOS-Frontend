          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich seitlich neben eine Plyobox, mit dem inneren Fuß oben auf der Box, nah an der Kante."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
