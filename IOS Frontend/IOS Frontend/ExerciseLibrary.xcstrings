            "value" : "पैरों को सीधा रखें और पीठ को दीवार पर टिकाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚はまっすぐに保ち、背中を壁にもたれさせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha as pernas retas e encoste as costas na parede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите ноги прямыми и обопритесь спиной о стену."
          }
        },
        "zh-Hans" : {
