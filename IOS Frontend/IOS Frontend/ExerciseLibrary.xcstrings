    "Mark two lines a set distance apart, such as 10 to 20 meters." : {
      "comment" : "A step of how to do the exercise “Shuttle Run”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد خطين على مسافة محددة من بعضهما، مثل 10 إلى 20 مترًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere zwei Linien in einem festgelegten Abstand, etwa 10 bis 20 Meter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca dos líneas a una distancia fija, por ejemplo de 10 a 20 metros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracez deux lignes à une distance fixe l'une de l'autre, par exemple 10 à 20 mètres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक तय दूरी पर दो रेखाएँ खींचें, जैसे 10 से 20 मीटर।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10~20mなど、決まった距離を空けて2本のラインを引きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque duas linhas a uma distância definida, como 10 a 20 metros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте две линии на заданном расстоянии друг от друга, например 10–20 метров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记两条相距固定距离的线，例如10至20米。"
          }
        }
      }
    },
