            "value" : "قف أو اجلس منتصبًا وذراعاك مسترخيتان إلى جانبيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh oder sitz aufrecht, die Arme entspannt an den Seiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie o siéntate erguido con los brazos relajados a los costados."
