        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले जैसा ही मूवमेंट दोहराएं, लेकिन इस बार दूसरी कोहनी को विपरीत घुटने की ओर ले जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先ほどと同じ動きを繰り返しますが、今度は反対の肘を反対側の膝に向けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
