    "Kneel below a high pulley that contains a rope attachment." : {
      "comment" : "A step of how to do the exercise “Crunch (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع أسفل بكرة علوية مثبّت بها ملحق الحبل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich unter einen hohen Kabelzug mit Seilgriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate debajo de una polea alta con un accesorio de cuerda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-vous à genoux sous une poulie haute équipée d'une corde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रस्सी वाले अटैचमेंट के साथ ऊंची पुली के नीचे घुटनों के बल बैठें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロープアタッチメントを付けたハイプーリーの下にひざまずきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se embaixo de uma polia alta com uma corda acoplada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени под верхним блоком с канатной рукоятью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪在装有绳子把手的高位滑轮下方。"
          }
        }
      }
    },
    "Kneel down on both of your knees so that your body is facing the flat bench." : {
      "comment" : "A step of how to do the exercise “Reverse Wrist Curl Over Bench (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجثُ على ركبتيك معًا بحيث يكون جسمك مواجهًا للمقعد المسطح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich auf beide Knie, sodass dein Körper zur flachen Bank zeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate sobre ambas rodillas de modo que tu cuerpo quede de frente al banco plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-vous à genoux de façon à faire face au banc plat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों घुटनों के बल बैठ जाएं ताकि आपका शरीर फ़्लैट बेंच की ओर हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フラットベンチに体を向けて、両膝をついてひざまずきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se com os dois joelhos de modo que o corpo fique voltado para o banco reto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на оба колена лицом к горизонтальной скамье."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双膝跪地，身体面向平凳。"
          }
        }
      }
    },
    "Kneel in front of the cable tower, taking the cable with one hand with your arm extended. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Kneeling Single Arm High Pulley Row (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع أمام برج الكابل وأمسك الكابل بيد واحدة مع مدّ ذراعك. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich vor den Kabelturm und nimm das Kabel mit einer Hand, der Arm ist gestreckt. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate frente a la torre de poleas, tomando el cable con una mano y el brazo extendido. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenouillez-vous face à la tour de poulie et saisissez le câble d'une main, le bras tendu. Voici votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केबल टावर के सामने घुटनों के बल बैठें, एक हाथ से केबल पकड़ें और बाजू को सीधा रखें। यही आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケーブルタワーの前で膝をつき、片手でケーブルを持って腕を伸ばします。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se de frente para a torre de polias, segurando o cabo com uma das mãos e o braço estendido. Esta será sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени перед блочной стойкой, взяв трос одной рукой с вытянутой рукой. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪在绳索架前，单手握住把手，手臂伸直。这就是起始姿势。"
          }
        }
      }
    },
    "Kneel on a mat and bring your right knee up so the bottom of your foot is on the floor and extend your left leg out behind you so the top of your foot is on the floor." : {
      "comment" : "A step of how to do the exercise “Kneeling Hip Flexor Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع على حصيرة وارفع ركبتك اليمنى بحيث تكون باطن قدمك على الأرض، ومدّ ساقك اليسرى خلفك بحيث يكون ظهر قدمك على الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich auf eine Matte, stell das rechte Knie auf, sodass die Fußsohle auf dem Boden steht, und streck das linke Bein hinter dir aus, sodass der Fußrücken auf dem Boden liegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate sobre una colchoneta y sube la rodilla derecha de modo que la planta del pie quede apoyada en el suelo, y extiende la pierna izquierda hacia atrás con el empeine apoyado en el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenouillez-vous sur un tapis et avancez le genou droit de sorte que la plante du pied soit au sol, puis tendez la jambe gauche derrière vous, le dessus du pied au sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैट पर घुटनों के बल बैठें और दायां घुटना ऊपर उठाएं ताकि दाएं पैर का तलवा फ़र्श पर हो, और बायां पैर पीछे फैलाएं ताकि उसका ऊपरी हिस्सा फ़र्श पर हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マットの上で膝立ちになり、右膝を立てて足裏を床につけ、左脚を後ろに伸ばして足の甲を床につけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se em um tapete e traga o joelho direito para cima, de modo que a sola do pé fique apoiada no chão, e estenda a perna esquerda para trás, com o peito do pé apoiado no chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени на мате, поставьте правую ногу вперёд так, чтобы подошва стояла на полу, а левую ногу вытяните назад так, чтобы на полу лежал подъём стопы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪在垫子上，右膝抬起，右脚掌踩在地面上，左腿向后伸直，脚背贴地。"
          }
        }
      }
    },
    "Kneel on a mat and place your hands on the floor slightly wider than your shoulders." : {
      "comment" : "A step of how to do the exercise “Knee Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع على حصيرة وضع يديك على الأرض أوسع قليلًا من كتفيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich auf eine Matte und setz die Hände etwas breiter als schulterbreit auf den Boden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate sobre una colchoneta y coloca las manos en el suelo algo más separadas que los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenouillez-vous sur un tapis et posez les mains au sol, un peu plus écartées que les épaules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैट पर घुटनों के बल बैठें और हाथों को कंधों से थोड़ा चौड़ा करके फ़र्श पर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マットの上で膝立ちになり、手を肩幅よりやや広くして床につきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se em um tapete e apoie as mãos no chão, um pouco mais afastadas que os ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени на мате и поставьте руки на пол чуть шире плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪在垫子上，双手撑在地面上，略宽于肩。"
          }
        }
      }
    },
    "Kneel on the floor or an exercise mat and bend at the waist with your arms extended in front of you (perpendicular to the torso) in order to get into a kneeling push-up position but with the arms spaced at shoulder width. Your head should be looking forward and the bend of the knees should create a 90-degree angle between the hamstrings and the calves. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Glute Kickback”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع على الأرض أو على حصيرة تمارين وانحنِ من الخصر وذراعاك ممدودتان أمامك (عموديتان على الجذع) لتتخذ وضع الضغط على الركبتين لكن مع تباعد الذراعين بعرض الكتفين. يجب أن تنظر برأسك للأمام وأن يشكل انثناء الركبتين زاوية 90 درجة بين العضلات الخلفية للفخذ والسمانتين. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich auf den Boden oder eine Trainingsmatte und beuge dich in der Taille nach vorn, die Arme vor dir ausgestreckt (senkrecht zum Oberkörper), um in eine Liegestützposition auf den Knien zu kommen, aber mit schulterbreit gesetzten Armen. Dein Blick geht nach vorn, und die Beugung der Knie sollte einen 90-Grad-Winkel zwischen Oberschenkelrückseite und Waden bilden. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate en el suelo o en una colchoneta e inclínate por la cintura con los brazos extendidos frente a ti (perpendiculares al torso) para adoptar una posición de flexión con rodillas apoyadas, pero con los brazos separados al ancho de los hombros. La cabeza debe mirar al frente y la flexión de las rodillas debe formar un ángulo de 90 grados entre los isquiotibiales y las pantorrillas. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-vous à genoux sur le sol ou sur un tapis d'exercice et penchez-vous à la taille, les bras tendus devant vous (perpendiculaires au buste), pour prendre une position de pompe à genoux, mais avec les bras écartés à la largeur des épaules. Votre tête regarde vers l'avant et la flexion des genoux doit former un angle de 90 degrés entre les ischio-jambiers et les mollets. Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़र्श या एक्सरसाइज़ मैट पर घुटनों के बल बैठें और कमर से झुकें, बाजुएं अपने सामने फैली हों (धड़ के लंबवत), ताकि आप घुटनों के बल पुश-अप की स्थिति में आ जाएं, लेकिन बाजुएं कंधों की चौड़ाई पर हों। आपका सिर सामने देख रहा हो और घुटनों का मोड़ हैमस्ट्रिंग्स और पिंडलियों के बीच 90 डिग्री का कोण बनाए। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "床またはエクササイズマットに膝をつき、腰から曲げて、腕を体の前(上体に対して垂直)に伸ばし、腕を肩幅に開いた膝つきプッシュアップの姿勢になります。頭は前を向き、膝を曲げてハムストリングスとふくらはぎの間の角度を90度にします。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se no chão ou em um colchonete e incline-se na cintura com os braços estendidos à sua frente (perpendiculares ao tronco) para assumir uma posição de flexão com os joelhos apoiados, mas com os braços afastados na largura dos ombros. A cabeça deve olhar para a frente e a flexão dos joelhos deve formar um ângulo de 90 graus entre os posteriores de coxa e as panturrilhas. Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени на пол или гимнастический коврик и наклонитесь в пояснице, вытянув руки перед собой (перпендикулярно корпусу), чтобы принять положение для отжиманий с колен, но с руками на ширине плеч. Голова смотрит вперёд, а сгиб колен образует угол 90 градусов между бицепсами бедра и икрами. Это будет ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪在地面或训练垫上，腰部前屈，双臂向前伸出（与躯干垂直），进入跪姿俯卧撑姿势，但手臂间距与肩同宽。头部看向前方，膝盖弯曲，使大腿后侧与小腿之间成90度角。这就是起始姿势。"
          }
        }
      }
    },
    "Kneel on the floor, holding your heels with both hands." : {
      "comment" : "A step of how to do the exercise “Camel Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع على الأرض وأنت تمسك كعبيك بكلتا يديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich auf den Boden und halte deine Fersen mit beiden Händen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate en el suelo, sujetando los talones con ambas manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-vous à genoux sur le sol, en tenant vos talons à deux mains."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़र्श पर घुटनों के बल बैठें और दोनों हाथों से अपनी एड़ियों को पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "床にひざまずき、両手でかかとを持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se no chão, segurando os calcanhares com as duas mãos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени на пол, держась обеими руками за пятки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪在地上，双手抓住脚跟。"
          }
        }
      }
    },
    "Kneel or stand on the platform and grip the handles above you." : {
      "comment" : "A step of how to do the exercise “Assisted Pull Up (Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع أو قف على المنصة وأمسك المقبضين فوقك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie oder stehe auf der Plattform und greife die Griffe über dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate o ponte de pie en la plataforma y agarra las asas por encima de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-vous à genoux ou debout sur la plateforme et saisissez les poignées au-dessus de vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेटफ़ॉर्म पर घुटनों के बल बैठें या खड़े हों और अपने ऊपर लगे हैंडल को पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラットフォームにひざまずくか立ち、頭上のハンドルを握ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se ou fique em pé na plataforma e segure as alças acima de você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени или на ноги на платформу и возьмитесь за рукояти над собой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪在或站在踏板上，握住头顶上方的把手。"
          }
        }
      }
    },
    "Kneel with your back to a wall or couch and slide one shin up against it so your foot points to the ceiling." : {
      "comment" : "A step of how to do the exercise “Couch Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اركع وظهرك إلى جدار أو أريكة وانزلق بمقدمة إحدى ساقيك على الجدار بحيث تشير قدمك نحو السقف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich mit dem Rücken zu einer Wand oder einem Sofa und schiebe ein Schienbein daran nach oben, sodass dein Fuß zur Decke zeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate de espaldas a una pared o un sofá y desliza una espinilla hacia arriba contra él, de modo que el pie apunte al techo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-vous à genoux, dos à un mur ou à un canapé, et glissez un tibia contre celui-ci de façon que votre pied pointe vers le plafond."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दीवार या सोफ़े की ओर पीठ करके घुटनों के बल बैठें और एक पिंडली को उससे सटाकर ऊपर सरकाएं ताकि आपका पंजा छत की ओर रहे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁またはソファに背を向けてひざまずき、片方のすねを壁に沿って上げて、足先を天井に向けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se de costas para uma parede ou sofá e deslize uma canela para cima contra ele, de modo que o pé aponte para o teto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте на колени спиной к стене или дивану и прижмите одну голень к ней, чтобы стопа смотрела в потолок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪下，背对墙壁或沙发，将一侧小腿贴着它向上滑，使脚尖指向天花板。"
          }
        }
      }
    },
