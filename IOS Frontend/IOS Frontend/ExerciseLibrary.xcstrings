        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाथ के नीचे हाथ रखते हुए नियंत्रण के साथ नीचे उतरें; रस्सी पर कभी फिसलकर न उतरें।"
