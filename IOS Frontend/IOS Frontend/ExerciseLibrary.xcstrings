    "Stand tall next to a wall or chair for balance." : {
      "comment" : "A step of how to do the exercise “Standing Quad Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف منتصبًا بجانب جدار أو كرسي للتوازن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
