          }
        }
      }
    },
    "Return your arm back to the starting position by pulling your hand back to the midline of the body." : {
      "comment" : "A step of how to do the exercise “Single Arm Cable Crossover”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد ذراعك إلى وضع البداية بسحب يدك إلى خط منتصف الجسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring den Arm zurück in die Ausgangsposition, indem du die Hand wieder zur Körpermitte führst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el brazo a la posición inicial llevando la mano de vuelta a la línea media del cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramenez le bras à la position de départ en tirant la main vers la ligne médiane du corps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाथ को शरीर की मध्य रेखा तक वापस खींचकर बाजू को शुरुआती स्थिति में लौटाएं।"
          }
        },
        "ja" : {
