    "Stand to the side of a cone or hurdle. To get into the start position, stand on one leg with your knee slightly bent." : {
      "comment" : "A step of how to do the exercise “Single Leg Lateral Hop”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف إلى جانب مخروط أو حاجز. للوصول إلى وضع البداية، قف على ساق واحدة مع ثني الركبة قليلًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich seitlich neben einen Kegel oder eine Hürde. Um die Ausgangsposition einzunehmen, stehe auf einem Bein mit leicht gebeugtem Knie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate a un lado de un cono o una valla. Para adoptar la posición inicial, párate sobre una pierna con la rodilla ligeramente flexionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez-vous sur le côté d'un plot ou d'une haie. Pour vous mettre en position de départ, tenez-vous sur une jambe, le genou légèrement fléchi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोन या हर्डल के बगल में खड़े हों। शुरुआती स्थिति में आने के लिए एक पैर पर खड़े हों और घुटना थोड़ा मुड़ा रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーンまたはハードルの横に立ちます。開始姿勢をとるには、膝を軽く曲げて片脚で立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé ao lado de um cone ou barreira. Para assumir a posição inicial, apoie-se em uma perna com o joelho levemente flexionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте сбоку от конуса или барьера. Чтобы принять исходное положение, встаньте на одну ногу, слегка согнув колено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在标志桶或栏架的侧面。进入起始姿势：单腿站立，膝盖微屈。"
          }
        }
      }
    },
    "Stand under a pull-up bar that you can reach with a small jump." : {
      "comment" : "A step of how to do the exercise “Burpee Pull Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف تحت عقلة يمكنك الوصول إليها بقفزة صغيرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
