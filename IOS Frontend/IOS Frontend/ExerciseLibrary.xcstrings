    "Hold a barbell in the front rack position, resting on your shoulders with your elbows high and hands just outside shoulder width." : {
      "comment" : "A step of how to do the exercise “Thruster (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك بارًا في وضع الفرونت راك، مستقرًا على كتفيك ومرفقاك عاليان ويداك خارج عرض الكتفين مباشرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Langhantel in der Frontposition, auf den Schultern aufliegend, die Ellbogen hoch und die Hände knapp außerhalb der Schulterbreite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén una barra en la posición de rack frontal, apoyada sobre los hombros con los codos altos y las manos justo por fuera del ancho de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez une barre en position de rack avant, posée sur vos épaules, les coudes hauts et les mains juste à l'extérieur de la largeur des épaules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारबेल को फ़्रंट रैक पोज़िशन में पकड़ें, वह आपके कंधों पर टिका हो, कोहनियां ऊपर और हाथ कंधों की चौड़ाई से थोड़ा बाहर हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーベルをフロントラックポジションで持ちます。肩に載せ、肘を高く上げ、手は肩幅のすぐ外側に置きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma barra na posição de front rack, apoiada nos ombros, com os cotovelos altos e as mãos logo por fora da largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте штангу в положении на груди, она лежит на плечах, локти высоко, кисти чуть шире плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前架位姿势持杠铃，杠铃搁在肩上，肘部抬高，双手略宽于肩。"
          }
        }
      }
    },
    "Hold a barbell with an overhand grip (palms down) that is a little closer together than shoulder width." : {
      "comment" : "A step of how to do the exercise “Incline Triceps Extension (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك بار أثقال بقبضة علوية (راحتاك للأسفل) أضيق قليلًا من عرض الكتفين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Langhantel im Obergriff (Handflächen nach unten) mit etwas engerer Griffbreite als schulterbreit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén una barra con agarre prono (palmas hacia abajo), un poco más cerrado que el ancho de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez une barre en pronation (paumes vers le bas), les mains un peu plus rapprochées que la largeur des épaules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारबेल को ओवरहैंड ग्रिप (हथेलियां नीचे) से पकड़ें, जो कंधों की चौड़ाई से थोड़ी संकरी हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩幅よりやや狭い順手(手のひらを下に向ける)でバーベルを握ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma barra com pegada pronada (palmas para baixo), com as mãos um pouco mais próximas que a largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите штангу хватом сверху (ладони вниз) чуть уже плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用正握（掌心向下）握住杠铃，握距比肩略窄。"
          }
        }
      }
    },
    "Hold a barbell with both hands and your palms facing down; hands spaced about shoulder width." : {
      "comment" : "A step of how to do the exercise “Reverse Wrist Curl (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك بار أثقال بكلتا يديك وراحتاك متجهتان للأسفل؛ ويداك متباعدتان بعرض الكتفين تقريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Langhantel mit beiden Händen, die Handflächen zeigen nach unten; die Hände sind etwa schulterbreit auseinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén una barra con ambas manos y las palmas hacia abajo; manos separadas aproximadamente al ancho de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez une barre à deux mains, paumes vers le bas, les mains écartées d'environ la largeur des épaules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारबेल को दोनों हाथों से हथेलियाँ नीचे की ओर करके पकड़ें; हाथों के बीच लगभग कंधों की चौड़ाई की दूरी रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手のひらを下に向け、手を肩幅程度に開いて、両手でバーベルを持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma barra com as duas mãos e as palmas voltadas para baixo; mãos afastadas na largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите штангу обеими руками, ладони вниз; кисти на расстоянии около ширины плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手握住杠铃，掌心朝下，握距约与肩同宽。"
          }
        }
      }
    },
    "Hold a barbell with both hands and your palms facing down; hands spaced about shoulder width. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Wrist Rotation (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك بارًا بكلتا يديك والراحتان للأسفل؛ واليدان متباعدتان بعرض الكتفين تقريبًا. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Langhantel mit beiden Händen, die Handflächen zeigen nach unten, die Hände etwa schulterbreit auseinander. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén una barra con ambas manos y las palmas hacia abajo, con las manos separadas aproximadamente al ancho de los hombros. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez une barre à deux mains, paumes vers le bas, les mains écartées d'environ la largeur des épaules. Ceci sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों हाथों से बारबेल को हथेलियां नीचे की ओर रखकर पकड़ें; हाथ लगभग कंधों की चौड़ाई पर हों। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両手のひらを下に向けて、バーベルを両手で持ちます。手幅は肩幅程度です。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma barra com as duas mãos e as palmas voltadas para baixo, com as mãos afastadas aproximadamente na largura dos ombros. Esta será sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите штангу обеими руками ладонями вниз; руки расставлены примерно на ширину плеч. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手握住杠铃，掌心向下，双手间距约与肩同宽。这就是起始姿势。"
          }
        }
      }
    },
    "Hold a barbell with both hands and your palms facing up; hands spaced about shoulder width." : {
      "comment" : "A step of how to do the exercise “Finger Curl (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك بار أثقال بكلتا يديك وراحتاك متجهتان للأعلى؛ ويداك متباعدتان بعرض الكتفين تقريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Langhantel mit beiden Händen, die Handflächen zeigen nach oben, die Hände etwa schulterbreit auseinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén una barra con ambas manos y las palmas hacia arriba; las manos separadas aproximadamente al ancho de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez une barre à deux mains, paumes vers le haut, les mains espacées d'environ la largeur des épaules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों हाथों से बारबेल पकड़ें, हथेलियां ऊपर की ओर हों; हाथ लगभग कंधों की चौड़ाई पर हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両手で手のひらを上に向けてバーベルを持ち、手は肩幅程度に開きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma barra com as duas mãos e as palmas voltadas para cima, com as mãos afastadas aproximadamente na largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите штангу обеими руками обратным хватом (ладони вверх), руки примерно на ширине плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手握住杠铃，掌心向上，握距约与肩同宽。"
          }
        }
      }
    },
    "Hold a barbell with both hands, palms up and a few inches apart." : {
      "comment" : "A step of how to do the exercise “Bicep Curl - Close Grip (Barbell)”.",
