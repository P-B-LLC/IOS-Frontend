    "Return by again flexing the hip, pulling the carriage forward as far as you can." : {
      "comment" : "A step of how to do the exercise “Reverse Hyperextension (Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد بثني الورك مرة أخرى، وسحب العربة للأمام قدر ما تستطيع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh zurück, indem du die Hüfte wieder beugst und den Schlitten so weit wie möglich nach vorn ziehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve flexionando de nuevo la cadera, llevando el carro hacia delante tanto como puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez en fléchissant de nouveau la hanche, en ramenant le chariot vers l'avant aussi loin que possible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों को फिर से मोड़कर, कैरिज को जितना हो सके आगे खींचते हुए वापस लौटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再び股関節を曲げ、キャリッジをできるだけ前に引いて戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte flexionando o quadril novamente, puxando o carrinho para a frente o máximo que puder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь, снова сгибая бедро и подтягивая каретку вперёд как можно дальше."
