    "Hold a light band or dowel in front of your hips with a wide overhand grip." : {
      "comment" : "A step of how to do the exercise “Shoulder Pass Through (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك شريطًا خفيفًا أو عصا أمام وركيك بقبضة علوية واسعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein leichtes Band oder einen Stab im weiten Obergriff vor der Hüfte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén una banda ligera o un palo frente a las caderas con un agarre prono ancho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez une bande élastique légère ou un bâton devant les hanches en pronation, avec une prise large."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल्का बैंड या डंडा कूल्हों के सामने चौड़ी ओवरहैंड ग्रिप से पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽いバンドまたは棒を、広めの順手グリップで腰の前に持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma faixa elástica leve ou um bastão à frente do quadril com pegada pronada e aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите лёгкую резинку или палку перед бёдрами широким хватом сверху."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
