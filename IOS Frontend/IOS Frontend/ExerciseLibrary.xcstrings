    "Return the weight to the ground by bending at the hips and controlling the weight on the way down." : {
      "comment" : "A step of how to do the exercise “Reverse Band Sumo Deadlift (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد الوزن إلى الأرض بالانحناء من الوركين مع التحكم بالوزن أثناء النزول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring das Gewicht zurück zum Boden, indem du dich aus der Hüfte beugst und das Gewicht auf dem Weg nach unten kontrollierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el peso al suelo flexionando las caderas y controlando el peso durante el descenso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposez le poids au sol en vous penchant au niveau des hanches et en contrôlant la charge pendant la descente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों से झुकते हुए और नीचे आते समय वज़न को नियंत्रित करते हुए उसे वापस ज़मीन पर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "股関節を曲げ、下ろす間もウエイトをコントロールしながら、ウエイトを床に戻します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolva o peso ao chão flexionando o quadril e controlando o peso na descida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верните вес на пол, наклоняясь в бёдрах и контролируя вес при опускании."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过髋部折叠将重量放回地面，下放时控制好重量。"
          }
        }
      }
    },
