    "Climb down hand under hand under control; never slide down the rope." : {
      "comment" : "A step of how to do the exercise “Legless Rope Climb”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل متسلقًا يدًا تحت يد بتحكم؛ ولا تنزلق على الحبل أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klettere kontrolliert Hand unter Hand wieder hinunter. Rutsche niemals am Seil hinab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja mano sobre mano con control; nunca te deslices por la cuerda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescendez main sous main de façon contrôlée ; ne vous laissez jamais glisser le long de la corde."
