        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屈肘放下链条，让一部分链条落到地面上。"
          }
        }
      }
    },
    "Lower the cleaned kettlebell to a hanging position and clean the alternate kettlebell. Repeat." : {
      "comment" : "A step of how to do the exercise “Alternating Hang Clean (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل الكيتل بيل المرفوع إلى وضع التدلي وارفع الكيتل بيل الآخر إلى كتفك. كرر الحركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die umgesetzte Kettlebell in die hängende Position ab und setze die andere Kettlebell um. Wiederhole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
