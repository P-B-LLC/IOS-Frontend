    "Continue as far as you are able, pause, and then return to the starting position." : {
      "comment" : "A step of how to do the exercise “External Rotation (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واصل بقدر ما تستطيع، ثم توقف وعد إلى وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe so weit, wie du kannst, halte kurz inne und kehre dann in die Ausgangsposition zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa hasta donde puedas, haz una pausa y vuelve a la posición inicial."
