    },
    "Relax your shoulders and let your body lengthen while breathing steadily." : {
      "comment" : "A step of how to do the exercise “Dead Hang”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرخِ كتفيك ودع جسمك يتمدد مع التنفس بانتظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspanne die Schultern und lass deinen Körper sich in die Länge ziehen, während du gleichmäßig atmest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaja los hombros y deja que el cuerpo se alargue mientras respiras de forma constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relâchez les épaules et laissez votre corps s'allonger en respirant calmement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंधों को ढीला करें और स्थिर सांस लेते हुए शरीर को लंबा होने दें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩の力を抜き、一定のペースで呼吸しながら体を伸ばします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxe os ombros e deixe o corpo se alongar enquanto respira de forma constante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расслабьте плечи и позвольте телу вытянуться, дыша ровно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放松肩膀，让身体向下伸长，同时保持平稳呼吸。"
          }
        }
      }
    },
    "Release back to neutral and repeat." : {
      "comment" : "A step of how to do the exercise “Chin Tuck”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
