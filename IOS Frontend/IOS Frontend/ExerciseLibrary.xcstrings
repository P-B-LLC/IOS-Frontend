        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez-vous à une barre de traction et levez les jambes tendues jusqu'à ce que vos pieds soient près de la barre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुल-अप बार से लटकें और सीधे पैरों को तब उठाएं जब तक पंजे बार के पास न पहुंच जाएं।"
          }
