          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने पैरों को डिक्लाइन बेंच के सिरे पर सुरक्षित करें और धीरे-धीरे बेंच पर लेट जाएं।"
