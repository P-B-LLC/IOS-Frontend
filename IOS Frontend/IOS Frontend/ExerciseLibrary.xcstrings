    "Stand with your feet slightly wider than shoulder width apart and toes pointing out slightly." : {
      "comment" : "A step of how to do the exercise “Power Clean (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
