          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Gewichte oben und kehre in den Stand zurück, indem du die Füße zusammenführst. Senke die Gewichte ab, um die nächste Wiederholung auszuführen."
