          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte im Stehen zwei Kurzhanteln seitlich am Körper. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
