    "Pause at the top, returning the leg to the starting position as your partner provides resistance going the other direction." : {
      "comment" : "A step of how to do the exercise “Partner Leg Curl”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثبت في الأعلى، ثم أعد ساقك إلى وضع البداية بينما يوفر شريكك المقاومة في الاتجاه المعاكس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
