    "After a brief pause, return to the starting position and repeat on the other side, continuing in an alternating fashion." : {
      "comment" : "A step of how to do the exercise “Crossover Reverse Lunge”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد توقف قصير، عد إلى وضع البداية وكرر على الجانب الآخر، وواصل التبديل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre nach einer kurzen Pause in die Ausgangsposition zurück und wiederhole die Übung auf der anderen Seite. Wechsle weiter ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una breve pausa, vuelve a la posición inicial y repite hacia el otro lado, continuando de forma alternada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une brève pause, revenez à la position de départ et répétez de l'autre côté, en continuant en alternance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ा रुकने के बाद शुरुआती स्थिति में लौटें और दूसरी ओर दोहराएं, इसी तरह बारी-बारी से जारी रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し静止してから開始姿勢に戻り、反対側でも同様に行い、左右交互に続けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após uma breve pausa, volte à posição inicial e repita para o outro lado, continuando de forma alternada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После короткой паузы вернитесь в исходное положение и повторите на другую сторону, продолжая чередовать стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍作停顿后，回到起始姿势，换另一侧重复，如此交替进行。"
          }
        }
      }
    },
    "After a brief pause, return to the starting position." : {
      "comment" : "A step of how to do the exercise “Assisted Pull Up (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
