            "value" : "ادفع عبر قدميك لتقف مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich über die Füße ab, um wieder aufzustehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja con los pies para volver a ponerte de pie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez dans vos pieds pour vous relever."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस खड़े होने के लिए पैरों से ज़ोर लगाएं।"
