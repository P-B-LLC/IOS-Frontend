    "Tighten the muscle on the front of your thigh to press the back of your knee down toward the floor." : {
      "comment" : "A step of how to do the exercise “Quad Set”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شدّ العضلة في مقدمة الفخذ لدفع الجزء الخلفي من الركبة نحو الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spann die Muskulatur an der Oberschenkelvorderseite an, um die Kniekehle in Richtung Boden zu drücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrae el músculo de la parte delantera del muslo para presionar la parte posterior de la rodilla hacia el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contractez le muscle de l'avant de la cuisse pour appuyer l'arrière du genou vers le sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाँघ के अगले हिस्से की मांसपेशी को कसें ताकि घुटने का पिछला हिस्सा फ़र्श की ओर दबे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太ももの前側の筋肉に力を入れ、膝の裏を床に向けて押し付けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraia o músculo da frente da coxa para pressionar a parte de trás do joelho em direção ao chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напрягите мышцу передней поверхности бедра, прижимая заднюю часть колена к полу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收紧大腿前侧肌肉，将膝盖后侧向地面压。"
          }
        }
      }
    },
    "Tighten the thigh of the straight leg so the knee stays locked." : {
      "comment" : "A step of how to do the exercise “Straight Leg Raise”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شدّ فخذ الساق المستقيمة بحيث تبقى الركبة مقفلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spanne den Oberschenkel des gestreckten Beins an, sodass das Knie durchgestreckt bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprieta el muslo de la pierna recta para que la rodilla se mantenga bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contractez la cuisse de la jambe tendue pour que le genou reste verrouillé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीधे पैर की जांघ को कसें ताकि घुटना लॉक रहे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "膝がロックされたままになるように、まっすぐな脚の太ももに力を入れます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraia a coxa da perna estendida para que o joelho permaneça travado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напрягите бедро прямой ноги, чтобы колено оставалось зафиксированным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绷紧伸直腿的大腿，使膝盖保持锁定。"
          }
        }
      }
    },
