    "Walk at a comfortable pace, rolling from heel to toe on each step." : {
      "comment" : "A step of how to do the exercise “Walking”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امشِ بوتيرة مريحة، مع تدحرج القدم من الكعب إلى أصابع القدم في كل خطوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe in einem angenehmen Tempo und rolle bei jedem Schritt von der Ferse zu den Zehen ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina a un ritmo cómodo, rodando del talón a la punta del pie en cada paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marchez à une allure confortable, en déroulant le pied du talon vers les orteils à chaque pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आरामदायक गति से चलें, हर कदम पर एड़ी से पंजे की ओर रोल करते हुए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽なペースで歩き、一歩ごとにかかとからつま先へと体重を移動させます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhe em um ritmo confortável, rolando do calcanhar para os dedos a cada passo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идите в комфортном темпе, перекатываясь с пятки на носок при каждом шаге."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以舒适的步速行走，每一步都从脚跟滚动到脚尖。"
          }
        }
      }
    },
    "Walk backwards, keeping your arms raised above your head. Avoid jerky movements." : {
      "comment" : "A step of how to do the exercise “Sled Overhead Backward Walk”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امشِ للخلف مع إبقاء ذراعيك مرفوعتين فوق رأسك. تجنب الحركات المتقطعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe rückwärts und halte die Arme dabei über dem Kopf. Vermeide ruckartige Bewegungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina hacia atrás, manteniendo los brazos elevados por encima de la cabeza. Evita los movimientos bruscos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marchez à reculons en gardant les bras levés au-dessus de la tête. Évitez les mouvements saccadés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजुओं को सिर के ऊपर उठाए रखते हुए पीछे की ओर चलें। झटकेदार मूवमेंट से बचें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕を頭上に上げたまま、後ろ向きに歩きます。反動をつけた動きは避けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhe para trás, mantendo os braços erguidos acima da cabeça. Evite movimentos bruscos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идите спиной вперёд, держа руки поднятыми над головой. Избегайте резких движений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向后行走，双臂始终举过头顶。避免动作突兀。"
          }
        }
      }
    },
    "Walk forward or backward by moving one hand and the opposite foot together." : {
      "comment" : "A step of how to do the exercise “Crab Walk”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امشِ إلى الأمام أو الخلف بتحريك يد والقدم المقابلة لها معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege dich vorwärts oder rückwärts, indem du eine Hand und den gegenüberliegenden Fuß gemeinsam versetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina hacia delante o hacia atrás moviendo a la vez una mano y el pie opuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancez ou reculez en déplaçant en même temps une main et le pied opposé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक हाथ और विपरीत पैर को एक साथ हिलाकर आगे या पीछे चलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片手と反対側の足を同時に動かして、前または後ろに歩きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhe para a frente ou para trás movendo uma mão e o pé oposto juntos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двигайтесь вперёд или назад, одновременно переставляя руку и противоположную ногу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过同时移动一只手和对侧的脚来向前或向后行走。"
          }
        }
      }
    },
    "Walk forward slowly, keeping the kettlebell stacked over your shoulder." : {
      "comment" : "A step of how to do the exercise “Waiter's Walk (Kettlebell)”.",
