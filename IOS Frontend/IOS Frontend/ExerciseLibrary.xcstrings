{
  "sourceLanguage" : "en",
  "strings" : {
    ". Continue stepping up and down on the same leg before switching to the opposite side." : {
      "comment" : "A step of how to do the exercise “Single Leg Box Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمر في الصعود والنزول بالساق نفسها قبل التبديل إلى الجانب الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Steige weiter auf demselben Bein auf und ab, bevor du auf die andere Seite wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa subiendo y bajando con la misma pierna antes de cambiar al lado opuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez à monter et descendre sur la même jambe avant de passer au côté opposé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसी पैर से ऊपर-नीचे कदम रखते रहें, फिर दूसरे पैर पर बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ脚でステップアップとステップダウンを続けたあと、反対側に替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue subindo e descendo com a mesma perna antes de trocar para o lado oposto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжайте подниматься и спускаться на одной и той же ноге, затем смените сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。继续用同一条腿上下台阶，然后换另一侧。"
          }
        }
      }
    },
