          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "かかとで押して立ち上がり、繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba novamente empurrando pelos calcanhares e repita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимитесь обратно, отталкиваясь пятками, и повторите."
          }
