    "Stand facing a wall at about arm's length and place your hands on it at shoulder height." : {
      "comment" : "A step of how to do the exercise “Wall Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
