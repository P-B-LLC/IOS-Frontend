          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die obere Position mit nach unten gezogenen Schultern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la posición alta con los hombros hacia abajo."
          }
        },
        "fr" : {
