    "Powerfully reverse the motion by extending at the hips, knees, and ankles to propel yourself upward, swinging the dumbbell over your head." : {
      "comment" : "A step of how to do the exercise “Swing (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعكس الحركة بقوة بمد الوركين والركبتين والكاحلين لدفع نفسك للأعلى، مع تأرجح الدمبل فوق رأسك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre die Bewegung kraftvoll um, indem du Hüfte, Knie und Knöchel streckst, um dich nach oben zu katapultieren, und schwinge die Kurzhantel über den Kopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invierte el movimiento con potencia extendiendo caderas, rodillas y tobillos para impulsarte hacia arriba, balanceando la mancuerna por encima de la cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inversez le mouvement avec puissance en tendant les hanches, les genoux et les chevilles pour vous propulser vers le haut, en balançant l'haltère au-dessus de la tête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों, घुटनों और टखनों को सीधा करके पूरी ताक़त से गति पलटें और खुद को ऊपर की ओर उछालें, डम्बल को सिर के ऊपर झुलाते हुए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "股関節、膝、足首を伸ばして力強く動きを切り返し、体を上方へ押し上げながら、ダンベルを頭上へ振り上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverta o movimento com potência, estendendo quadril, joelhos e tornozelos para se impulsionar para cima, balançando o halter acima da cabeça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мощно выполните обратное движение, разгибая бёдра, колени и голеностопы, чтобы выпрыгнуть вверх, взмахнув гантелью над головой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有力地反向发力，伸展髋、膝和踝，使身体向上腾起，同时将哑铃摆过头顶。"
          }
        }
      }
    },
