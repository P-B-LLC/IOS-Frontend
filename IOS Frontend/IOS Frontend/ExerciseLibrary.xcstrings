            "state" : "translated",
            "value" : "Schulterdehnung vor dem Körper"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estiramiento cruzado de hombro"
          }
        },
        "fr" : {
          "stringUnit" : {
