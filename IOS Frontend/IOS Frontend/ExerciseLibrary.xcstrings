    },
    "Stand with your feet hip-width apart and brace your core." : {
      "comment" : "A step of how to do the exercise “Push Press (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف وقدماك متباعدتان بعرض الوركين وشدّ عضلات جذعك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
