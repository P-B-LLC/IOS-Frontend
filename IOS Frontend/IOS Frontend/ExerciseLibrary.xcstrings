        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhe para a frente com passos curtos e controlados, mantendo o saco alto e o core firme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идите вперёд короткими контролируемыми шагами, удерживая мешок высоко, а кор напряжённым."
