          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте шаг одной ногой через дверной проём."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一只脚向前跨过门口。"
          }
        }
      }
    },
    "Step one leg diagonally behind the other, as if curtsying." : {
      "comment" : "A step of how to do the exercise “Curtsy Lunge”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخطُ بإحدى ساقيك قطريًا خلف الأخرى كما في الانحناءة التحية (كيرتسي)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze ein Bein diagonal hinter das andere, als würdest du einen Knicks machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva una pierna en diagonal por detrás de la otra, como si hicieras una reverencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Croisez une jambe en diagonale derrière l'autre, comme pour faire une révérence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पैर को दूसरे के पीछे तिरछा रखें, जैसे झुककर अभिवादन कर रहे हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お辞儀をするように、片脚をもう一方の脚の斜め後ろに踏み出します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve uma perna na diagonal para trás da outra, como em uma reverência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отведите одну ногу по диагонали назад за другую, как в реверансе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一条腿斜向后迈到另一条腿后方，就像行屈膝礼一样。"
          }
        }
      }
    },
    "Step or hop off the far side, turn around and repeat in the other direction." : {
      "comment" : "A step of how to do the exercise “Box Jump Over”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل بخطوة أو بقفزة من الجانب البعيد، واستدر وكرر في الاتجاه الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steige oder hüpfe auf der anderen Seite herunter, drehe dich um und wiederhole die Übung in die andere Richtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja caminando o dando un salto por el lado opuesto, gírate y repite en la otra dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en marchant ou en sautillant de l'autre côté, retournez-vous et répétez dans l'autre sens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरी तरफ से कदम रखकर या छलांग लगाकर नीचे उतरें, मुड़ें और दूसरी दिशा में दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反対側に降りるか跳び降りて、向きを変え、反対方向に繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça ou salte do lado oposto, vire-se e repita na outra direção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сойдите или спрыгните с дальней стороны, развернитесь и повторите в другую сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从另一侧走下或跳下，转身，然后向相反方向重复。"
          }
        }
      }
    },
    "Step or jump down the far side, turn around and repeat." : {
      "comment" : "A step of how to do the exercise “Burpee Box Jump Over”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
