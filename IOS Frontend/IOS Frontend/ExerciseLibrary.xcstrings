        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे वाले पैर से ज़मीन को दबाते हुए पीछे वाले पैर को आगे लाकर खड़े हो जाएं। पैर बारी-बारी से बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前足で床を押して、後ろ足を前に出して立ち上がります。左右の脚を交互に行います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre o chão com o pé da frente para trazer o pé de trás à frente até ficar em pé. Alterne as pernas."
