    "Sweep that arm down and under your body, threading it between your other hand and knee." : {
      "comment" : "A step of how to do the exercise “Thread the Needle”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر تلك الذراع للأسفل وتحت جسمك، لتدخلها بين يدك الأخرى وركبتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe diesen Arm nach unten und unter deinem Körper hindurch, zwischen der anderen Hand und dem Knie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva ese brazo hacia abajo y por debajo del cuerpo, pasándolo entre la otra mano y la rodilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramenez ce bras vers le bas et sous votre corps, en le faisant passer entre l'autre main et le genou."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस बाजू को नीचे और अपने शरीर के नीचे से घुमाएं, उसे अपने दूसरे हाथ और घुटने के बीच से निकालें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その腕を体の下へ振り下ろし、もう一方の手と膝の間に通します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve esse braço para baixo e por baixo do corpo, passando-o entre a outra mão e o joelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите эту руку вниз и под телом, продевая её между другой рукой и коленом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将这只手臂向下扫过并穿到身体下方，从另一只手和膝盖之间穿过。"
          }
        }
      }
    },
    "Swim your chosen stroke with a long body position and steady breathing." : {
      "comment" : "A step of how to do the exercise “Swimming”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسبح بالأسلوب الذي اخترته مع وضع جسم ممدود وتنفس ثابت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwimme deine gewählte Schwimmart mit langer Körperlage und gleichmäßiger Atmung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada el estilo elegido con el cuerpo alargado y una respiración constante."
          }
