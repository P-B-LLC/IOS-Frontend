    "Return back to the starting position slowly as you inhale until your chest muscles are fully stretched." : {
      "comment" : "A step of how to do the exercise “Chest Fly (Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد ببطء إلى وضع البداية مع الشهيق حتى تُطال عضلات الصدر بالكامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre beim Einatmen langsam in die Ausgangsposition zurück, bis die Brustmuskeln vollständig gedehnt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve lentamente a la posición inicial mientras inhalas hasta que los músculos del pecho estén completamente estirados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez lentement à la position de départ en inspirant, jusqu'à ce que les pectoraux soient complètement étirés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस अंदर लेते हुए धीरे-धीरे शुरुआती स्थिति में लौटें जब तक छाती की मांसपेशियां पूरी तरह खिंच न जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸いながら、胸の筋肉が完全に伸びるまで、ゆっくりスタートポジションに戻ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorne lentamente à posição inicial enquanto inspira, até os músculos do peito ficarem totalmente alongados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно вернитесь в исходное положение на вдохе, пока грудные мышцы не растянутся полностью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气，缓慢地回到起始姿势，直到胸肌完全拉伸。"
          }
        }
      }
    },
    "Return back to the starting position very slowly." : {
