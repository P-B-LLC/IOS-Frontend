          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できるだけ深く体を下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça o máximo que conseguir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опуститесь как можно ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能向下蹲低。"
          }
        }
      }
    },
    "Lower yourself as slowly as you can, aiming for three to five seconds, until your arms are straight." : {
      "comment" : "A step of how to do the exercise “Negative Pull Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل نفسك ببطء قدر استطاعتك، بمعدل ثلاث إلى خمس ثوانٍ، حتى تستقيم ذراعاك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich so langsam wie möglich ab, mit einem Ziel von drei bis fünf Sekunden, bis die Arme gestreckt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja lo más despacio que puedas, buscando de tres a cinco segundos, hasta que los brazos queden rectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescendez le plus lentement possible, en visant trois à cinq secondes, jusqu'à ce que vos bras soient tendus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुद को जितना धीरे हो सके नीचे लाएं, तीन से पांच सेकंड का लक्ष्य रखें, जब तक बाजुएं सीधी न हो जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕がまっすぐになるまで、3〜5秒を目安にできるだけゆっくり体を下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça o mais devagar que conseguir, buscando de três a cinco segundos, até os braços ficarem esticados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опускайтесь как можно медленнее, стремясь к трём-пяти секундам, пока руки не выпрямятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能缓慢地放下身体，目标是用三到五秒，直到手臂伸直。"
          }
        }
      }
    },
    "Lower yourself by allowing the elbow to flex until you touch the ground." : {
      "comment" : "A step of how to do the exercise “Single Arm Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل جسمك بالسماح للمرفق بالانثناء حتى تلامس الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich ab, indem du den Ellbogen beugst, bis du den Boden berührst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja dejando que el codo se flexione hasta que toques el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en laissant le coude se fléchir jusqu'à toucher le sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहनी को मुड़ने देकर खुद को तब तक नीचे लाएं जब तक आप ज़मीन को न छू लें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肘を曲げて、地面に触れるまで体を下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixe-se deixando o cotovelo flexionar até tocar o chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опускайтесь, сгибая локоть, пока не коснётесь земли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屈肘降低身体，直到碰到地面。"
          }
        }
      }
    },
    "Lower yourself by bending your elbows until your upper arms are about parallel to the floor." : {
      "comment" : "A step of how to do the exercise “Assisted Dip (Machine)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل بجسمك بثني مرفقيك حتى يصبح عضداك موازيين للأرض تقريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich ab, indem du die Ellbogen beugst, bis deine Oberarme etwa parallel zum Boden sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bájate flexionando los codos hasta que la parte superior de los brazos quede aproximadamente paralela al suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en fléchissant les coudes jusqu'à ce que le haut des bras soit à peu près parallèle au sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहनियां मोड़कर खुद को तब तक नीचे लाएं जब तक आपकी ऊपरी बाजू लगभग फ़र्श के समानांतर न हो जाए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上腕が床とほぼ平行になるまで、肘を曲げて体を下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça o corpo flexionando os cotovelos até a parte superior dos braços ficar aproximadamente paralela ao chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опуститесь, сгибая локти, пока плечи не станут примерно параллельны полу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弯曲肘部放低身体，直到上臂大致与地面平行。"
          }
        }
      }
    },
    "Lower yourself by extending at the knee, taking care to NOT flex the hips as you go forward." : {
      "comment" : "A step of how to do the exercise “Nordic Hamstring Curl”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل نفسك بمدّ الركبتين، مع الحرص على عدم ثني الوركين أثناء ميلك للأمام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich ab, indem du die Knie streckst, und achte darauf, die Hüfte beim Vorwärtsgehen NICHT zu beugen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja extendiendo las rodillas, procurando NO flexionar las caderas al ir hacia delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en tendant les genoux, en veillant à NE PAS fléchir les hanches en avançant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घुटनों को सीधा करते हुए खुद को नीचे लाएं, ध्यान रखें कि आगे जाते समय कूल्हे न मुड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "膝を伸ばして体を倒します。前に倒れるときに、股関節を曲げないよう注意してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça estendendo os joelhos, tomando cuidado para NÃO flexionar o quadril ao ir para a frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опускайтесь вперёд, разгибая колени, и следите, чтобы НЕ сгибать бёдра при движении вперёд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过伸展膝盖向前放低身体，注意向前时不要屈髋。"
          }
        }
      }
    },
    "Lower yourself slowly. Walk your feet further forward to make it harder." : {
      "comment" : "A step of how to do the exercise “Ring Row”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل جسمك ببطء. امشِ بقدميك أكثر للأمام لجعل التمرين أصعب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich langsam ab. Geh mit den Füßen weiter nach vorn, um es schwerer zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja lentamente. Camina con los pies más hacia delante para hacerlo más difícil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescendez lentement. Avancez davantage les pieds pour rendre l'exercice plus difficile."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुद को धीरे-धीरे नीचे लाएं। इसे और कठिन बनाने के लिए पैरों को और आगे चलाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくりと体を下ろします。足をさらに前に歩かせると、より負荷が高くなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixe-se lentamente. Caminhe com os pés ainda mais para a frente para dificultar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно опуститесь. Чтобы усложнить упражнение, переставьте ноги дальше вперёд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓慢放下身体。双脚向前走得更远会使难度更大。"
          }
        }
      }
    },
    "Lower yourself to a full hang under control." : {
      "comment" : "A step of how to do the exercise “Pull Up - Wide Grip”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل جسمك بتحكم إلى وضع التدلي الكامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich kontrolliert bis in den vollen Hang ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja de forma controlada hasta quedar colgado por completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescendez de façon contrôlée jusqu'à la suspension complète."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
