    "Straddle a sandbag and grab it with your arms wrapped around it." : {
      "comment" : "A step of how to do the exercise “Sandbag to Shoulder”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف فوق كيس رمل وجسمك على جانبيه وأمسكه بذراعيك ملتفتين حوله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich breitbeinig über einen Sandsack und umschlinge ihn mit den Armen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate sobre un saco de arena con una pierna a cada lado y agárralo rodeándolo con los brazos."
          }
