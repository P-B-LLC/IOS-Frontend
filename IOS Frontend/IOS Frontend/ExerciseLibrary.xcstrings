    "Focus on extending your hips, thrusting them towards the floor. Hold for 10-20 seconds and then switch sides." : {
      "comment" : "A step of how to do the exercise “All Fours Quad Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ركّز على مد وركيك ودفعهما نحو الأرض. اثبت من 10 إلى 20 ثانية ثم بدّل الجانب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konzentriere dich darauf, die Hüfte zu strecken und nach vorn in Richtung Boden zu schieben. Halte 10-20 Sekunden und wechsle dann die Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concéntrate en extender las caderas, empujándolas hacia el suelo. Mantén de 10 a 20 segundos y luego cambia de lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrez-vous sur l'extension des hanches en les poussant vers le sol. Maintenez 10 à 20 secondes, puis changez de côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कूल्हों को आगे फैलाने पर ध्यान दें, उन्हें फ़र्श की ओर धकेलें। 10-20 सेकंड रुकें और फिर तरफ बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "股関節を伸ばし、床に向かって押し出すことに集中します。10~20秒キープしたら、反対側に替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentre-se em estender o quadril, empurrando-o em direção ao chão. Mantenha por 10 a 20 segundos e depois troque de lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сосредоточьтесь на разгибании бёдер, подавая их к полу. Удерживайте положение 10–20 секунд, затем смените сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意伸展髋部，将髋部向地面推送。保持10-20秒，然后换边。"
          }
        }
      }
    },
    "Follow through by falling forward, catching yourself with your hands." : {
      "comment" : "A step of how to do the exercise “Chest Push - Multiple Response (Medicine Ball)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكمل الحركة بالسقوط إلى الأمام، مع تلقي جسمك بيديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe die Bewegung zu Ende, indem du nach vorn fällst und dich mit den Händen abfängst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompaña el movimiento cayendo hacia delante, amortiguando con las manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accompagnez le mouvement en tombant vers l'avant, en vous rattrapant avec les mains."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे की ओर गिरते हुए गति पूरी करें, हाथों से खुद को संभालें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
