    "Close slowly against the band's pull. Switch sides after your reps." : {
      "comment" : "A step of how to do the exercise “Clamshell (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلقها ببطء ضد شد الشريط. بدّل الجانب بعد تكراراتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe langsam gegen den Zug des Bandes. Wechsle nach deinen Wiederholungen die Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra lentamente contra la tensión de la banda. Cambia de lado después de tus repeticiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refermez lentement contre la traction de la bande. Changez de côté après vos répétitions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंड के खिंचाव के विरुद्ध धीरे-धीरे बंद करें। रेप्स के बाद तरफ बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドの引く力に逆らって、ゆっくり閉じます。規定の回数を終えたら、反対側に替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche lentamente contra a tração da faixa. Troque de lado após as repetições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно сводите колено против натяжения резинки. Смените сторону после повторений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对抗弹力带的拉力缓慢合拢。完成规定次数后换边。"
          }
        }
      }
    },
