    "Quadruped Rear Leg Raise" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفع الساق للخلف على أربع"
          }
        },
        "de" : {
          "stringUnit" : {
