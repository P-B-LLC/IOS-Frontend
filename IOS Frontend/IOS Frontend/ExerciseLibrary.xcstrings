        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以反握（掌心朝上）、约与肩同宽的握距抓住直杆附件。"
          }
        }
      }
    },
    "Hold the top position with your shoulders pulled down." : {
      "comment" : "A step of how to do the exercise “Negative Pull Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
