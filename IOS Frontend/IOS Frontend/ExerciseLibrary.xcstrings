    "Hold one dumbbell at your shoulder with your other arm out to the side for balance." : {
      "comment" : "A step of how to do the exercise “Single Arm Thruster (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك دمبل واحدًا عند كتفك مع مد ذراعك الأخرى إلى الجانب للتوازن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Kurzhantel an der Schulter und strecke den anderen Arm zur Seite, um das Gleichgewicht zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén una mancuerna a la altura del hombro y extiende el otro brazo hacia el lado para mantener el equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez un haltère à l'épaule, l'autre bras écarté sur le côté pour l'équilibre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक डम्बल को कंधे पर पकड़ें और संतुलन के लिए दूसरी बाजू को बगल में फैलाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダンベルを1つ肩の位置で持ち、もう一方の腕はバランスをとるために横に伸ばします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure um halter junto ao ombro, com o outro braço aberto para o lado para manter o equilíbrio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите одну гантель у плеча, а другую руку отведите в сторону для равновесия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单手将一个哑铃持于肩部，另一只手臂伸向体侧以保持平衡。"
          }
        }
      }
    },
    "Hold one dumbbell vertically against your chest with both hands cupping the top end." : {
      "comment" : "A step of how to do the exercise “Goblet Squat (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
