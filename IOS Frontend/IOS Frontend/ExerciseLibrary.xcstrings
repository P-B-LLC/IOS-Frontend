          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring die Griffe langsam zurück, bis die Arme wieder gestreckt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve las asas lentamente hasta que los brazos queden rectos de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
