    "Crunch as high as you can, hold the contraction for a second and then slowly drop back down into the starting position." : {
      "comment" : "A step of how to do the exercise “Side Lying Oblique Crunch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اصعد بالكرنش لأعلى ما تستطيع، وثبّت الانقباض لثانية واحدة ثم عد ببطء إلى وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh so hoch du kannst in den Crunch, halte die Anspannung eine Sekunde lang und lass dich dann langsam zurück in die Ausgangsposition sinken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube tanto como puedas, mantén la contracción un segundo y luego baja lentamente a la posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enroulez-vous aussi haut que possible, maintenez la contraction une seconde, puis redescendez lentement à la position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जितना ऊँचा हो सके क्रंच करें, संकुचन को एक सेकंड रोकें और फिर धीरे-धीरे वापस शुरुआती स्थिति में आएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できるだけ高くクランチし、収縮を1秒間保ってから、ゆっくり開始姿勢に下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça a abdominal o mais alto que puder, mantenha a contração por um segundo e depois volte lentamente à posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скручивайтесь как можно выше, задержите сокращение на секунду и медленно опуститесь обратно в исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能高地卷起，保持收缩一秒，然后缓慢放回起始姿势。"
          }
        }
      }
    },
    "Crunch over your torso forward and up about 3-4 inches to the right side and touch your right heel as you hold the contraction for a second. Exhale while performing this movement." : {
      "comment" : "A step of how to do the exercise “Alternating Heel Touch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ جذعك إلى الأمام وإلى الأعلى بنحو 8-10 سم نحو الجهة اليمنى والمس كعبك الأيمن مع ثبات الانقباض لثانية. ازفر أثناء هذه الحركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolle deinen Oberkörper etwa 8-10 cm nach vorn und oben zur rechten Seite und berühre deine rechte Ferse, während du die Kontraktion eine Sekunde hältst. Atme dabei aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un crunch llevando el torso hacia delante y hacia arriba unos 8-10 cm hacia el lado derecho y toca el talón derecho mientras mantienes la contracción un segundo. Exhala mientras haces este movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contractez les abdos pour monter le buste vers l'avant et le haut d'environ 8 à 10 cm vers la droite et touchez votre talon droit en maintenant la contraction une seconde. Expirez pendant ce mouvement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने धड़ को आगे और ऊपर की ओर लगभग 8-10 सेमी दाईं तरफ क्रंच करें और दाईं एड़ी को छुएं, संकुचन को एक सेकंड तक रोकें। यह गति करते समय सांस छोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上体を前方かつ上方に約8~10cm、右側に向かってクランチし、右のかかとに触れて1秒間収縮をキープします。この動作中は息を吐きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma flexão do tronco para a frente e para cima, cerca de 8 a 10 cm, inclinando-se para o lado direito, e toque o calcanhar direito enquanto mantém a contração por um segundo. Expire ao fazer esse movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрутите корпус вперёд и вверх примерно на 8–10 см в правую сторону и коснитесь правой пятки, задержав сокращение на секунду. Выдыхайте при выполнении этого движения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卷腹，将躯干向前向上抬起约8-10厘米并偏向右侧，用右手触碰右脚跟，保持收缩一秒。做这个动作时呼气。"
          }
        }
      }
    },
    "Crunch to the opposite side as you cycle your legs and bring closer your left elbow to your right knee and exhale." : {
      "comment" : "A step of how to do the exercise “Bicycle Crunch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنِ جذعك إلى الجانب المقابل أثناء تدوير ساقيك وقرّب مرفقك الأيسر من ركبتك اليمنى وازفر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe den Crunch zur anderen Seite aus, während du die Beine weiter im Kreis bewegst, bringe den linken Ellbogen näher an das rechte Knie und atme aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un crunch hacia el lado opuesto mientras pedaleas con las piernas, acercando el codo izquierdo a la rodilla derecha, y exhala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contractez-vous vers le côté opposé tout en pédalant avec les jambes, en rapprochant votre coude gauche de votre genou droit, et expirez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों को साइकिल की तरह चलाते हुए विपरीत दिशा में क्रंच करें और सांस छोड़ते हुए अपनी बाईं कोहनी को दाएं घुटने के पास लाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚をこぐように動かしながら反対側にクランチし、左肘を右膝に近づけて、息を吐きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça a flexão para o lado oposto enquanto pedala com as pernas, aproximando o cotovelo esquerdo do joelho direito, e expire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрутитесь в противоположную сторону, продолжая педалировать ногами, и подведите левый локоть ближе к правому колену, выдыхая."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在双腿蹬踏的同时向另一侧卷腹，使左肘靠近右膝，并呼气。"
          }
        }
      }
    },
    "Cuban Press (Dumbbell)" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغط كوبي (دمبل)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuban Press (Kurzhantel)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press cubano (Mancuerna)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Développé cubain (Haltère)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्यूबन प्रेस (डम्बल)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューバンプレス（ダンベル）"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenvolvimento cubano (Halter)"
          }
        },
        "ru" : {
          "stringUnit" : {
