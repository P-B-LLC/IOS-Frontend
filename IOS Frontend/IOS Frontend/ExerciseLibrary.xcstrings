    "Hold with your shoulders pushed down and your toes pointed. Bend your knees to make it easier." : {
      "comment" : "A step of how to do the exercise “L-Sit”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
