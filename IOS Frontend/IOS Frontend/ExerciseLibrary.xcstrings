          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कलाइयों के तेज़ घुमाव से रस्सी को इस तरह घुमाएं कि लैंड करने से पहले वह आपके पैरों के नीचे से दो बार गुज़रे।"
          }
        },
        "ja" : {
          "stringUnit" : {
