            "value" : "Après une brève pause, ramenez la charge à la position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ा रुकने के बाद वज़न को शुरुआती स्थिति में लौटाएं।"
          }
        },
        "ja" : {
