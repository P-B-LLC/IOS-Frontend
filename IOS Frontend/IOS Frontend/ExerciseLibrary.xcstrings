            "value" : "अपने ऊपरी शरीर को दाईं ओर घुमाएं और 10-20 सेकंड तक रोकें। फिर दूसरी ओर करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上半身を右に回旋させ、10〜20秒間キープします。その後、反対側も行います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire a parte superior do corpo para a direita e segure por 10 a 20 segundos. Troque de lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поверните верхнюю часть тела вправо и задержитесь на 10–20 секунд. Смените сторону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上半身向右旋转，保持10到20秒。然后换边。"
          }
        }
      }
    },
