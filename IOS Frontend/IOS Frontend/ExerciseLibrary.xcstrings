    },
    "Jump to a straight-arm support on top of a single bar with your hands about shoulder-width apart." : {
      "comment" : "A step of how to do the exercise “Straight Bar Dip”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
