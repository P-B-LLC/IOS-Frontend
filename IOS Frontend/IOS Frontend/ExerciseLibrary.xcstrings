        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba empurrando e pressione o halter acima da cabeça ao ficar em pé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оттолкнитесь вверх и выжмите гантель над головой, вставая."
