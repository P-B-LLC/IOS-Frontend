          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸を張ったまま、太ももが少なくとも床と平行になるまでしゃがみます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agache até as coxas ficarem pelo menos paralelas ao chão, mantendo o peito erguido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
