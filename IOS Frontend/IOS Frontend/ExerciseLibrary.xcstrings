        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout, les pieds écartés à la largeur des hanches, un pied légèrement devant l'autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों को कूल्हों की चौड़ाई पर रखकर खड़े हों, एक पैर दूसरे से थोड़ा आगे हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足を股関節幅に開き、片足をもう一方の足のわずかに前に出して立ちます。"
