        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsione-se com a perna de trás, tentando ganhar o máximo de altura com o quadril."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
