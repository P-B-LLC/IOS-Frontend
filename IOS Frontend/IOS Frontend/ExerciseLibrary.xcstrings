          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenda as pernas na extremidade do banco declinado e deite-se."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
