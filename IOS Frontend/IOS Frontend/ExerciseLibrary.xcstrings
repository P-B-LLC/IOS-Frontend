          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich schulterbreit hin und leg die Hände auf die Hüften."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie con los pies a la anchura de los hombros y las manos en las caderas."
          }
