            "state" : "translated",
            "value" : "双手过头卷腹"
          }
        }
      }
    },
    "Crunch - Legs Elevated (Stability Ball)" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
