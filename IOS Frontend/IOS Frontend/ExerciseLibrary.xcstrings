          }
        }
      }
    },
    "Extending through both legs, jump as high as possible, swinging your arms to gain lift." : {
      "comment" : "A step of how to do the exercise “Split Jump”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع مد الساقين معًا، اقفز لأعلى ارتفاع ممكن، مع تأرجح الذراعين لاكتساب الارتفاع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strecke beide Beine und springe so hoch wie möglich. Schwinge dabei die Arme, um Auftrieb zu gewinnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extendiendo ambas piernas, salta lo más alto posible, balanceando los brazos para ganar impulso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tendant les deux jambes, sautez le plus haut possible en balançant les bras pour prendre de l'élan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों पैरों को सीधा करते हुए जितना हो सके ऊंचा कूदें, ऊंचाई पाने के लिए बाजुओं को झुलाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両脚を伸ばして、腕を振って勢いをつけながら、できるだけ高くジャンプします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estendendo as duas pernas, salte o mais alto possível, balançando os braços para ganhar impulso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разгибая обе ноги, прыгните как можно выше, взмахивая руками для набора высоты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双腿同时发力伸展，尽可能跳得高，并摆臂助力。"
          }
        }
      }
    },
