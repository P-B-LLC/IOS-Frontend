            "value" : "वज़न को नियंत्रित गति से नीचे लाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールしながらウエイトを下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
