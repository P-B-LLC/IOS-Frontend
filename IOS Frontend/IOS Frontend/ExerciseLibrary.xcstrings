    "Stand facing a wall from several feet away. Stagger your stance, placing one foot forward." : {
      "comment" : "A step of how to do the exercise “Calf Stretch - Hands Against Wall”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
