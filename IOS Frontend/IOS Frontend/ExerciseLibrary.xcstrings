    "Lower the weight to perform the next repetition." : {
      "comment" : "A step of how to do the exercise “Single Arm Jerk (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنزل الوزن لأداء التكرار التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke das Gewicht für die nächste Wiederholung ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
