          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich ans Ende einer flachen Bank, in jeder Hand eine Kurzhantel, mit hängenden Armen gehalten. Die Ellbogen sind nah am Oberkörper."
