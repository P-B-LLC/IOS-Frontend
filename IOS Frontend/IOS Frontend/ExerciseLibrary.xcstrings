    "Stand tall and bring your right arm across your body and over your left shoulder." : {
      "comment" : "A step of how to do the exercise “Triceps Side Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
