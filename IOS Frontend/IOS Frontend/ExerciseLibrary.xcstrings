    "Rise back up by driving through your heels and repeat." : {
      "comment" : "A step of how to do the exercise “Double Front Squat (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
