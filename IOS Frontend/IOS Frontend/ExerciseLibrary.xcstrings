        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte o braço à posição inicial puxando a mão de volta para a linha média do corpo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верните руку в исходное положение, подтягивая кисть обратно к средней линии тела."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
