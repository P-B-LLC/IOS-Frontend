        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите то же движение, но теперь тянитесь другим локтем к противоположному колену."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复之前的动作，但换另一侧肘部去碰对侧膝盖。"
          }
        }
      }
