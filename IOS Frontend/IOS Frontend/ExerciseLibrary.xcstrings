          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साँस छोड़ते हुए कलाई को ऊपर की ओर कर्ल करके शुरू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吐きながら、手首を上に巻き上げて始めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
