        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर रुकें, और पैर को वापस शुरुआती स्थिति में लाएं जबकि आपका पार्टनर विपरीत दिशा में रेज़िस्टेंस दे।"
