    "6. Repeat this motion for the prescribed amount of repetitions." : {
      "comment" : "A step of how to do the exercise “Lat Pulldown - Close Grip (Cable)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. كرر هذه الحركة للعدد المحدد من التكرارات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. Wiederhole diese Bewegung für die vorgegebene Anzahl an Wiederholungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite este movimiento el número de repeticiones indicado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. Répétez ce mouvement pour le nombre de répétitions prescrit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. बताई गई रेप्स की संख्या तक इस मूवमेंट को दोहराएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 指定された回数だけ、この動作を繰り返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. Repita esse movimento pelo número de repetições indicado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. Повторяйте это движение предписанное количество повторений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 按规定的次数重复这个动作。"
          }
        }
      }
    },
