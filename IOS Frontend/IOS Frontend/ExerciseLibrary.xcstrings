        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸いながら、手のひらを下に向けたまま、上腕が伸びて上腕二頭筋が完全に伸びるまで、ダンベルをゆっくり下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao inspirar, abaixe lentamente os halteres mantendo as palmas para baixo até o braço ficar estendido e o bíceps totalmente alongado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдыхая, медленно опускайте гантели, сохраняя ладони обращёнными вниз, пока плечо не разогнётся, а бицепсы не растянутся полностью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气，缓慢下放哑铃，保持掌心向下，直到上臂伸直、肱二头肌完全拉伸。"
          }
        }
      }
