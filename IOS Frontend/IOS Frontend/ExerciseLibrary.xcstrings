            "value" : "ثبّت شريطًا حول عمود صلب أو أي جسم آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befestige ein Band um einen stabilen Pfosten oder einen anderen Gegenstand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancla una banda alrededor de un poste sólido u otro objeto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancrez une bande autour d'un poteau solide ou d'un autre objet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंड को किसी मज़बूत खंभे या अन्य चीज़ के चारों ओर एंकर करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドをしっかりした支柱などに固定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
