    "Sit or lie with your leg straight, placing a small rolled towel under the knee if you like." : {
      "comment" : "A step of how to do the exercise “Quad Set”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجلس أو استلقِ وساقك مستقيمة، مع وضع منشفة صغيرة ملفوفة أسفل الركبة إن رغبت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz oder leg dich mit gestrecktem Bein hin und lege bei Bedarf ein kleines zusammengerolltes Handtuch unter das Knie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o acuéstate con la pierna recta, colocando una toalla pequeña enrollada bajo la rodilla si lo deseas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous ou allongez-vous la jambe tendue, en plaçant si vous le souhaitez une petite serviette roulée sous le genou."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैर को सीधा रखकर बैठें या लेट जाएं, चाहें तो घुटने के नीचे छोटा लिपटा हुआ तौलिया रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
