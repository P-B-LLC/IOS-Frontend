            "value" : "Estiramiento del durmiente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étirement du dormeur"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्लीपर स्ट्रेच"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリーパーストレッチ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alongamento do dorminhoco"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растяжка «спящий»"
          }
        },
