        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后腿蹬地，尽可能用髋部获得更高的高度。"
          }
        }
      }
    },
    "Drive out of the squat and use that momentum to press and throw the ball to a target on the wall above you." : {
      "comment" : "A step of how to do the exercise “Wall Ball”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اندفع خارجًا من القرفصاء واستخدم هذا الزخم لدفع ورمي الكرة نحو هدف على الجدار فوقك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke dich aus der Kniebeuge nach oben und nutze diesen Schwung, um den Ball zu einem Ziel an der Wand über dir zu drücken und zu werfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
