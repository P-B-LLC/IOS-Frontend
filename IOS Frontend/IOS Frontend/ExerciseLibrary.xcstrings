          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस अंदर लेते हुए शुरुआती स्थिति में लौटें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
