    "All Fours Quad Stretch" : {
      "comment" : "Exercise name. The equipment, if any, is in brackets.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إطالة الرباعية على أربع"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadrizepsdehnung im Vierfüßlerstand"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estiramiento de cuádriceps en cuadrupedia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étirement des quadriceps à quatre pattes"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑल-फ़ोर्स क्वाड स्ट्रेच"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
