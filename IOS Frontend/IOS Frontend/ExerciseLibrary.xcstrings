          }
        }
      }
    },
    "Hold the weight on the initial position for a second and repeat the motion for the prescribed number of repetitions." : {
      "comment" : "A step of how to do the exercise “Bent Arm Pullover (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثبت بالوزن في الوضع الأولي لثانية وكرر الحركة للعدد المطلوب من التكرارات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Gewicht eine Sekunde lang in der Ausgangsposition und wiederhole die Bewegung für die vorgesehene Anzahl an Wiederholungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
