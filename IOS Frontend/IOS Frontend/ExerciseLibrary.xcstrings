          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите резинку вокруг надёжной стойки или другого предмета."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将弹力带固定在坚固的立柱或其他物体上。"
          }
        }
      }
    },
    "Anchor a band at about head height and hold one end in each hand with your palms facing down." : {
      "comment" : "A step of how to do the exercise “Face Pull (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت شريطًا عند ارتفاع الرأس تقريبًا وأمسك أحد طرفيه في كل يد وراحتاك متجهتان للأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befestige ein Band etwa auf Kopfhöhe und halte je ein Ende in jeder Hand, die Handflächen zeigen nach unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancla una banda a la altura de la cabeza y sostén un extremo en cada mano con las palmas hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancrez une bande à peu près à hauteur de tête et tenez une extrémité dans chaque main, paumes vers le bas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंड को लगभग सिर की ऊंचाई पर एंकर करें और हथेलियां नीचे की ओर रखकर हर हाथ में उसका एक सिरा पकड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドを頭の高さあたりに固定し、手のひらを下に向けて両手でバンドの両端を1本ずつ持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenda uma faixa elástica aproximadamente na altura da cabeça e segure uma ponta em cada mão, com as palmas voltadas para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите резинку примерно на уровне головы и возьмитесь за концы обеими руками, ладони обращены вниз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将弹力带固定在大约与头部同高的位置，双手各握住一端，掌心向下。"
          }
        }
      }
    },
    "Anchor a band at chest height and stand side-on to the anchor point." : {
      "comment" : "A step of how to do the exercise “Pallof Press (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت شريطًا عند ارتفاع الصدر وقف بجانب نقطة التثبيت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befestige ein Band auf Brusthöhe und stell dich seitlich zum Befestigungspunkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancla una banda a la altura del pecho y colócate de lado respecto al punto de anclaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixez une bande élastique à hauteur de poitrine et tenez-vous de profil par rapport au point d'ancrage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंड को छाती की ऊंचाई पर एंकर करें और एंकर पॉइंट की ओर बगल करके खड़े हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドを胸の高さに固定し、固定点に対して横向きに立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenda uma faixa na altura do peito e fique de lado para o ponto de fixação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите резинку на уровне груди и встаньте боком к точке крепления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将弹力带固定在与胸部齐平的位置，侧身站在固定点旁。"
          }
        }
      }
    },
    "Anchor a loop band at knee height and step into it so it sits behind one knee." : {
      "comment" : "A step of how to do the exercise “Terminal Knee Extension (Band)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت شريطًا حلقيًا عند مستوى الركبة وادخل فيه بحيث يستقر خلف إحدى ركبتيك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befestige ein Loop-Band auf Kniehöhe und steige hinein, sodass es hinter einem Knie sitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancla una banda en bucle a la altura de las rodillas y métete en ella para que quede detrás de una rodilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancrez une bande élastique en boucle à hauteur de genou et passez le pied dedans pour qu'elle se place derrière un genou."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लूप बैंड को घुटने की ऊंचाई पर एंकर करें और उसमें पैर डालें ताकि वह एक घुटने के पीछे रहे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ループバンドを膝の高さに固定し、片膝の後ろにバンドが来るように中に入ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancore uma faixa elástica em laço na altura do joelho e entre nela de modo que fique atrás de um dos joelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите петлю-резинку на уровне колена и встаньте в неё так, чтобы она оказалась позади одного колена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将环形弹力带固定在膝盖高度，踩进去，使它位于一侧膝盖后方。"
          }
        }
      }
    },
    "Anchor your suspension straps securely to the top of a rack or other object." : {
      "comment" : "A step of how to do the exercise “Push Up (Suspension Trainer)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
