        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure um halter em cada mão e fique em pé, bem ereto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите по гантели в каждую руку и встаньте прямо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
