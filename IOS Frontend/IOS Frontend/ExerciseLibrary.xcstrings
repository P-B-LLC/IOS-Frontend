          }
        }
      }
    },
    "Stand facing bench or sturdy elevated platform. Place hands on edge of bench or platform, slightly wider than shoulder width." : {
      "comment" : "A step of how to do the exercise “Incline Push Up”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف في مواجهة مقعد أو منصة مرتفعة متينة. ضع يديك على حافة المقعد أو المنصة، أوسع قليلًا من عرض الكتفين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich mit dem Gesicht zu einer Bank oder einer stabilen erhöhten Plattform. Setze die Hände etwas breiter als schulterbreit auf die Kante der Bank oder Plattform."
          }
