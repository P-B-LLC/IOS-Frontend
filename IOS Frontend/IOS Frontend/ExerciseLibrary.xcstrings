          }
        }
      }
    },
    "Stand in front of the first cone with your feet shoulder width apart. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Front Cone Hop”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف أمام المخروط الأول وقدماك متباعدتان بعرض الكتفين. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich schulterbreit vor das erste Hütchen. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie frente al primer cono con los pies separados al ancho de los hombros. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout devant le premier cône, les pieds écartés à la largeur des épaules. Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैरों को कंधों की चौड़ाई जितना फैलाकर पहले कोन के सामने खड़े हों। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のコーンの前に、足を肩幅に開いて立ちます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé diante do primeiro cone, com os pés afastados na largura dos ombros. Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте перед первым конусом, ноги на ширине плеч. Это будет ваше исходное положение."
