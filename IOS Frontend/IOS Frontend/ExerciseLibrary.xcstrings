          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Sekunde inne und kehre die Bewegung zurück in die Ausgangsposition um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una pausa de un segundo e invierte el movimiento hasta la posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
