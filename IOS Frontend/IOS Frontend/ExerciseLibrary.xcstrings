        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ケトルベルを肩にクリーンします。ケトルベルを肩に向かって引き上げながら、脚と股関節を伸ばして肩にクリーンします。その際、手首を回転させます。これがスタートポジションです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o clean de um kettlebell até o ombro. Leve o kettlebell aos ombros estendendo pernas e quadril enquanto o levanta em direção ao ombro. O punho deve girar ao fazer isso. Esta será sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите гирю на плечо. Для этого разгибайте ноги и бёдра, поднимая гирю к плечу. При этом запястье должно поворачиваться. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将壶铃翻举到肩部。通过伸展双腿和髋部，将壶铃向肩部抬起，完成翻举。做这个动作时手腕应随之旋转。这就是你的起始姿势。"
          }
        }
      }
    },
