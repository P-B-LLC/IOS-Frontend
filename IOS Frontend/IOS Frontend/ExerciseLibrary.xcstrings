          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arremesse a bola para a frente com força, flexionando o quadril e usando o corpo todo para completar o movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резко бросьте мяч вперёд, сгибаясь в бёдрах и задействуя всё тело для завершения движения."
