        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以俯卧撑姿势开始，双手放在腰部两侧，手指朝外或朝后。"
          }
        }
      }
    },
    "Start in a push-up position with your hands placed much wider than your shoulders." : {
