        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонитесь вперёд и положите правое предплечье на верхнюю часть правого бедра ладонью вверх. Убедитесь, что передняя часть запястья находится над коленом. Это ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
