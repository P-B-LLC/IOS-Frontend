          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेंच या मज़बूत ऊंचे प्लेटफ़ॉर्म की ओर मुंह करके खड़े हों। हाथों को बेंच या प्लेटफ़ॉर्म के किनारे पर कंधों की चौड़ाई से थोड़ा ज़्यादा चौड़ा रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベンチまたは頑丈な台に向かって立ちます。ベンチまたは台の端に、肩幅よりやや広く手を置きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé de frente para um banco ou uma plataforma elevada firme. Apoie as mãos na borda do banco ou da plataforma, um pouco mais afastadas que a largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте лицом к скамье или устойчивой приподнятой платформе. Положите ладони на край скамьи или платформы чуть шире плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面向凳子或牢固的高台站立。双手放在凳子或高台边缘，比肩略宽。"
          }
        }
      }
    },
    "Stand facing the anchor with your feet shoulder-width apart, leaning slightly into the bar." : {
      "comment" : "A step of how to do the exercise “Landmine Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف مواجهًا نقطة التثبيت وقدماك بعرض الكتفين، مع الميل قليلًا نحو البار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich mit Blick zur Verankerung schulterbreit hin und lehn dich leicht in die Stange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie de cara al anclaje, con los pies a la anchura de los hombros, inclinándote ligeramente hacia la barra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous face à l'ancrage, les pieds écartés à la largeur des épaules, légèrement penché vers la barre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एंकर की ओर मुंह करके खड़े हों, पैर कंधों की चौड़ाई पर हों, और बार की ओर थोड़ा झुकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アンカーの方を向いて足を肩幅に開いて立ち、バーに少しもたれかかるようにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique de frente para o ponto de fixação, com os pés na largura dos ombros, inclinando-se levemente em direção à barra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте лицом к креплению, ноги на ширине плеч, слегка наклонившись к грифу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面向固定点站立，双脚与肩同宽，身体略微靠向杠铃。"
          }
        }
      }
    },
    "Stand facing the ski erg and take one handle in each hand with your arms extended overhead." : {
      "comment" : "A step of how to do the exercise “Ski Erg”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف في مواجهة جهاز سكي إرغ وأمسك مقبضًا في كل يد مع مد ذراعيك فوق رأسك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich mit dem Gesicht zum Ski-Ergometer und nimm in jede Hand einen Griff, die Arme über dem Kopf gestreckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie frente al ski erg y toma una manija con cada mano, con los brazos extendidos por encima de la cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous face au ski erg et prenez une poignée dans chaque main, les bras tendus au-dessus de la tête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्की एर्ग की ओर मुंह करके खड़े हों और दोनों हाथों में एक-एक हैंडल लें, बाजुएं सिर के ऊपर फैली हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキーエルゴに向かって立ち、腕を頭上に伸ばして両手にハンドルを1つずつ持ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé de frente para o ski erg e segure uma empunhadura em cada mão, com os braços estendidos acima da cabeça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте лицом к ски-эргометру и возьмите по одной рукояти в каждую руку, вытянув руки над головой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面向滑雪测功仪站立，双手各握一个握把，手臂在头顶伸直。"
          }
        }
      }
    },
    "Stand holding a dumbbell in each hand in front of your thighs, feet hip-width apart." : {
      "comment" : "A step of how to do the exercise “Romanian Deadlift (Dumbbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف وأنت تمسك دمبل بكل يد أمام فخذيك وقدماك متباعدتان بعرض الوركين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich hin, in jeder Hand eine Kurzhantel vor den Oberschenkeln, die Füße hüftbreit auseinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie sosteniendo una mancuerna en cada mano frente a los muslos, con los pies separados al ancho de las caderas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout, un haltère dans chaque main devant les cuisses, les pieds écartés de la largeur des hanches."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हाथ में एक डम्बल पकड़कर जाँघों के सामने खड़े हों, पैर कूल्हों की चौड़ाई पर हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足を腰幅に開き、両手にダンベルを1つずつ持って、太ももの前で構えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé segurando um halter em cada mão à frente das coxas, com os pés afastados na largura do quadril."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте, держа по гантели в каждой руке перед бёдрами, ступни на ширине таза."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站立，双手各握一个哑铃放在大腿前方，双脚与髋同宽。"
          }
        }
      }
    },
    "Stand holding a light kettlebell by the horns close to your chest. This will be your starting position." : {
      "comment" : "A step of how to do the exercise “Goblet Squat (Kettlebell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف وأنت تمسك كيتل بيل خفيفًا من القرنين قرب صدرك. هذا هو وضع البداية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich hin und halte eine leichte Kettlebell an den Seitengriffen nah an der Brust. Das ist deine Ausgangsposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie sosteniendo una pesa rusa ligera por los cuernos, cerca del pecho. Esta será tu posición inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout en tenant un kettlebell léger par les cornes, près de la poitrine. Ce sera votre position de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक हल्की केटलबेल को छाती के पास उसके हॉर्न्स से पकड़कर खड़े हों। यह आपकी शुरुआती स्थिति होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽いケトルベルのホーン(取っ手の両側)を持ち、胸の近くで保持して立ちます。これが開始姿勢です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé segurando um kettlebell leve pelas laterais da alça, junto ao peito. Esta será a sua posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте, держа лёгкую гирю за рога у груди. Это будет ваше исходное положение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站立，握住轻重量壶铃的两侧把手，贴近胸前。这就是起始姿势。"
          }
        }
      }
    },
    "Stand holding a support with one hand and rise onto the balls of your feet." : {
      "comment" : "A step of how to do the exercise “Sissy Squat”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف ممسكًا بدعامة بيد واحدة وارتفع على مقدمة قدميك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich hin, halte dich mit einer Hand an einer Stütze fest und gehe auf die Fußballen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie sujetando un apoyo con una mano y elévate sobre la punta de los pies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout en vous appuyant d'une main sur un support et montez sur la pointe des pieds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक हाथ से सहारा पकड़कर खड़े हों और पंजों के बल ऊपर उठें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片手で支えをつかんで立ち、つま先立ちになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé segurando um apoio com uma das mãos e suba na ponta dos pés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте, держась одной рукой за опору, и поднимитесь на носки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单手扶住支撑物站立，踮起脚尖。"
          }
        }
      }
    },
    "Stand holding the bar at your hips with a grip just outside shoulder width." : {
      "comment" : "A step of how to do the exercise “Hang Power Clean (Barbell)”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف وأنت تمسك البار عند وركيك بقبضة خارج عرض الكتفين بقليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich hin und halte die Stange an der Hüfte mit einem Griff knapp außerhalb der Schulterbreite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie sosteniendo la barra a la altura de las caderas con un agarre justo por fuera del ancho de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout en tenant la barre à hauteur des hanches, avec une prise juste un peu plus large que les épaules."
