        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após uma contração de um segundo no topo do movimento, comece a inspirar e abaixe lentamente os pesos de volta à posição inicial pelo mesmo caminho usado para levantá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
