          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸いながら、あごが胸の上部に触れるまで、首をゆっくり下ろします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
