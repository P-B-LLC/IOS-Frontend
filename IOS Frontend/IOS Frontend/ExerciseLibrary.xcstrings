            "state" : "translated",
            "value" : "少し止めてから、ウエイトをスタートポジションに戻します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após uma breve pausa, retorne o peso à posição inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После короткой паузы верните вес в исходное положение."
