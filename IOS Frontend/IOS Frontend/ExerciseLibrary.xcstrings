    "Stand or sit tall and clasp your fingers together in front of you with your thumbs pointing down." : {
      "comment" : "A step of how to do the exercise “Upper Back Stretch”.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف أو اجلس منتصبًا وشبّك أصابعك أمامك مع توجيه إبهاميك للأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dich aufrecht hin oder setze dich aufrecht und verschränke die Finger vor dir, die Daumen zeigen nach unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócate de pie o sentado, erguido, y entrelaza los dedos frente a ti con los pulgares hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez-vous debout ou assis bien droit et entrelacez les doigts devant vous, les pouces pointés vers le bas."
