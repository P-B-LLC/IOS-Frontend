    "Withdraw your request to follow @%@?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد سحب طلب متابعة @%@؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Folgeanfrage an @%@ zurückziehen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Retirar tu solicitud para seguir a @%@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer votre demande d’abonnement à @%@ ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@%@ को फ़ॉलो करने का अपना अनुरोध वापस लें?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@%@さんへのフォローリクエストを取り消しますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirar sua solicitação para seguir @%@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отозвать запрос на подписку на @%@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤回对 @%@ 的关注请求？"
          }
        }
      }
    },
    "Withdrawing stops queued checks and prevents new submissions that need screening. It cannot recall content already sent for review." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي السحب إلى إيقاف الفحوصات المنتظرة ومنع الإرسالات الجديدة التي تحتاج إلى فحص. ولا يمكنه استرجاع المحتوى الذي أُرسل للمراجعة بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Widerruf stoppt anstehende Prüfungen und verhindert neue Einreichungen, die geprüft werden müssen. Bereits zur Prüfung gesendete Inhalte können nicht zurückgeholt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirarlo detiene las comprobaciones en cola e impide nuevos envíos que necesiten revisión. No puede recuperar contenido que ya se envió a revisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retrait arrête les contrôles en attente et empêche les nouveaux envois nécessitant un contrôle. Il ne peut pas rappeler le contenu déjà envoyé pour examen."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति वापस लेने से कतार में लगी जाँच रुक जाती हैं और ऐसे नए सबमिशन नहीं हो पाते जिनकी जाँच ज़रूरी है। समीक्षा के लिए पहले से भेजा गया कंटेंट वापस नहीं लिया जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消すと、待機中の確認が停止し、審査が必要な新しい投稿はできなくなります。すでに審査に送信されたコンテンツを取り戻すことはできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirar a permissão interrompe as verificações na fila e impede novos envios que precisam de triagem. Não é possível recuperar o conteúdo já enviado para revisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отзыв останавливает проверки в очереди и не даёт отправлять новые материалы, требующие проверки. Уже отправленный на проверку контент отозвать нельзя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤回后将停止排队中的检查，并阻止需要筛查的新提交。已发送审核的内容无法撤回。"
          }
        }
      }
    },
