          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usadas somente para lembretes que você ativar no Rytivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется только для напоминаний, которые вы включили в Rytivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于你在 Rytivo 中启用的提醒。"
          }
        }
      }
    },
    "Used when you choose a profile photo. Rytivo does not browse your library in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم عند اختيار صورة الملف الشخصي. لا يتصفح Rytivo مكتبتك في الخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, wenn du ein Profilfoto auswählst. Rytivo durchsucht deine Mediathek nicht im Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cuando eliges una foto de perfil. Rytivo no explora tu biblioteca en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisées quand vous choisissez une photo de profil. Rytivo ne parcourt pas votre photothèque en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप प्रोफ़ाइल फ़ोटो चुनते हैं, तब इस्तेमाल होता है। Rytivo बैकग्राउंड में आपकी लाइब्रेरी नहीं देखता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール写真を選ぶときに使用されます。Rytivoがバックグラウンドでライブラリを閲覧することはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usadas quando você escolhe uma foto de perfil. O Rytivo não navega pela sua biblioteca em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется, когда вы выбираете фото профиля. Rytivo не просматривает вашу медиатеку в фоновом режиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你选择个人主页照片时使用。Rytivo 不会在后台浏览你的图库。"
          }
        }
      }
    },
