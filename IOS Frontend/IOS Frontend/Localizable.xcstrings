    "Done. For You starts learning again from what you do next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم. سيبدأ «مقترحات لك» التعلّم من جديد مما تفعله لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig. „Für dich“ lernt ab jetzt neu aus dem, was du als Nächstes tust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listo. Para ti empieza a aprender de nuevo a partir de lo que hagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est fait. Pour vous recommence à apprendre de ce que vous ferez ensuite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो गया। ‘आपके लिए’ अब आपकी अगली गतिविधि से फिर से सीखना शुरू करेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了しました。「おすすめ」は、これからのあなたの行動から再び学習を始めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
