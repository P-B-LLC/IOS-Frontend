    "If %@ has an account, a six digit code is on its way. It works once and expires in 15 minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان لـ %@ حساب، فإن رمزًا من ستة أرقام في الطريق إليه. يعمل مرة واحدة وتنتهي صلاحيته خلال 15 دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn %@ ein Konto hat, ist ein sechsstelliger Code unterwegs. Er funktioniert einmal und läuft nach 15 Minuten ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ tiene una cuenta, ya va en camino un código de seis dígitos. Funciona una sola vez y caduca en 15 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ est associé à un compte, un code à six chiffres est en route. Il est à usage unique et expire dans 15 minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर %@ का अकाउंट है, तो छह अंकों का कोड भेजा जा रहा है। यह एक ही बार काम करता है और 15 मिनट में खत्म हो जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にアカウントがある場合、6桁のコードを送信しました。コードは1回のみ有効で、15分後に失効します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se houver uma conta com %@, um código de seis dígitos está a caminho. Ele funciona uma única vez e expira em 15 minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если с адресом %@ связан аккаунт, на него отправлен шестизначный код. Он одноразовый и действует 15 минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 %@ 已注册账户，六位验证码正在发送中。该验证码仅能使用一次，15 分钟后过期。"
          }
        }
      }
    },
