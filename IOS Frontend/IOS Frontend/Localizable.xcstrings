    "Vitamins and other micronutrients aren't tracked yet. They need a food database or extra label fields." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم تتبّع الفيتامينات والمغذيات الدقيقة الأخرى بعد. فهي تحتاج إلى قاعدة بيانات أطعمة أو حقول إضافية من الملصق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamine und andere Mikronährstoffe werden noch nicht erfasst. Dafür sind eine Lebensmitteldatenbank oder zusätzliche Etikettfelder nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las vitaminas y otros micronutrientes aún no se registran. Necesitan una base de datos de alimentos o campos adicionales en la etiqueta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vitamines et autres micronutriments ne sont pas encore suivis. Il faudrait pour cela une base d’aliments ou des champs d’étiquette supplémentaires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विटामिन और दूसरे सूक्ष्म पोषक तत्व अभी ट्रैक नहीं किए जाते। इसके लिए खाने का डेटाबेस या लेबल के अतिरिक्त फ़ील्ड चाहिए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビタミンやその他の微量栄養素はまだ記録されません。食品データベースか、ラベルの追加項目が必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitaminas e outros micronutrientes ainda não são acompanhados. Eles precisam de um banco de alimentos ou de campos extras do rótulo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Витамины и другие микронутриенты пока не отслеживаются. Для этого нужна база продуктов или дополнительные поля этикетки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不追踪维生素和其他微量营养素。这需要食物数据库或额外的标签字段。"
          }
        }
      }
    },
