    "Next time, %@ opens with today’s exercises, order, sets and rests." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المرة القادمة، يُفتح %@ بتمارين اليوم وترتيبها ومجموعاتها وفترات الراحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim nächsten Mal startet %@ mit den Übungen, der Reihenfolge, den Sätzen und Pausen von heute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La próxima vez, %@ se abrirá con los ejercicios, el orden, las series y los descansos de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prochaine fois, %@ s’ouvrira avec les exercices, l’ordre, les séries et les repos d’aujourd’hui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली बार %@ आज की एक्सरसाइज़, क्रम, सेट और आराम के साथ खुलेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回の%@は、今日の種目・順番・セット・休息で始まります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na próxima vez, %@ vai abrir com os exercícios, a ordem, as séries e os descansos de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В следующий раз %@ откроется с сегодняшними упражнениями, порядком, подходами и отдыхом."
