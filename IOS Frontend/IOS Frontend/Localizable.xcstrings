    "Nothing was submitted. Safety-review permission could not be requested — reopen the app and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إرسال أي شيء. تعذّر طلب إذن مراجعة السلامة — أعد فتح التطبيق وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde nichts eingereicht. Die Berechtigung zur Sicherheitsprüfung konnte nicht angefragt werden — öffne die App erneut und versuche es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envió nada. No se pudo solicitar el permiso de revisión de seguridad — vuelve a abrir la app e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’a été envoyé. Impossible de demander l’autorisation d’examen de sécurité — rouvrez l’app et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भी सबमिट नहीं किया गया। सुरक्षा समीक्षा की अनुमति का अनुरोध नहीं किया जा सका — ऐप फिर से खोलें और दोबारा कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も送信されませんでした。安全審査の許可をリクエストできませんでした。アプリを開き直して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi enviado. Não foi possível solicitar a permissão de revisão de segurança — abra o app novamente e tente outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не отправлено. Не удалось запросить разрешение на проверку безопасности — перезапустите приложение и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未提交任何内容。无法请求安全审核权限——请重新打开 App 后重试。"
          }
