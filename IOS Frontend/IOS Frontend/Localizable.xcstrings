    "%lld logged sets will be removed from this workout. Your other exercises and your rest timer are not affected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد المجموعات المسجّلة التي ستُزال من هذا التمرين: %lld. لن تتأثر حركاتك الأخرى ولا مؤقت الراحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld erfasste Sätze werden aus diesem Workout entfernt. Deine anderen Übungen und dein Pausentimer bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitarán %lld series registradas de este entrenamiento. Tus demás ejercicios y tu temporizador de descanso no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld séries notées seront retirées de cet entraînement. Vos autres exercices et votre minuteur de repos ne changent pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉग किए गए सेट (%lld) इस वर्कआउट से हटा दिए जाएँगे। आपकी बाकी एक्सरसाइज़ और आराम टाइमर पर कोई असर नहीं पड़ेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録済みの%lldセットがこのワークアウトから削除されます。ほかの種目と休息タイマーには影響しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld séries registradas serão removidas deste treino. Seus outros exercícios e o timer de descanso não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из этой тренировки будут удалены записанные подходы: %lld. Остальные упражнения и таймер отдыха не изменятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从本次训练中移除已记录的 %lld 组。你的其他动作和休息计时器不受影响。"
          }
        }
      }
    },
