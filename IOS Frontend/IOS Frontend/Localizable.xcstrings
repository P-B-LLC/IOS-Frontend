    "An hour before, then thirty, fifteen, five and one minute before it starts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل ساعة، ثم قبل ثلاثين وخمس عشرة وخمس دقائق ودقيقة واحدة من بدئه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stunde vorher, dann dreißig, fünfzehn, fünf und eine Minute vor Beginn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hora antes, y luego treinta, quince, cinco y un minuto antes de que empiece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une heure avant, puis trente, quinze, cinq et une minute avant le début."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू होने से एक घंटा पहले, फिर तीस, पंद्रह, पाँच और एक मिनट पहले।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始の1時間前、その後30分前、15分前、5分前、1分前。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma hora antes e depois trinta, quinze, cinco e um minuto antes de começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За час, затем за тридцать, пятнадцать, пять минут и за одну минуту до начала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
