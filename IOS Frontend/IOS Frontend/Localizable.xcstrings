    "Your day is open. Add a task or event to get started." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يومك متاح. أضف مهمة أو حدثًا للبدء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tag ist frei. Füge eine Aufgabe oder ein Ereignis hinzu, um loszulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu día está libre. Agrega una tarea o un evento para empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre journée est libre. Ajoutez une tâche ou un événement pour commencer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका दिन खाली है। शुरू करने के लिए कोई टास्क या इवेंट जोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は予定が空いています。タスクやイベントを追加して始めましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu dia está livre. Adicione uma tarefa ou evento para começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш день свободен. Добавьте задачу или событие, чтобы начать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你今天还没有安排。添加任务或日程开始吧。"
          }
        }
      }
    },
    "Your earlier set was saved. Its saved values are shown; unlog it first if you want to change them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ مجموعتك السابقة. تظهر قيمها المحفوظة؛ ألغِ تسجيلها أولًا إذا أردت تغييرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein vorheriger Satz wurde gespeichert. Seine gespeicherten Werte werden angezeigt; nimm die Erfassung zuerst zurück, wenn du sie ändern möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu serie anterior se guardó. Se muestran sus valores guardados; anula su registro primero si quieres cambiarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre série précédente a été enregistrée. Ses valeurs enregistrées sont affichées ; annulez d’abord sa notation si vous voulez les modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पिछला सेट सेव हो गया था। उसकी सेव की गई वैल्यू दिखाई गई हैं; उन्हें बदलना हो तो पहले उसे अनलॉग करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のセットは保存されています。保存された値が表示されています。変更したい場合は、先に記録を取り消してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua série anterior foi salva. Os valores salvos estão sendo exibidos; desfaça o registro primeiro se quiser alterá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущий подход сохранён. Показаны его сохранённые значения; чтобы изменить их, сначала отмените запись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你之前的组已保存。当前显示的是已保存的数值；如需更改，请先取消记录。"
          }
        }
      }
    },
    "Your effort is adding up." : {
