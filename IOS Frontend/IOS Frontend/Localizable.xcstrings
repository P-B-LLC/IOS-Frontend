    "You’ve logged as many sessions as your weekly plan calls for. Leave room to recover, too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّلت عدد الجلسات الذي تتطلبه خطتك الأسبوعية. اترك مجالًا للتعافي أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast so viele Einheiten erfasst, wie dein Wochenplan vorsieht. Lass auch Raum für Erholung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registraste tantas sesiones como pide tu plan semanal. Deja espacio para recuperarte también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez enregistré autant de séances que prévu dans votre plan hebdomadaire. Gardez aussi du temps pour récupérer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने उतने सेशन लॉग कर लिए हैं जितने आपके साप्ताहिक प्लान में हैं। रिकवरी के लिए भी जगह छोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週間プランで予定した数のセッションを記録しました。回復のための時間も確保しましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você registrou todas as sessões que seu plano semanal prevê. Reserve um tempo para se recuperar também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы записали столько занятий, сколько предусматривает недельный план. Оставьте время и на восстановление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你记录的训练次数已达到每周计划的要求。也要留出恢复的时间。"
          }
        }
      }
    },
