    "Reminders follow your notification preferences." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع التذكيرات تفضيلات الإشعارات لديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen folgen deinen Benachrichtigungseinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios siguen tus preferencias de notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels suivent vos préférences de notification."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमाइंडर आपकी नोटिफ़िकेशन प्राथमिकताओं के हिसाब से आते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーは通知の設定に従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lembretes seguem suas preferências de notificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания следуют вашим настройкам уведомлений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒会遵循你的通知偏好设置。"
          }
        }
      }
    },
    "Reminders for workouts, food, tasks and events are scheduled on this device. Community activity is read when you open the notifications page." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجدوَل تذكيرات التمارين والطعام والمهام والأحداث على هذا الجهاز. ويُقرأ نشاط المجتمع عند فتح صفحة الإشعارات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen für Workouts, Ernährung, Aufgaben und Ereignisse werden auf diesem Gerät geplant. Community-Aktivität wird gelesen, wenn du die Benachrichtigungsseite öffnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios de entrenamientos, alimentación, tareas y eventos se programan en este dispositivo. La actividad de la comunidad se lee cuando abres la página de notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels d’entraînements, d’alimentation, de tâches et d’événements sont programmés sur cet appareil. L’activité de la communauté est récupérée à l’ouverture de la page des notifications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्कआउट, खाने, टास्क और इवेंट के रिमाइंडर इसी डिवाइस पर शेड्यूल होते हैं। कम्युनिटी गतिविधि तब पढ़ी जाती है जब आप नोटिफ़िकेशन पेज खोलते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト、食事、タスク、イベントのリマインダーはこのデバイスでスケジュールされます。コミュニティのアクティビティは、通知ページを開いたときに読み込まれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lembretes de treinos, alimentação, tarefas e eventos são agendados neste dispositivo. A atividade da comunidade é carregada quando você abre a página de notificações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания о тренировках, питании, задачах и событиях планируются на этом устройстве. Активность сообщества загружается, когда вы открываете страницу уведомлений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练、饮食、任务和日程的提醒在此设备上安排。社区动态会在你打开通知页面时读取。"
          }
        }
      }
    },
