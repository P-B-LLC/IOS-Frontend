    "%@ cannot be on a weekly repeat and in a rotation at once. The rotation will take over from here; weeks already planned stay as they are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن أن يكون %@ ضمن تكرار أسبوعي وتناوب في الوقت نفسه. سيتولى التناوب الأمر من الآن؛ وتبقى الأسابيع المخطط لها كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht gleichzeitig wöchentlich wiederholt werden und Teil einer Rotation sein. Ab hier übernimmt die Rotation; bereits geplante Wochen bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede estar en una repetición semanal y en una rotación a la vez. La rotación toma el control a partir de ahora; las semanas ya planificadas se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas se répéter chaque semaine et faire partie d’une rotation à la fois. La rotation prend le relais à partir d’ici ; les semaines déjà planifiées restent inchangées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ एक साथ साप्ताहिक दोहराव और रोटेशन, दोनों में नहीं हो सकता। यहाँ से रोटेशन लागू होगा; पहले से प्लान किए गए हफ़्ते वैसे ही रहेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を毎週の繰り返しとローテーションに同時に入れることはできません。ここからはローテーションが優先されます。すでに計画済みの週はそのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não pode estar em uma repetição semanal e em uma rotação ao mesmo tempo. A rotação assume a partir de agora; as semanas já planejadas continuam como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не может одновременно повторяться каждую неделю и входить в ротацию. Дальше действует ротация; уже запланированные недели останутся как есть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法同时设为每周重复和加入轮换。从现在起将由轮换接管；已排好的周保持不变。"
          }
        }
      }
    },
