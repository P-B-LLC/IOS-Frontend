    "Your running is still timed and saved — it just won't have a map or a measured distance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال الجري يُوقَّت ويُحفظ — فقط لن تكون له خريطة أو مسافة مقيسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit deines Laufs wird trotzdem gemessen und gespeichert — nur ohne Karte und gemessene Distanz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu carrera se sigue cronometrando y guardando — solo que no tendrá mapa ni distancia medida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre course est toujours chronométrée et enregistrée — simplement sans carte ni distance mesurée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी दौड़ का समय फिर भी गिना और सेव किया जाएगा — बस उसमें नक्शा या मापी गई दूरी नहीं होगी।"
          }
        },
        "ja" : {
