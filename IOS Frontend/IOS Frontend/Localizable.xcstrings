    "You have missed a few days. Start the workout you owe today, and carry on from there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فاتتك بضعة أيام. ابدأ التمرين المستحق اليوم، وتابع من هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast ein paar Tage verpasst. Starte heute das fällige Workout und mach von dort aus weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te saltaste algunos días. Empieza hoy el entrenamiento que te toca y sigue a partir de ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez manqué quelques jours. Commencez aujourd’hui l’entraînement en attente, et reprenez à partir de là."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके कुछ दिन छूट गए हैं। आज बाकी रह गया वर्कआउट शुरू करें, और वहीं से आगे बढ़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数日間空いてしまいました。今日は予定していたワークアウトから始めて、そこから続けましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você perdeu alguns dias. Comece hoje o treino pendente e siga a partir daí."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы пропустили несколько дней. Начните сегодня с положенной тренировки и продолжайте дальше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你错过了几天。今天先完成欠下的训练，然后从那里继续。"
          }
        }
      }
    },
    "You showed up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد حضرت."
          }
