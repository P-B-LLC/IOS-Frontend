    "Nothing yet. Like, save or stay on posts and it starts to learn." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء بعد. أعجب بالمنشورات أو احفظها أو توقف عندها ليبدأ التعلّم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts. Like Beiträge, speichere sie oder schau sie dir länger an, dann lernt „Für dich“ dazu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada. Da me gusta, guarda o quédate viendo publicaciones y empezará a aprender."
