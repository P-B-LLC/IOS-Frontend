    "Profile, workout, planner, and nutrition data are stored with your Rytivo account so they sync across sessions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن بيانات الملف الشخصي والتمارين والمخطِّط والتغذية مع حسابك على Rytivo لتتم مزامنتها عبر الجلسات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil-, Workout-, Planer- und Ernährungsdaten werden mit deinem Rytivo-Konto gespeichert, damit sie sitzungsübergreifend synchronisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de perfil, entrenamiento, agenda y nutrición se guardan con tu cuenta de Rytivo para que se sincronicen entre sesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de profil, d’entraînement, d’agenda et de nutrition sont stockées avec votre compte Rytivo afin d’être synchronisées d’une session à l’autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल, वर्कआउट, प्लानर और पोषण का डेटा आपके Rytivo अकाउंट के साथ स्टोर किया जाता है, ताकि वह सभी सेशन में सिंक रहे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール、ワークアウト、プランナー、栄養のデータはRytivoアカウントに保存され、セッション間で同期されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de perfil, treino, agenda e nutrição ficam armazenados na sua conta do Rytivo para sincronizar entre sessões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные профиля, тренировок, планировщика и питания хранятся в вашем аккаунте Rytivo и синхронизируются между сеансами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个人主页、训练、日历和营养数据都存储在你的 Rytivo 账户中，因此每次登录时都会同步。"
          }
        }
      }
    },
