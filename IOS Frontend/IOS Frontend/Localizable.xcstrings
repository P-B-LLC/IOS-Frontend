    "Plan training, understand nutrition, and share progress without fighting the interface." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطّط لتدريبك، وافهم تغذيتك، وشارك تقدمك دون صراع مع الواجهة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane dein Training, verstehe deine Ernährung und teile Fortschritte, ohne gegen die Oberfläche zu kämpfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica tu entrenamiento, entiende tu nutrición y comparte tu progreso sin pelearte con la interfaz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez vos entraînements, comprenez votre nutrition et partagez vos progrès sans lutter contre l’interface."
          }
