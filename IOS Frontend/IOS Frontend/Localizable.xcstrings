    "A previous workout start is waiting to be confirmed. Retry workout sync before starting another workout." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدء تمرين سابق بانتظار التأكيد. أعد محاولة مزامنة التمارين قبل بدء تمرين آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein früherer Workout-Start wartet noch auf Bestätigung. Wiederhole die Workout-Synchronisierung, bevor du ein weiteres Workout startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un inicio de entrenamiento anterior pendiente de confirmación. Reintenta la sincronización del entrenamiento antes de empezar otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le démarrage d’un entraînement précédent attend d’être confirmé. Relancez la synchronisation avant de commencer un autre entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले वर्कआउट की शुरुआत की पुष्टि होना बाकी है। दूसरा वर्कआउट शुरू करने से पहले वर्कआउट सिंक फिर से आज़माएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のワークアウト開始がまだ確認待ちです。別のワークアウトを始める前に、ワークアウトの同期を再試行してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um início de treino anterior está aguardando confirmação. Tente sincronizar os treinos novamente antes de iniciar outro treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущий запуск тренировки ожидает подтверждения. Повторите синхронизацию тренировок, прежде чем начинать новую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
