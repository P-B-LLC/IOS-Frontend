    "Local save recovery is unavailable. Reconnect your account and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعادة الحفظ المحلي غير متاحة. أعد ربط حسابك وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die lokale Wiederherstellung von Speicherungen ist nicht verfügbar. Verbinde dein Konto erneut und versuche es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación de guardado local no está disponible. Vuelve a conectar tu cuenta e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération de la sauvegarde locale n’est pas disponible. Reconnectez votre compte et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस पर सेव की गई कॉपी से रिकवरी उपलब्ध नहीं है। अपना अकाउंट फिर से कनेक्ट करें और दोबारा कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル保存の復元を利用できません。アカウントを再接続して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
