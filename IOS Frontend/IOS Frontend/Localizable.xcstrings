        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल्की गतिविधि। आप पूरे समय बातें कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽い運動。ずっとおしゃべりできる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
