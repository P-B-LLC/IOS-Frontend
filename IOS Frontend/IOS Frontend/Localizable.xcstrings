    "Used for every exercise without a rest of its own. Each exercise’s rest can be changed in a workout or its plan. Drop sets never start a rest, and a superset rests after the last exercise of each round." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لكل حركة ليس لها وقت راحة خاص بها. يمكن تغيير راحة كل حركة في التمرين أو في خطته. لا تبدأ المجموعات التنازلية راحةً أبدًا، وفي المجموعة الفائقة تكون الراحة بعد آخر حركة في كل جولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für jede Übung ohne eigene Pause. Die Pause jeder Übung lässt sich in einem Workout oder seinem Plan ändern. Dropsätze starten nie eine Pause, und ein Supersatz pausiert nach der letzten Übung jeder Runde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa en todos los ejercicios que no tienen un descanso propio. El descanso de cada ejercicio se puede cambiar en un entrenamiento o en su plan. Las series descendentes nunca inician un descanso, y una superserie descansa después del último ejercicio de cada ronda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à chaque exercice qui n’a pas son propre repos. Le repos de chaque exercice peut être modifié dans un entraînement ou dans son plan. Les séries dégressives ne lancent jamais de repos, et un superset se repose après le dernier exercice de chaque tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन सभी एक्सरसाइज़ के लिए इस्तेमाल होता है जिनका अपना आराम तय नहीं है। हर एक्सरसाइज़ का आराम किसी वर्कआउट या उसके प्लान में बदला जा सकता है। ड्रॉप सेट के बाद कभी आराम शुरू नहीं होता, और सुपरसेट में हर राउंड की आखिरी एक्सरसाइज़ के बाद आराम होता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個別の休息が設定されていないすべての種目に使われます。各種目の休息は、ワークアウトまたはそのプランで変更できます。ドロップセットでは休息は始まらず、スーパーセットでは各ラウンドの最後の種目の後に休息します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado em todos os exercícios sem um descanso próprio. O descanso de cada exercício pode ser alterado em um treino ou no plano dele. Séries descendentes nunca iniciam um descanso, e uma supersérie descansa após o último exercício de cada rodada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется ко всем упражнениям без собственного времени отдыха. Отдых для каждого упражнения можно изменить в тренировке или в её плане. После дроп-сетов отдых не начинается, а в суперсете отдых идёт после последнего упражнения каждого круга."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于所有未单独设置休息时间的动作。每个动作的休息时间可在训练或其计划中更改。递减组不会开始休息，超级组会在每轮最后一个动作之后休息。"
          }
        }
      }
    },
    "Used only during a route workout you start, to map distance and pace." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم فقط أثناء تمرين بمسار تبدأه أنت، لرسم المسافة والوتيرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur während eines von dir gestarteten Routen-Workouts verwendet, um Distanz und Pace zu erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa solo durante un entrenamiento con ruta que inicias, para trazar la distancia y el ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée uniquement pendant un entraînement avec itinéraire que vous lancez, pour mesurer la distance et l’allure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूरी और पेस मैप करने के लिए, सिर्फ़ आपके शुरू किए गए रूट वर्कआउट के दौरान इस्तेमाल होता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが開始したルートワークアウト中に、距離とペースを地図に記録するためだけに使用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada somente durante um treino com trajeto que você inicia, para mapear distância e ritmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется только во время тренировки с маршрутом, которую вы начали, чтобы измерять дистанцию и темп."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你开始的路线训练中使用，用于绘制距离和配速。"
          }
        }
      }
    },
    "Used only for reminders you enable in Rytivo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم فقط للتذكيرات التي تفعّلها في Rytivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
