                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تبدأ الدورة العدّ من %1$@. بعد ذلك تتكرر كل %2$lld أيام، ما يعني أنها لن تقع في يوم الأسبوع نفسه مرتين."
                }
              }
            }
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zyklus zählt ab %1$@. Danach wiederholt er sich alle %2$lld Tage, das heißt, er fällt nicht zweimal auf denselben Wochentag."
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The cycle counts from %1$@. After that it repeats every %2$lld day, which means it will not land on the same weekday twice."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The cycle counts from %1$@. After that it repeats every %2$lld days, which means it will not land on the same weekday twice."
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ciclo cuenta desde el %1$@. Después se repite cada %2$lld días, lo que significa que no caerá dos veces en el mismo día de la semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cycle démarre le %1$@. Il se répète ensuite tous les %2$lld jours, ce qui signifie qu’il ne tombera pas deux fois sur le même jour de la semaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चक्र %1$@ से गिना जाता है। उसके बाद यह हर %2$lld दिन में दोहराया जाता है, यानी यह दो बार हफ़्ते के एक ही दिन पर नहीं पड़ेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイクルは%1$@から数えます。その後は%2$lld日ごとに繰り返すため、同じ曜日に固定されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ciclo conta a partir de %1$@. Depois disso, ele se repete a cada %2$lld dias, o que significa que não vai cair no mesmo dia da semana duas vezes."
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Цикл отсчитывается с %1$@. Затем он повторяется каждые %2$lld дня, поэтому не будет дважды выпадать на один и тот же день недели."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Цикл отсчитывается с %1$@. Затем он повторяется каждые %2$lld дней, поэтому не будет дважды выпадать на один и тот же день недели."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Цикл отсчитывается с %1$@. Затем он повторяется каждый %2$lld день, поэтому не будет дважды выпадать на один и тот же день недели."
                }
              },
              "other" : {
