    "Removes this workout's recorded sessions for this day, then starts it again" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل الجلسات المسجّلة لهذا التمرين في هذا اليوم، ثم يبدؤه من جديد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die aufgezeichneten Einheiten dieses Workouts für diesen Tag und startet es dann neu"
