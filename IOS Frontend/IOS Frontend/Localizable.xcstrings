    "No time set for it, so it is yours to place in the day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُحدَّد له وقت، لذا يمكنك وضعه في أي وقت من اليوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Uhrzeit festgelegt, du kannst sie also selbst im Tag einplanen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene hora fija, así que tú decides cuándo hacerlo en el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune heure n’est définie : à vous de la placer dans la journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके लिए कोई समय तय नहीं है, इसलिए आप इसे दिन में कभी भी कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻が設定されていないので、一日のどこに入れるかはあなた次第です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há horário definido, então você decide quando encaixar no dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время не задано, так что вы сами решаете, когда этим заняться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它没有设定时间，你可以自由安排在一天中的任何时候。"
          }
        }
      }
    },
