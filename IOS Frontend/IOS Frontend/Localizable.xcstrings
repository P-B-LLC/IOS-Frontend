    "Drag to change the order. Logged sets and your rest timer are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لتغيير الترتيب. تبقى المجموعات المسجّلة ومؤقت الراحة كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um die Reihenfolge zu ändern. Erfasste Sätze und dein Pausentimer bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para cambiar el orden. Se conservan las series registradas y tu temporizador de descanso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour changer l’ordre. Les séries notées et votre minuteur de repos sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रम बदलने के लिए ड्रैग करें। लॉग किए गए सेट और आपका आराम टाइमर बने रहते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして順番を変更します。記録済みのセットと休息タイマーはそのまま残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para mudar a ordem. As séries registradas e o timer de descanso são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы изменить порядок. Записанные подходы и таймер отдыха сохранятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以更改顺序。已记录的组和休息计时器会保留。"
          }
        }
      }
    },
    "Drag to change the order. Sets, rests and supersets move with each exercise." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لتغيير الترتيب. تنتقل المجموعات وفترات الراحة والمجموعات المتتالية مع كل حركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um die Reihenfolge zu ändern. Sätze, Pausen und Supersätze wandern mit jeder Übung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para cambiar el orden. Las series, los descansos y las superseries se mueven con cada ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour changer l’ordre. Les séries, les repos et les superséries suivent chaque exercice."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रम बदलने के लिए ड्रैग करें। सेट, आराम और सुपरसेट हर एक्सरसाइज़ के साथ चलते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして順番を変更します。セット、休息、スーパーセットは各種目と一緒に移動します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para mudar a ordem. Séries, descansos e superséries acompanham cada exercício."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы изменить порядок. Подходы, отдых и суперсеты перемещаются вместе с упражнением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以更改顺序。组、休息时间和超级组会随动作一起移动。"
          }
        }
      }
    },
    "Drag to move, pinch to zoom." : {
