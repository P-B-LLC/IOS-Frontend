    "Camera access is restricted on this device. You can still choose from your camera roll." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الكاميرا مقيّد على هذا الجهاز. لا يزال بإمكانك الاختيار من ألبوم الكاميرا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff ist auf diesem Gerät eingeschränkt. Du kannst trotzdem aus deiner Mediathek wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está restringido en este dispositivo. Aún puedes elegir de tu carrete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à l’appareil photo est restreint sur cet appareil. Vous pouvez toujours choisir dans votre pellicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर कैमरा एक्सेस प्रतिबंधित है। आप फिर भी अपने कैमरा रोल से चुन सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではカメラへのアクセスが制限されています。カメラロールからは選択できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera está restrito neste dispositivo. Você ainda pode escolher do rolo da câmera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере на этом устройстве ограничен. Вы всё равно можете выбрать из медиатеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备限制了相机访问。你仍可以从相册中选择。"
          }
        }
      }
    },
    "Camera capture is unavailable here. Choose a photo or video from your camera roll." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الالتقاط بالكاميرا غير متاح هنا. اختر صورة أو فيديو من ألبوم الكاميرا."
          }
        },
        "de" : {
          "stringUnit" : {
