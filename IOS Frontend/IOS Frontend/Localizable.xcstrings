    "Build a draft, review its balance, then apply it when it feels right." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مسودة، وراجع توازنها، ثم طبّقها عندما تشعر أنها مناسبة."
          }
        },
        "de" : {
          "stringUnit" : {
