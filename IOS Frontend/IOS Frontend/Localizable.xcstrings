          "stringUnit" : {
            "state" : "translated",
            "value" : "स्किप करने के लिए दो बार टैप करें। नए सिरे से शुरू करने के लिए दबाकर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップでスキップ。長押しでやり直します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para pular. Mantenha pressionado para reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь дважды, чтобы пропустить. Удерживайте, чтобы перезапустить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点两下以跳过。按住可重新开始。"
          }
        }
      }
    },
