    "Your swimming is still timed and saved — it just won't have a map or a measured distance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال السباحة تُوقَّت وتُحفظ — فقط لن تكون لها خريطة أو مسافة مقيسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit deines Schwimmens wird trotzdem gemessen und gespeichert — nur ohne Karte und gemessene Distanz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu natación se sigue cronometrando y guardando — solo que no tendrá mapa ni distancia medida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre séance de natation est toujours chronométrée et enregistrée — simplement sans carte ni distance mesurée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी तैराकी का समय फिर भी गिना और सेव किया जाएगा — बस उसमें नक्शा या मापी गई दूरी नहीं होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイミングは引き続き計測・保存されます — 地図と計測距離が記録されないだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua natação continua sendo cronometrada e salva — só não terá mapa nem distância medida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплыв всё равно засекается и сохраняется — просто без карты и измеренной дистанции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的游泳仍会计时并保存——只是不会有地图或测得的距离。"
          }
        }
      }
    },
    "Your top set and total volume go out with the workout." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُشارك أفضل مجموعة لك والحجم الإجمالي مع التمرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Top-Satz und das Gesamtvolumen werden mit dem Workout geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mejor serie y tu volumen total se comparten con el entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre meilleure série et le volume total sont partagés avec l’entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका सबसे भारी सेट और कुल वॉल्यूम वर्कआउट के साथ शेयर होंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トップセットと総ボリュームはワークアウトと一緒に共有されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua melhor série e o volume total são compartilhados com o treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместе с тренировкой публикуются лучший подход и общий объём."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的最佳组和总训练量会随训练一起发布。"
          }
        }
      }
    },
    "Your training plan for this day is open" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
