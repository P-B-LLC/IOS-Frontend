    "The cycle counts from %@. After that it repeats every %lld days, which means it will not land on the same weekday twice." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تبدأ الدورة العدّ من %1$@. بعد ذلك تتكرر كل %2$lld أيام، ما يعني أنها لن تقع في يوم الأسبوع نفسه مرتين."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تبدأ الدورة العدّ من %1$@. بعد ذلك تتكرر كل %2$lld يومًا، ما يعني أنها لن تقع في يوم الأسبوع نفسه مرتين."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تبدأ الدورة العدّ من %1$@. بعد ذلك تتكرر كل يوم، ما يعني أنها لن تقع في يوم الأسبوع نفسه مرتين."
                }
              },
