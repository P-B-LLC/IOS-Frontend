    "You actually want the spot, not a lift-off" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تريد المساندة فعلًا، لا مساعدة في رفع البار"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du willst eigentlich Hilfestellung, nicht nur Hilfe beim Ausheben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verdad quieres asistencia, no solo ayuda para sacar la barra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous voulez vraiment qu’on vous pare, pas qu’on soulève à votre place"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको सच में स्पॉट चाहिए, लिफ़्ट-ऑफ़ नहीं"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リフトオフではなく、本当に補助が必要なとき"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você quer ajuda de verdade, não só para tirar a barra do suporte"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вам правда нужна страховка, а не помощь со снятием штанги"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你真正需要的是保护，而不是帮忙起杠"
          }
        }
      }
    },
    "You appear to be offline. Check your connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أنك غير متصل بالإنترنت. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du scheinst offline zu sein. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que no tienes conexión. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez être hors ligne. Vérifiez votre connexion et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगता है आप ऑफ़लाइन हैं। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインのようです。接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está offline. Verifique sua conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, нет подключения к интернету. Проверьте подключение и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你似乎处于离线状态。请检查网络连接后重试。"
          }
        }
      }
    },
    "You can also type the number printed under the barcode." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك أيضًا كتابة الرقم المطبوع أسفل الرمز الشريطي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst auch die unter dem Barcode gedruckte Nummer eingeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also type the number printed under the barcode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes escribir el número que aparece debajo del código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi saisir le numéro imprimé sous le code-barres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बारकोड के नीचे लिखा नंबर भी डाल सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーコードの下に印刷された番号を入力することもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também pode digitar o número impresso abaixo do código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно также ввести номер, напечатанный под штрихкодом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以输入条形码下方印刷的数字。"
          }
        }
      }
    },
    "You can always reorder, edit, or add more later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك دائمًا إعادة الترتيب أو التعديل أو إضافة المزيد لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst später jederzeit neu anordnen, bearbeiten oder mehr hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre puedes reordenar, editar o agregar más después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez toujours réorganiser, modifier ou en ajouter plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बाद में कभी भी क्रम बदल सकते हैं, संपादित कर सकते हैं या और जोड़ सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "並べ替え、編集、追加は後からいつでもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sempre pode reordenar, editar ou adicionar mais depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позже всегда можно изменить порядок, отредактировать или добавить ещё."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你随时可以稍后重新排序、编辑或添加更多。"
