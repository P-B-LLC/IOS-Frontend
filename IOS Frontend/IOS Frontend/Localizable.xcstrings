    "Your workout is saved on this device until sync completes. If its session is open, tap Finish there to retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمرينك محفوظ على هذا الجهاز حتى تكتمل المزامنة. إذا كانت جلسته مفتوحة، فاضغط «إنهاء» هناك لإعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Workout wird auf diesem Gerät gespeichert, bis die Synchronisierung abgeschlossen ist. Wenn seine Einheit geöffnet ist, tippe dort auf „Beenden“, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento se guarda en este dispositivo hasta que se complete la sincronización. Si su sesión está abierta, toca Terminar ahí para reintentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre entraînement est enregistré sur cet appareil jusqu’à la fin de la synchronisation. Si sa séance est ouverte, touchez Terminer pour réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक पूरा होने तक आपका वर्कआउट इस डिवाइस पर सेव है। अगर उसका सेशन खुला है, तो फिर से कोशिश करने के लिए वहाँ ‘पूरा करें’ पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期が完了するまで、ワークアウトはこのデバイスに保存されます。セッションが開いている場合は、そこで「終了」をタップして再試行してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu treino fica salvo neste dispositivo até a sincronização terminar. Se a sessão estiver aberta, toque em Finalizar nela para tentar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировка хранится на этом устройстве до завершения синхронизации. Если её занятие открыто, нажмите там «Завершить», чтобы повторить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步完成前，你的训练会保存在此设备上。如果该训练仍在进行中，请在那里轻点“完成”以重试。"
          }
        }
      }
    },
    "Your workout is saved, but its plan could not be updated. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ تمرينك، لكن تعذّر تحديث خطته. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Workout ist gespeichert, aber sein Plan konnte nicht aktualisiert werden. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento se guardó, pero no se pudo actualizar su plan. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre entraînement est enregistré, mais son plan n’a pas pu être mis à jour. %@"
