    "Allow safety review for this account? Your choice is saved; you can withdraw it in Settings under Safety review." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تسمح بمراجعة السلامة لهذا الحساب؟ سيتم حفظ اختيارك؛ ويمكنك سحبه من الإعدادات ضمن «مراجعة السلامة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheitsprüfung für dieses Konto erlauben? Deine Wahl wird gespeichert; du kannst sie in den Einstellungen unter „Sicherheitsprüfung“ widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir la revisión de seguridad para esta cuenta? Tu elección se guarda; puedes retirarla en Configuración, en Revisión de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l’examen de sécurité pour ce compte ? Votre choix est enregistré ; vous pouvez le retirer dans Réglages, sous Examen de sécurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस अकाउंट के लिए सुरक्षा समीक्षा की अनुमति दें? आपकी पसंद सेव हो जाती है; आप इसे सेटिंग्ज़ में ‘सुरक्षा समीक्षा’ के तहत वापस ले सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントの安全審査を許可しますか？選択は保存されます。「設定」の「安全審査」でいつでも取り消せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir a revisão de segurança para esta conta? Sua escolha fica salva; você pode retirá-la em Configurações, em Revisão de segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить проверку безопасности для этого аккаунта? Ваш выбор сохранится; отозвать его можно в Настройках в разделе «Проверка безопасности»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许对此账户进行安全审核吗？你的选择会被保存；你可以在“设置”的“安全审核”中撤回。"
          }
        }
      }
    },
