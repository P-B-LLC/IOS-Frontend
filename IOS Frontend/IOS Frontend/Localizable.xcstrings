    "EZ bar" : {
      "comment" : "Exercise equipment: a curl bar",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بار EZ"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SZ-Stange"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barra Z"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barre EZ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EZ बार"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EZバー"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barra W"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EZ-гриф"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲杆"
          }
        }
      }
    },
    "Each bar is one mile — shorter is faster. Even bars mean an evenly paced effort." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل عمود يمثل ميلًا واحدًا — الأقصر أسرع. الأعمدة المتساوية تعني جهدًا بوتيرة متوازنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Balken ist eine Meile — kürzer ist schneller. Gleich lange Balken bedeuten ein gleichmäßiges Tempo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada barra es una milla — más corta significa más rápida. Barras parejas indican un esfuerzo a ritmo constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque barre représente un mile — plus elle est courte, plus c’est rapide. Des barres égales signifient une allure régulière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर पट्टी एक मील दिखाती है — छोटी पट्टी यानी तेज़। बराबर पट्टियों का मतलब है एक जैसी पेस से की गई मेहनत।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各バーは1マイルを表し、短いほど速いことを示します。バーの長さがそろっていれば、均等なペースです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada barra é uma milha — mais curta é mais rápida. Barras parecidas indicam um ritmo constante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый столбик — одна миля: чем короче, тем быстрее. Ровные столбики означают равномерный темп."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每根柱条代表一英里——越短越快。柱条长短一致，说明配速均匀。"
          }
        }
      }
    },
    "Each logged session builds your training history. Keep a pace you can come back to." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل جلسة مسجّلة تبني سجل تدريبك. حافظ على وتيرة يمكنك العودة إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede erfasste Einheit erweitert deinen Trainingsverlauf. Halte ein Tempo, das du dauerhaft durchhältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sesión registrada construye tu historial de entrenamiento. Mantén un ritmo al que puedas volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque séance enregistrée enrichit votre historique d’entraînement. Gardez un rythme que vous pouvez tenir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर लॉग किया गया सेशन आपकी ट्रेनिंग हिस्ट्री बनाता है। ऐसी रफ़्तार रखें जिसे आप बनाए रख सकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録したセッションがトレーニング履歴を積み上げます。続けられるペースを保ちましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sessão registrada constrói seu histórico de treinos. Mantenha um ritmo ao qual você consiga voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое записанное занятие пополняет вашу историю тренировок. Держите темп, к которому сможете возвращаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次记录的训练都会积累你的训练历史。保持一个能坚持下去的节奏。"
          }
        }
      }
    },
