    "Easy movement. You could chat the whole time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة خفيفة. يمكنك الدردشة طوال الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lockere Bewegung. Du könntest die ganze Zeit plaudern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimiento suave. Podrías conversar todo el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouvement léger. Vous pourriez discuter tout du long."
          }
