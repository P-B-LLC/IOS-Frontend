    "Rytivo took too long to answer. Try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استغرق Rytivo وقتًا طويلًا للرد. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo hat zu lange für eine Antwort gebraucht. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo tardó demasiado en responder. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo a mis trop de temps à répondre. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo ने जवाब देने में बहुत समय लिया। फिर से कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivoの応答に時間がかかりすぎました。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo demorou demais para responder. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превышено время ожидания ответа от Rytivo. Повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo 响应超时。请重试。"
          }
        }
      }
    },
    "Rytivo uses your iPhone's language when it can. Choose another here, and it stays until you change it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Rytivo لغة جهاز iPhone عندما يكون ذلك ممكنًا. اختر لغة أخرى هنا، وستبقى حتى تغيّرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo verwendet nach Möglichkeit die Sprache deines iPhone. Wähle hier eine andere, und sie bleibt, bis du sie änderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo usa el idioma de tu iPhone cuando puede. Elige otro aquí y se mantendrá hasta que lo cambies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo utilise la langue de votre iPhone lorsque c’est possible. Choisissez-en une autre ici : elle restera jusqu’à ce que vous la changiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ संभव हो, Rytivo आपके iPhone की भाषा इस्तेमाल करता है। यहाँ कोई दूसरी भाषा चुनें, और वह तब तक रहेगी जब तक आप उसे बदल न दें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivoは可能な場合はiPhoneの言語を使用します。ここで別の言語を選ぶと、変更するまでその言語が使われます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo usa o idioma do seu iPhone sempre que possível. Escolha outro aqui, e ele será mantido até você mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo по возможности использует язык вашего iPhone. Выберите здесь другой — он сохранится, пока вы его не измените."
          }
        },
        "zh-Hans" : {
