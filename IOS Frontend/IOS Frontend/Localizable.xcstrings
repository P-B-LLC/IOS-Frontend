    "Notifications are off for Rytivo in iOS Settings, so the alert can’t sound while Rytivo is closed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة لـ Rytivo في إعدادات iOS، لذا لا يمكن أن يصدر التنبيه صوتًا عندما يكون Rytivo مغلقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen für Rytivo sind in den iOS-Einstellungen deaktiviert, daher kann der Hinweis nicht ertönen, solange Rytivo geschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Rytivo están desactivadas en Configuración de iOS, así que el aviso no puede sonar mientras Rytivo esté cerrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de Rytivo sont désactivées dans les Réglages iOS : l’alerte ne peut donc pas sonner quand Rytivo est fermé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS सेटिंग्ज़ में Rytivo के नोटिफ़िकेशन बंद हैं, इसलिए Rytivo बंद होने पर अलर्ट नहीं बज सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの「設定」でRytivoの通知がオフになっているため、Rytivoを閉じている間はアラートが鳴りません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações do Rytivo estão desativadas nos Ajustes do iOS, então o alerta não pode tocar enquanto o Rytivo estiver fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления для Rytivo отключены в Настройках iOS, поэтому сигнал не прозвучит, пока Rytivo закрыт."
          }
        },
        "zh-Hans" : {
