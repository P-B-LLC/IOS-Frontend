            "value" : "Relevez-la sur la machine si vous voulez l’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप इसे रिकॉर्ड करना चाहते हैं, तो मशीन पर देखकर दर्ज करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録したい場合は、マシンの表示を読み取って入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie o valor da máquina se quiser registrá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите на тренажёре, если хотите это записать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果想记录，请读取器械上的数值。"
          }
        }
      }
    },
    "Read-only access to steps and completed workouts. Rytivo never writes to Health." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصول للقراءة فقط إلى الخطوات والتمارين المكتملة. لا يكتب Rytivo أبدًا في صحتي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Lesezugriff auf Schritte und abgeschlossene Workouts. Rytivo schreibt nie in Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso de solo lectura a los pasos y los entrenamientos completados. Rytivo nunca escribe en Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès en lecture seule aux pas et aux entraînements terminés. Rytivo n’écrit jamais dans Santé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कदमों और पूरे किए गए वर्कआउट तक सिर्फ़ पढ़ने का एक्सेस। Rytivo स्वास्थ्य में कभी कुछ नहीं लिखता।"
