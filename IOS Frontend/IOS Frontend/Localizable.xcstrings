    "Search a food or brand, or scan the barcode on a packet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن طعام أو علامة تجارية، أو امسح الرمز الشريطي على العبوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche ein Lebensmittel oder eine Marke oder scanne den Barcode auf der Packung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search a food or brand, or scan the barcode on a packet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca un alimento o una marca, o escanea el código del envase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez un aliment ou une marque, ou scannez le code-barres d’un emballage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाद्य या ब्रांड खोजें, या पैकेट का बारकोड स्कैन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食品やブランドを検索するか、パッケージのバーコードをスキャンしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque um alimento ou marca, ou escaneie o código da embalagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите продукт или бренд либо отсканируйте штрихкод на упаковке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索食品或品牌，或扫描包装上的条形码。"
          }
        }
      }
    },
    "Search a name or @handle to find someone, or a #hashtag to explore posts." : {
