          }
        }
      }
    },
    "Build a recipe with its real ingredients and nutrition. Rytivo keeps the totals ready to reuse." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ وصفة بمكوّناتها وقيمها الغذائية الحقيقية. يحتفظ Rytivo بالإجماليات جاهزة لإعادة الاستخدام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein Rezept mit seinen echten Zutaten und Nährwerten. Rytivo hält die Summen zur Wiederverwendung bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una receta con sus ingredientes y su información nutricional reales. Rytivo guarda los totales listos para reutilizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une recette avec ses vrais ingrédients et valeurs nutritionnelles. Rytivo garde les totaux prêts à être réutilisés."
          }
