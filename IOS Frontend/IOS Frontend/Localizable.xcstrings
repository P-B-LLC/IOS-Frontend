          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово. Раздел «Для вас» снова начнёт учиться на ваших следующих действиях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成。“为你推荐”将根据你接下来的操作重新学习。"
          }
        }
      }
    },
    "Double-tap to skip. Hold for Restart." : {
