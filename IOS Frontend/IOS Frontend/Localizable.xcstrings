          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuentas bloqueadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptes bloqués"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लॉक किए गए अकाउंट"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロック中のアカウント"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas bloqueadas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированные аккаунты"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已屏蔽的账户"
          }
        }
      }
    },
    "Blocked people cannot see your posts, and you cannot see theirs. Blocking also removes any following between you, which lifting a block does not put back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن للأشخاص المحظورين رؤية منشوراتك، ولا يمكنك رؤية منشوراتهم. يزيل الحظر أيضًا أي متابعة بينكما، ولا يعيدها إلغاء الحظر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockierte Personen können deine Beiträge nicht sehen und du ihre nicht. Durch das Blockieren wird auch jedes gegenseitige Folgen beendet, und das Aufheben der Blockierung stellt es nicht wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas bloqueadas no pueden ver tus publicaciones, y tú no puedes ver las suyas. Bloquear también elimina cualquier seguimiento entre ustedes, y desbloquear no lo restablece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes bloquées ne peuvent pas voir vos publications, et vous ne voyez pas les leurs. Le blocage supprime aussi tout abonnement entre vous, et le déblocage ne le rétablit pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लॉक किए गए लोग आपकी पोस्ट नहीं देख सकते, और आप उनकी पोस्ट नहीं देख सकते। ब्लॉक करने से आपके बीच का फ़ॉलो भी हट जाता है, और ब्लॉक हटाने पर वह वापस नहीं आता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックした相手はあなたの投稿を見られず、あなたも相手の投稿を見られなくなります。ブロックするとお互いのフォローも解除され、ブロックを解除しても元には戻りません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas bloqueadas não podem ver suas publicações, e você não pode ver as delas. O bloqueio também desfaz qualquer relação de seguir entre vocês, que não volta quando o bloqueio é removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированные пользователи не видят ваших публикаций, а вы — их. Блокировка также отменяет взаимные подписки, и снятие блокировки их не восстанавливает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被屏蔽的人看不到你的帖子，你也看不到他们的帖子。屏蔽还会解除你们之间的关注关系，取消屏蔽后不会恢复。"
          }
        }
      }
    },
