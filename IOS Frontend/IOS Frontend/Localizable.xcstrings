    "Tap Reorder to drag exercises into a new order. Tap a set to change its kind." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على إعادة الترتيب لسحب الحركات إلى ترتيب جديد. اضغط على مجموعة لتغيير نوعها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Neu anordnen“, um Übungen in eine neue Reihenfolge zu ziehen. Tippe auf einen Satz, um seine Art zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Reordenar para arrastrar los ejercicios a un nuevo orden. Toca una serie para cambiar su tipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Réorganiser pour faire glisser les exercices dans un nouvel ordre. Touchez une série pour changer son type."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्सरसाइज़ को नए क्रम में ड्रैग करने के लिए क्रम बदलें पर टैप करें। किसी सेट का प्रकार बदलने के लिए उस पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「順番を変更」をタップすると、種目をドラッグして並べ替えられます。セットをタップすると種類を変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Reordenar para arrastar os exercícios para uma nova ordem. Toque em uma série para mudar o tipo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Изменить порядок», чтобы перетащить упражнения. Коснитесь подхода, чтобы изменить его тип."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“重新排序”可拖动动作调整顺序。轻点某一组可更改其类型。"
          }
        }
      }
    },
    "Tap a day" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على يوم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Tag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un día"
          }
        },
        "fr" : {
