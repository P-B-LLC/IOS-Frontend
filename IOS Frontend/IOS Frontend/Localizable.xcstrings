    "Reconnect before finishing this workout." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد الاتصال قبل إنهاء هذا التمرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell die Verbindung wieder her, bevor du dieses Workout beendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectarte antes de terminar este entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez-vous avant de terminer cet entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वर्कआउट पूरा करने से पहले फिर से कनेक्ट करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このワークアウトを終了する前に再接続してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconecte-se antes de finalizar este treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переподключитесь, прежде чем завершать тренировку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先重新连接，再完成此训练。"
          }
        }
      }
    },
    "Reconnect to delete this workout. Nothing has been deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد الاتصال لحذف هذا التمرين. لم يُحذف أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle die Verbindung wieder her, um dieses Workout zu löschen. Es wurde nichts gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectarte para eliminar este entrenamiento. No se eliminó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
