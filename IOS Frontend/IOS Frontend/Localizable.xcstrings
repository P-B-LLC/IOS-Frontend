    "Your unit could not be saved. Try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ الوحدة. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Einheit konnte nicht gespeichert werden. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar tu unidad. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer votre unité. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी यूनिट सेव नहीं हो सकी। फिर से कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単位を保存できませんでした。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar sua unidade. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить единицу. Повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存你的单位。请重试。"
          }
        }
      }
    },
    "Your viewing history is deleted, and your past likes, comments and saves stop shaping For You. They stay on your posts and your profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحذف سجل مشاهداتك، وتتوقف إعجاباتك وتعليقاتك وعمليات الحفظ السابقة عن التأثير على «مقترحات لك». وتبقى على منشوراتك وملفك الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ansichtsverlauf wird gelöscht, und deine bisherigen Likes, Kommentare und Speicherungen beeinflussen „Für dich“ nicht mehr. Sie bleiben in deinen Beiträgen und deinem Profil erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimina tu historial de visualización, y tus me gusta, comentarios y guardados anteriores dejan de influir en Para ti. Se quedan en tus publicaciones y tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique de consultation est supprimé, et vos anciennes mentions J’aime, commentaires et enregistrements n’influencent plus Pour vous. Ils restent sur vos publications et votre profil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी देखने की हिस्ट्री डिलीट हो जाती है, और आपके पिछले लाइक, कमेंट और सेव ‘आपके लिए’ पर असर डालना बंद कर देते हैं। वे आपकी पोस्ट और प्रोफ़ाइल पर बने रहते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閲覧履歴が削除され、過去の「いいね」、コメント、保存が「おすすめ」に反映されなくなります。これらは投稿やプロフィールには残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico de visualização é apagado, e suas curtidas, comentários e itens salvos anteriores deixam de influenciar o Para Você. Eles continuam nas suas publicações e no seu perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История просмотров удаляется, и ваши прошлые лайки, комментарии и сохранения больше не влияют на раздел «Для вас». Они остаются в публикациях и в вашем профиле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的浏览记录将被删除，过去的点赞、评论和收藏将不再影响“为你推荐”。它们仍会保留在你的帖子和个人主页上。"
          }
        }
      }
    },
