    "Please don’t include passwords, contact details, or other unnecessary personal information." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرجى عدم تضمين كلمات المرور أو بيانات الاتصال أو أي معلومات شخصية أخرى غير ضرورية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte gib keine Passwörter, Kontaktdaten oder andere unnötige persönliche Informationen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No incluyas contraseñas, datos de contacto ni otra información personal innecesaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’incluez pas de mots de passe, de coordonnées ni d’autres informations personnelles inutiles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कृपया पासवर्ड, संपर्क जानकारी या कोई अन्य गैर-ज़रूरी निजी जानकारी शामिल न करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード、連絡先、その他の不要な個人情報は含めないでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não inclua senhas, dados de contato ou outras informações pessoais desnecessárias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не указывайте пароли, контактные данные и другую лишнюю личную информацию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请勿包含密码、联系方式或其他不必要的个人信息。"
          }
        }
      }
    },
    "Please retry the previous food first so we can confirm whether it saved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرجى إعادة محاولة الطعام السابق أولًا حتى نتأكد مما إذا كان قد حُفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte versuche zuerst das vorherige Lebensmittel erneut, damit wir bestätigen können, ob es gespeichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero vuelve a intentar con el alimento anterior para que podamos confirmar si se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez d’abord réessayer l’aliment précédent pour que nous puissions vérifier s’il a été enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कृपया पहले पिछला खाना फिर से आज़माएँ, ताकि हम पुष्टि कर सकें कि वह सेव हुआ या नहीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたかどうかを確認できるよう、まず前の食品を再試行してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro tente de novo o alimento anterior para confirmarmos se ele foi salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала повторите добавление предыдущего продукта, чтобы мы могли проверить, сохранился ли он."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
