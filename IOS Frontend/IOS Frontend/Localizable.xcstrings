    "Manage safety review for content you share. Processing details are in the Privacy Policy you accepted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدر مراجعة السلامة للمحتوى الذي تشاركه. تفاصيل المعالجة موجودة في سياسة الخصوصية التي وافقت عليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalte die Sicherheitsprüfung für Inhalte, die du teilst. Details zur Verarbeitung findest du in der Datenschutzerklärung, die du akzeptiert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administra la revisión de seguridad del contenido que compartes. Los detalles del tratamiento están en la Política de privacidad que aceptaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez l’examen de sécurité du contenu que vous partagez. Les détails du traitement figurent dans la Politique de confidentialité que vous avez acceptée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो कंटेंट शेयर करते हैं, उसकी सुरक्षा समीक्षा प्रबंधित करें। प्रोसेसिंग की जानकारी उस गोपनीयता नीति में है जिसे आपने स्वीकार किया है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有するコンテンツの安全審査を管理します。処理の詳細は、同意済みのプライバシーポリシーに記載されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerencie a revisão de segurança do conteúdo que você compartilha. Os detalhes do processamento estão na Política de Privacidade que você aceitou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляйте проверкой безопасности для контента, которым вы делитесь. Подробности обработки — в принятой вами Политике конфиденциальности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理你所分享内容的安全审核。处理详情请参阅你已接受的隐私政策。"
          }
        }
      }
    },
