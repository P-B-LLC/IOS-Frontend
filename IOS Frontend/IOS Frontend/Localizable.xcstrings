        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepta la Política de privacidad y los acuerdos para crear tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez accepter la Politique de confidentialité et les conditions pour créer votre compte."
