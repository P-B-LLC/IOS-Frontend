    "Timing your biking — end the session to save it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ توقيت ركوب الدراجة — أنهِ الجلسة لحفظها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitmessung fürs Radfahren läuft — beende die Einheit, um sie zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronometrando tu recorrido en bici — termina la sesión para guardarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronométrage de votre sortie à vélo — terminez la séance pour l’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी साइकिलिंग का समय गिना जा रहा है — सेव करने के लिए सेशन खत्म करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイクリングを計測中 — セッションを終了すると保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronometrando seu ciclismo — encerre a sessão para salvá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идёт отсчёт времени заезда — завершите занятие, чтобы сохранить его."
