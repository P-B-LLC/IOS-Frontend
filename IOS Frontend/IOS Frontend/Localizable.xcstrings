    "Add the accounts you want on your profile. Paste a link, or just type your handle and we will work out the address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف الحسابات التي تريدها في ملفك الشخصي. الصق رابطًا، أو اكتب اسم المستخدم فقط وسنتولى معرفة العنوان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Konten hinzu, die in deinem Profil erscheinen sollen. Füge einen Link ein oder gib einfach deinen Benutzernamen ein, und wir ermitteln die Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega las cuentas que quieras en tu perfil. Pega un enlace o simplemente escribe tu usuario y nosotros averiguamos la dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les comptes que vous souhaitez afficher sur votre profil. Collez un lien, ou saisissez simplement votre pseudo et nous trouverons l’adresse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे अकाउंट जोड़ें जिन्हें आप अपनी प्रोफ़ाइल पर दिखाना चाहते हैं। लिंक पेस्ट करें, या बस अपना हैंडल टाइप करें और पता हम खुद बना लेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールに載せたいアカウントを追加してください。リンクを貼り付けるか、ユーザー名を入力するだけで、こちらでアドレスを特定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as contas que você quer no seu perfil. Cole um link ou apenas digite seu nome de usuário e nós descobrimos o endereço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте аккаунты, которые хотите показать в профиле. Вставьте ссылку или просто введите имя пользователя — адрес мы определим сами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加你想在个人主页上展示的账号。粘贴链接，或直接输入用户名，我们会自动补全地址。"
          }
        }
      }
    },
