    "Choose a workout that fits today. A lighter day or a rest day belongs in your plan, too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر تمرينًا يناسب اليوم. اليوم الأخف أو يوم الراحة جزء من خطتك أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Workout, das zu heute passt. Ein leichterer Tag oder ein Ruhetag gehört auch zu deinem Plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un entrenamiento que encaje con hoy. Un día más ligero o un día de descanso también forman parte de tu plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un entraînement adapté à aujourd’hui. Une journée plus légère ou un jour de repos ont aussi leur place dans votre plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज के हिसाब से वर्कआउट चुनें। हल्का दिन या आराम का दिन भी आपके प्लान का हिस्सा है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日に合ったワークアウトを選びましょう。軽めの日や休息日も、プランの一部です。"
