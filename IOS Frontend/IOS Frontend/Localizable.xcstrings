    "Signing in with Apple or Google is coming. Your account will link to one when it does." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول باستخدام Apple أو Google قادم قريبًا. سيرتبط حسابك بأحدهما عند توفره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung mit Apple oder Google kommt bald. Dein Konto wird dann damit verknüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto podrás iniciar sesión con Apple o Google. Cuando eso pase, tu cuenta se vinculará con una de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion avec Apple ou Google arrive bientôt. Votre compte pourra alors y être associé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple या Google से साइन इन जल्द आ रहा है। तब आपका अकाउंट उनमें से किसी एक से लिंक हो जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleまたはGoogleでのサインインは近日対応予定です。対応時には、アカウントがいずれかに連携されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em breve será possível entrar com a Apple ou o Google. Quando isso acontecer, sua conta será vinculada a um deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скоро появится вход через Apple или Google. Когда это случится, ваш аккаунт будет связан с одним из них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将支持通过 Apple 或 Google 登录。届时你的账户将与其中之一关联。"
          }
        }
      }
    },
