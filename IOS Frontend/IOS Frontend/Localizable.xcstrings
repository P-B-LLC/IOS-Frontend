    },
    "Typing a weight or reps does not save the set. Tap Log at the end of a row to record it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كتابة الوزن أو التكرارات لا تحفظ المجموعة. اضغط «تسجيل» في نهاية الصف لتسجيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Eintippen von Gewicht oder Wiederholungen speichert den Satz nicht. Tippe am Ende einer Zeile auf „Erfassen“, um ihn aufzuzeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir un peso o repeticiones no guarda la serie. Toca Registrar al final de una fila para guardarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisir un poids ou des répétitions n’enregistre pas la série. Touchez Noter en bout de ligne pour l’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न या रेप्स टाइप करने से सेट सेव नहीं होता। उसे रिकॉर्ड करने के लिए लाइन के आखिर में ‘लॉग करें’ पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重量や回数を入力しただけではセットは保存されません。行の最後にある「記録」をタップして記録してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitar o peso ou as repetições não salva a série. Toque em Registrar no fim da linha para registrá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ввод веса или повторений не сохраняет подход. Нажмите «Записать» в конце строки, чтобы записать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入重量或次数不会保存该组。轻点行末的“记录”即可记录。"
          }
        }
      }
    },
