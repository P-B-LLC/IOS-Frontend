    },
    "A training partner should never" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريك التدريب يجب ألّا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Trainingspartner sollte niemals"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compañero de entrenamiento nunca debería"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un partenaire d’entraînement ne devrait jamais"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रेनिंग पार्टनर को कभी नहीं करना चाहिए"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
