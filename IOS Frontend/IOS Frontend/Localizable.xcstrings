    "Only moderators can read your report. It is not sent to the automated safety provider." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يطّلع على بلاغك سوى المشرفين. ولا يُرسَل إلى مزوّد السلامة الآلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Moderatoren können deine Meldung lesen. Sie wird nicht an den automatisierten Sicherheitsanbieter gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los moderadores pueden leer tu reporte. No se envía al proveedor de seguridad automatizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les modérateurs peuvent lire votre signalement. Il n’est pas envoyé au prestataire de sécurité automatisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रिपोर्ट सिर्फ़ मॉडरेटर पढ़ सकते हैं। इसे ऑटोमेटेड सुरक्षा प्रदाता को नहीं भेजा जाता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告はモデレーターだけが閲覧できます。自動安全審査の提供元には送信されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente moderadores podem ler sua denúncia. Ela não é enviada ao provedor automatizado de segurança."
          }
