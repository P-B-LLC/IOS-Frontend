    "Your Rytivo server doesn’t store effort yet. Update the server, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خادم Rytivo لديك لا يخزّن الجهد بعد. حدّث الخادم، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
