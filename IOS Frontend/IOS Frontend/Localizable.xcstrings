    "This is the goal your dashboard counts against." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا هو الهدف الذي تقيس عليه لوحتك."
          }
        },
        "de" : {
