    "Live estimate · your distance, pace, climb and splits are measured from the full track when you end the session" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير مباشر · تُقاس المسافة والوتيرة والصعود والمقاطع من المسار الكامل عند إنهاء الجلسة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Schätzung · Distanz, Pace, Höhenmeter und Zwischenzeiten werden beim Beenden der Einheit aus der gesamten Strecke berechnet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación en vivo · tu distancia, ritmo, desnivel y parciales se calculan a partir del recorrido completo cuando terminas la sesión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation en direct · votre distance, votre allure, votre dénivelé et vos temps intermédiaires sont calculés à partir du tracé complet à la fin de la séance"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव अनुमान · सेशन खत्म करने पर आपकी दूरी, पेस, चढ़ाई और स्प्लिट पूरे ट्रैक से मापे जाते हैं"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ推定 · 距離、ペース、獲得標高、スプリットは、セッション終了時にルート全体から計測されます"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa ao vivo · distância, ritmo, subida e parciais são calculados com o trajeto completo quando você encerra a sessão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительная оценка · дистанция, темп, набор высоты и сплиты рассчитываются по полному треку, когда вы завершите занятие"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时估算 · 结束训练后，你的距离、配速、爬升和分段将根据完整轨迹计算"
          }
        }
      }
    },
