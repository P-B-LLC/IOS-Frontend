        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias. Tu reporte del comentario se envió a nuestros moderadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci. Votre signalement de commentaire a été envoyé à nos modérateurs."
