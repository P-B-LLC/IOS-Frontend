    "Nothing here yet. Add a prompt or feature a lift so people know who they are following." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء هنا بعد. أضف سؤالًا أو اعرض رفعة ليعرف الناس من يتابعون."
          }
        },
        "de" : {
          "stringUnit" : {
