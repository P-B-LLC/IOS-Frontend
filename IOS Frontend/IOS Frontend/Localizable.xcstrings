    "Precise Location is off, so this route cannot be mapped. Turn it on in Settings, Privacy & Security, Location Services, Rytivo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع الدقيق متوقف، لذا لا يمكن رسم هذا المسار. فعّله من الإعدادات > الخصوصية والأمن > خدمات الموقع > Rytivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauer Standort ist deaktiviert, daher kann diese Route nicht auf der Karte dargestellt werden. Aktiviere ihn unter Einstellungen, Datenschutz & Sicherheit, Ortungsdienste, Rytivo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación exacta está desactivada, así que no se puede trazar esta ruta. Actívala en Configuración, Privacidad y seguridad, Servicios de ubicación, Rytivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position exacte est désactivée : cet itinéraire ne peut pas être tracé. Activez-la dans Réglages, Confidentialité et sécurité, Service de localisation, Rytivo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सटीक स्थान बंद है, इसलिए यह रूट मैप नहीं किया जा सकता। इसे सेटिंग्ज़, गोपनीयता और सुरक्षा, स्थान सेवाएँ, Rytivo में चालू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確な位置情報がオフのため、このルートを地図に表示できません。「設定」>「プライバシーとセキュリティ」>「位置情報サービス」>「Rytivo」でオンにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Localização Exata está desativada, então este trajeto não pode ser mapeado. Ative-a em Ajustes, Privacidade e Segurança, Serviços de Localização, Rytivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная геопозиция выключена, поэтому маршрут нельзя нанести на карту. Включите её в разделе «Настройки» > «Конфиденциальность и безопасность» > «Службы геолокации» > Rytivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“精确位置”已关闭，因此无法绘制此路线。请前往“设置”>“隐私与安全性”>“定位服务”>“Rytivo”打开。"
          }
        }
      }
    },
    "Prepares you. Left out of records and progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يهيّئك. لا يُحتسب ضمن الأرقام القياسية والتقدّم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereitet dich vor. Zählt nicht für Rekorde und Fortschritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te prepara. No cuenta para récords ni progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous prépare. Non compté dans les records et la progression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको तैयार करता है। रिकॉर्ड और प्रगति में नहीं गिना जाता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体を準備します。自己ベストと進捗には含まれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara você. Não conta para recordes e progresso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подготавливает. Не учитывается в рекордах и прогрессе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帮助你热身。不计入纪录和进度。"
          }
        }
      }
    },
