    "Saved \"%@\" to your meals — %@." : {
      "comment" : "The second placeholder is a count, e.g. 3 items or 4 exercises",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ «%1$@» في وجباتك — %2$@."
          }
        },
        "de" : {
