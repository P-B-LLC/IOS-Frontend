    "Start with a photo or video. Add your caption, then connect it to your meal, workout, or day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بصورة أو فيديو. أضف وصفك، ثم اربطه بوجبتك أو تمرينك أو يومك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit einem Foto oder Video. Füge deine Bildunterschrift hinzu und verknüpfe es dann mit deiner Mahlzeit, deinem Workout oder deinem Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una foto o un video. Agrega tu descripción y luego vincúlala con tu comida, tu entrenamiento o tu día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par une photo ou une vidéo. Ajoutez votre légende, puis associez-la à votre repas, votre entraînement ou votre journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी फ़ोटो या वीडियो से शुरू करें। अपना कैप्शन जोड़ें, फिर उसे अपने भोजन, वर्कआउट या दिन से जोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真か動画から始めましょう。キャプションを加えて、食事、ワークアウト、または一日と関連付けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com uma foto ou vídeo. Adicione sua legenda e depois vincule à sua refeição, treino ou dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с фото или видео. Добавьте подпись, затем свяжите публикацию с приёмом пищи, тренировкой или днём."
          }
        },
        "zh-Hans" : {
