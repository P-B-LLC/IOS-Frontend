    "Add a bike and every ride you tag with it adds to its mileage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف دراجة، وكل جولة تربطها بها تُضاف إلى مسافتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Fahrrad hinzu, und jede Fahrt, die du damit markierst, zählt zu seiner Laufleistung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega una bici y cada recorrido que etiquetes con ella se sumará a su kilometraje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un vélo, et chaque sortie à laquelle vous l’associez s’ajoute à sa distance cumulée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइकिल जोड़ें, और जिस भी राइड में आप उसे टैग करेंगे, उसकी दूरी उसके माइलेज में जुड़ जाएगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイクを追加すると、そのバイクをタグ付けしたライドの距離が走行距離に加算されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma bicicleta e cada pedalada marcada com ela soma à quilometragem dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте велосипед, и каждый заезд, отмеченный им, будет прибавляться к его пробегу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加一辆自行车，你标记它的每次骑行都会计入它的里程。"
          }
        }
      }
    },
