    "Keep complete meals here, then place them into any day without rebuilding them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بالوجبات الكاملة هنا، ثم ضعها في أي يوم دون إعادة إنشائها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre hier komplette Mahlzeiten auf und füge sie dann jedem beliebigen Tag hinzu, ohne sie neu zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda aquí comidas completas y luego colócalas en cualquier día sin volver a armarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez ici des repas complets, puis placez-les sur n’importe quel jour sans les recomposer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे भोजन यहाँ रखें, फिर उन्हें दोबारा बनाए बिना किसी भी दिन में रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成した食事をここに保存しておけば、作り直さずにどの日にでも配置できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde refeições completas aqui e coloque-as em qualquer dia sem precisar montá-las de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните здесь готовые блюда и добавляйте их в любой день, не собирая заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将完整的餐食保存在这里，之后无需重新搭配即可放入任意一天。"
