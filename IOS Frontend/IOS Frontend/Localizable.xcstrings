    "Safety review is disabled for your account. Manage it in Settings before sharing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مراجعة السلامة معطّلة لحسابك. أدرها من الإعدادات قبل المشاركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherheitsprüfung ist für dein Konto deaktiviert. Verwalte sie in den Einstellungen, bevor du etwas teilst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La revisión de seguridad está desactivada para tu cuenta. Adminístrala en Configuración antes de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’examen de sécurité est désactivé pour votre compte. Gérez-le dans Réglages avant de partager."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अकाउंट के लिए सुरक्षा समीक्षा बंद है। शेयर करने से पहले इसे सेटिंग्ज़ में प्रबंधित करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのアカウントでは安全審査が無効になっています。シェアする前に「設定」で管理してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A revisão de segurança está desativada para sua conta. Gerencie em Configurações antes de compartilhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка безопасности для вашего аккаунта выключена. Перед публикацией измените это в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账户已停用安全审核。请先在“设置”中管理，再进行分享。"
          }
        }
      }
    },
