        }
      }
    },
    "Your workout was saved, but could not be confirmed on this day. Retry to reload it safely." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ تمرينك، لكن تعذّر تأكيده في هذا اليوم. أعد المحاولة لإعادة تحميله بأمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Workout wurde gespeichert, konnte aber für diesen Tag nicht bestätigt werden. Versuche es erneut, um es sicher neu zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento se guardó, pero no se pudo confirmar en este día. Reintenta para volver a cargarlo de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre entraînement a été enregistré, mais n’a pas pu être confirmé pour ce jour. Réessayez pour le recharger en toute sécurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका वर्कआउट सेव हो गया, लेकिन इस दिन पर उसकी पुष्टि नहीं हो सकी। उसे सुरक्षित रूप से फिर से लोड करने के लिए फिर से कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトは保存されましたが、この日の予定として確認できませんでした。再試行して安全に再読み込みしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu treino foi salvo, mas não foi possível confirmá-lo neste dia. Tente novamente para recarregá-lo com segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировка сохранена, но подтвердить её на этот день не удалось. Повторите попытку, чтобы безопасно загрузить её заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的训练已保存，但无法在这一天确认。请重试以安全地重新加载。"
          }
        }
      }
    },
    "Your workout was saved, but could not be confirmed. Retry to reload it safely." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ تمرينك، لكن تعذّر تأكيده. أعد المحاولة لإعادة تحميله بأمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Workout wurde gespeichert, konnte aber nicht bestätigt werden. Versuche es erneut, um es sicher neu zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento se guardó, pero no se pudo confirmar. Reintenta para volver a cargarlo de forma segura."
