    "Its replies go with it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف ردوده معه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Antworten werden ebenfalls entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus respuestas también se eliminarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses réponses seront aussi supprimées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके जवाब भी इसके साथ हट जाएँगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
