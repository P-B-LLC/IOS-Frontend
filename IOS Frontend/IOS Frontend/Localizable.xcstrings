    "Nutrition comes from your log. You choose what to say." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي القيم الغذائية من سجلك. وأنت تختار ما تقوله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nährwerte stammen aus deinem Protokoll. Was du dazu sagst, entscheidest du."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nutrición viene de tu registro. Tú eliges qué decir."
