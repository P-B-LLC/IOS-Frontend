            "value" : "आपका वर्कआउट सेव हो गया, लेकिन उसका प्लान अपडेट नहीं हो सका। %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトは保存されましたが、プランを更新できませんでした。%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu treino foi salvo, mas não foi possível atualizar o plano dele. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировка сохранена, но её план не удалось обновить. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的训练已保存，但无法更新其计划。%@"
