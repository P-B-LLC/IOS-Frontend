        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando itens de %@. Escolha Todos para ver o dia inteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показаны записи категории «%@». Выберите «Все», чтобы увидеть весь день."
