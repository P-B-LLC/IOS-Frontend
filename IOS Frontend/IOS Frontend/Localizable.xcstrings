    "Your biking is still timed and saved — it just won't have a map or a measured distance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال ركوب الدراجة يُوقَّت ويُحفظ — فقط لن تكون له خريطة أو مسافة مقيسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit deiner Radfahrt wird trotzdem gemessen und gespeichert — nur ohne Karte und gemessene Distanz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu recorrido en bici se sigue cronometrando y guardando — solo que no tendrá mapa ni distancia medida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sortie à vélo est toujours chronométrée et enregistrée — simplement sans carte ni distance mesurée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी साइकिलिंग का समय फिर भी गिना और सेव किया जाएगा — बस उसमें नक्शा या मापी गई दूरी नहीं होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイクリングは引き続き計測・保存されます — 地図と計測距離が記録されないだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu ciclismo continua sendo cronometrado e salvo — só não terá mapa nem distância medida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заезд всё равно засекается и сохраняется — просто без карты и измеренной дистанции."
