    "Choose a workout for each training day. Swipe a planned day to return it to rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر تمرينًا لكل يوم تدريب. اسحب يومًا مخططًا لإعادته إلى الراحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
