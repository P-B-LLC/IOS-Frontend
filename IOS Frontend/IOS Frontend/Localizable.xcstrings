    "You stay in control." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى أنت المتحكم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behältst die Kontrolle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú tienes el control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gardez le contrôle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नियंत्रण आपके हाथ में रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが管理できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
