    "Today is saved as you trained it. %@ stays as it was." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ تمرين اليوم كما أدّيته، ويبقى %@ كما كان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute wird so gespeichert, wie du trainiert hast. %@ bleibt, wie es war."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy se guarda tal como entrenaste. %@ se queda como estaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La séance du jour est enregistrée telle que vous l’avez faite. %@ reste inchangé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का वर्कआउट वैसे ही सेव होगा जैसे आपने किया। %@ पहले जैसा ही रहेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は実際に行った内容で保存されます。%@は変わりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje fica salvo do jeito que você treinou. %@ continua como estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодняшняя тренировка сохранится так, как вы её выполнили. %@ останется без изменений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天会按你实际的训练保存。%@ 保持不变。"
          }
        }
      }
    },
