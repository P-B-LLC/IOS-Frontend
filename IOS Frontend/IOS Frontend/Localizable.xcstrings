        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनकी प्रोफ़ाइल निजी है, इसलिए फिर से फ़ॉलो करने के लिए नया अनुरोध भेजना होगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のプロフィールは非公開のため、もう一度フォローするには新しいリクエストを送る必要があります。"
