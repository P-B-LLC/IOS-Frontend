            "value" : "يتم عرض عناصر «%@». اختر «الكل» لرؤية اليوم كاملًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angezeigt: Einträge der Kategorie „%@“. Wähle „Alle“, um den ganzen Tag zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando elementos de tipo %@. Elige Todo para ver el día completo."
