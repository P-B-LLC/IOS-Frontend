    "Foods you log will show up here so you can add them again in one tap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا الأطعمة التي تسجّلها لتتمكن من إضافتها مجددًا بضغطة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebensmittel, die du erfasst, erscheinen hier, damit du sie mit einem Tippen erneut hinzufügen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los alimentos que registres aparecerán aquí para que puedas agregarlos de nuevo con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les aliments que vous notez apparaîtront ici pour que vous puissiez les ajouter à nouveau d’un seul geste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो खाना लॉग करेंगे, वह यहाँ दिखेगा ताकि आप उसे एक टैप में फिर से जोड़ सकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録した食品はここに表示され、ワンタップで再び追加できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os alimentos que você registrar aparecerão aqui para você adicioná-los de novo com um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записанные продукты появятся здесь, чтобы их можно было снова добавить одним касанием."
