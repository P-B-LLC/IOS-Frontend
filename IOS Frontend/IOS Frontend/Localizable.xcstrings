          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Zurücksetzungsversuche. Warte eine Stunde und versuche es erneut -- und sieh in der Zwischenzeit in deinem Spam-Ordner nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados intentos de restablecimiento. Espera una hora e inténtalo de nuevo -- y mientras tanto revisa tu carpeta de correo no deseado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives de réinitialisation. Patientez une heure avant de réessayer -- et vérifiez vos spams en attendant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीसेट की बहुत ज़्यादा कोशिशें हो गईं। एक घंटा रुकें और फिर से कोशिश करें -- और इस बीच अपना स्पैम फ़ोल्डर देख लें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リセットの試行回数が多すぎます。1時間待ってからもう一度お試しください。その間に迷惑メールフォルダも確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas tentativas de redefinição. Aguarde uma hora e tente novamente -- e, enquanto isso, verifique sua pasta de spam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много попыток сброса. Подождите час и повторите попытку — а пока проверьте папку «Спам»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置尝试次数过多。请等待一小时后重试——同时检查一下你的垃圾邮件文件夹。"
          }
        }
      }
    },
