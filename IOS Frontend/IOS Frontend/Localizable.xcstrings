    "Blocked %@. You will not see each other's posts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حظر %@. لن يرى أي منكما منشورات الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blockiert. Ihr seht gegenseitig keine Beiträge mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueaste a %@. Ninguno de los dos verá las publicaciones del otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez bloqué %@. Vous ne verrez plus vos publications respectives."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को ब्लॉक किया गया। आप एक-दूसरे की पोस्ट नहीं देखेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんをブロックしました。お互いの投稿は表示されなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você bloqueou %@. Vocês não verão mais as publicações um do outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: пользователь заблокирован. Вы не будете видеть публикации друг друга."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已屏蔽 %@。你们将看不到彼此的帖子。"
          }
        }
      }
    },
    "Blocked accounts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحسابات المحظورة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
