    "Private measurements still support your personal goals and progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القياسات الخاصة تدعم أهدافك الشخصية وتقدمك مع ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Maße unterstützen trotzdem deine persönlichen Ziele und Fortschritte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las medidas privadas siguen sirviendo para tus metas personales y tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mensurations privées servent toujours vos objectifs et votre progression."
