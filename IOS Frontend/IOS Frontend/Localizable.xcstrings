          }
        }
      }
    },
    "Please review and accept our updated Privacy Policy and agreements to continue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرجى مراجعة سياسة الخصوصية والاتفاقيات المحدّثة وقبولها للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
