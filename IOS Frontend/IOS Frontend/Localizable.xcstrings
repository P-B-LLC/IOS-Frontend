    "Their profile is private, so following again means sending a new request." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفهم الشخصي خاص، لذا تتطلب متابعتهم مجددًا إرسال طلب جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil ist privat, daher musst du zum erneuten Folgen eine neue Anfrage senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su perfil es privado, así que para volver a seguir a esta persona deberás enviar una nueva solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
