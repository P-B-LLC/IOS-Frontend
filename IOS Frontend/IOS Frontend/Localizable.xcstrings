    "This workout is no longer scheduled on this day. Reload the day and choose it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هذا التمرين مجدولًا في هذا اليوم. أعد تحميل اليوم واختره مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
