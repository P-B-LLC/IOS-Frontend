        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निजी माप भी आपके व्यक्तिगत लक्ष्यों और प्रगति में मदद करते रहते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
