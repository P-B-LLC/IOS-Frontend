    "People who want to follow you. Approving lets them see your profile and your posts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أشخاص يريدون متابعتك. قبولهم يتيح لهم رؤية ملفك الشخصي ومنشوراتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen, die dir folgen möchten. Wenn du bestätigst, können sie dein Profil und deine Beiträge sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personas que quieren seguirte. Si las apruebas, podrán ver tu perfil y tus publicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes qui veulent vous suivre. Accepter leur permet de voir votre profil et vos publications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे लोग जो आपको फ़ॉलो करना चाहते हैं। स्वीकार करने पर वे आपकी प्रोफ़ाइल और पोस्ट देख सकेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたをフォローしたい人です。承認すると、相手はあなたのプロフィールと投稿を見られるようになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas que querem seguir você. Ao aprovar, elas podem ver seu perfil e suas publicações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди, которые хотят подписаться на вас. Если одобрить запрос, они увидят ваш профиль и публикации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想关注你的人。批准后，他们可以查看你的个人主页和帖子。"
          }
        }
      }
    },
    "People you block from a post will appear here." : {
