    "Pushes the rest of the rotation back a day. Nothing is skipped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤجّل بقية التناوب يومًا واحدًا. لا يتم تخطي أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt den Rest der Rotation um einen Tag. Nichts wird übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pospone el resto de la rotación un día. No se omite nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repousse le reste de la rotation d’un jour. Rien n’est sauté."
