    "Microphone access is off. You can still take a photo or choose a video from your camera roll." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الميكروفون متوقف. لا يزال بإمكانك التقاط صورة أو اختيار فيديو من ألبوم الكاميرا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist deaktiviert. Du kannst trotzdem ein Foto aufnehmen oder ein Video aus deiner Mediathek wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al micrófono está desactivado. Aún puedes tomar una foto o elegir un video de tu carrete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est désactivé. Vous pouvez toujours prendre une photo ou choisir une vidéo dans votre pellicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन एक्सेस बंद है। आप फिर भी फ़ोटो ले सकते हैं या अपने कैमरा रोल से वीडियो चुन सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスがオフになっています。写真の撮影や、カメラロールからの動画の選択はできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao microfone está desativado. Você ainda pode tirar uma foto ou escolher um vídeo do rolo da câmera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону выключен. Вы всё равно можете сделать фото или выбрать видео из медиатеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问已关闭。你仍可以拍照，或从相册中选择视频。"
          }
        }
      }
    },
