    "Prompts show on your profile under About. Tap one to rewrite it, or swap it for a different prompt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الأسئلة في ملفك الشخصي ضمن «نبذة». اضغط على أحدها لإعادة كتابته، أو استبدله بسؤال آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulse erscheinen in deinem Profil unter „Über mich“. Tippe auf einen, um ihn umzuschreiben, oder tausche ihn gegen einen anderen Impuls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las preguntas se muestran en tu perfil, en Acerca de. Toca una para reescribirla o cámbiala por otra pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les questions s’affichent sur votre profil sous À propos. Touchez-en une pour la réécrire, ou remplacez-la par une autre question."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रॉम्प्ट आपकी प्रोफ़ाइल पर ‘परिचय’ के नीचे दिखते हैं। किसी को दोबारा लिखने के लिए उस पर टैप करें, या उसे किसी दूसरे प्रॉम्प्ट से बदलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問はプロフィールの「概要」に表示されます。タップして書き直すか、別の質問に入れ替えられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As frases aparecem no seu perfil, em Sobre. Toque em uma para reescrevê-la ou trocá-la por outra frase."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вопросы показываются в профиле в разделе «О себе». Коснитесь вопроса, чтобы переписать ответ, или замените его другим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问答显示在你个人主页的“关于”下方。轻点一个即可重写，或换成其他问答。"
          }
        }
      }
    },
