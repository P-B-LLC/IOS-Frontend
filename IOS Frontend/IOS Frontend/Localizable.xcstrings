    "Sign in to log food. Meals are kept on your account, not on this phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول لتسجيل الطعام. تُحفظ الوجبات في حسابك، لا على هذا الهاتف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um Lebensmittel zu erfassen. Mahlzeiten werden in deinem Konto gespeichert, nicht auf diesem Telefon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para registrar alimentos. Las comidas se guardan en tu cuenta, no en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour noter vos aliments. Les repas sont conservés sur votre compte, pas sur ce téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाना लॉग करने के लिए साइन इन करें। भोजन आपके अकाउंट में रखे जाते हैं, इस फ़ोन पर नहीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事を記録するにはサインインしてください。食事はこのスマートフォンではなく、アカウントに保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para registrar alimentos. As refeições ficam na sua conta, não neste celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, чтобы записывать еду. Приёмы пищи хранятся в вашем аккаунте, а не на этом телефоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后即可记录饮食。餐食保存在你的账户中，而不是这部手机上。"
          }
        }
      }
    },
