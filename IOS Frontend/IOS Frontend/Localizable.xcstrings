    "food for today muted from a notification." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم كتم طعام اليوم من خلال إشعار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ernährung für heute über eine Benachrichtigung stummgeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alimentación de hoy silenciada desde una notificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alimentation du jour mise en sourdine depuis une notification."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफ़िकेशन से आज का खाना म्यूट किया गया।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の食事が通知からミュートされています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alimentação de hoje silenciada a partir de uma notificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостановлено через уведомление: питание на сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已从通知中静音：今日饮食。"
          }
        }
      }
    },
