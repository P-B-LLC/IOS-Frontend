        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आइटम दिखाए जा रहे हैं। पूरा दिन देखने के लिए ‘सभी’ चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の項目を表示中。一日全体を見るには「すべて」を選んでください。"
