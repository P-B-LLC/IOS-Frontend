        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका वर्कआउट सेव हो गया, लेकिन उसकी पुष्टि नहीं हो सकी। उसे सुरक्षित रूप से फिर से लोड करने के लिए फिर से कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトは保存されましたが、確認できませんでした。再試行して安全に再読み込みしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
