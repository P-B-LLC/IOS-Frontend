    "Optional. Added to the end of this workout — you start it from the summary when you finish lifting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختياري. يُضاف إلى نهاية هذا التمرين — تبدأه من الملخص عند انتهائك من رفع الأثقال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Wird am Ende dieses Workouts hinzugefügt — du startest es in der Zusammenfassung, wenn du mit dem Krafttraining fertig bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Se agrega al final de este entrenamiento — lo inicias desde el resumen cuando terminas con las pesas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Ajouté à la fin de cet entraînement — vous le lancez depuis le récapitulatif une fois la musculation terminée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैकल्पिक। इस वर्कआउट के आखिर में जोड़ा जाता है — लिफ़्टिंग खत्म करने पर आप इसे सारांश से शुरू करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。このワークアウトの最後に追加されます。ウェイトを終えたら、サマリーから開始します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Adicionado ao fim deste treino — você o inicia pelo resumo quando terminar a musculação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Добавляется в конец тренировки — вы запускаете его из сводки, когда закончите силовую часть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。添加到此训练的末尾——完成力量训练后，从总结页面开始。"
          }
        }
      }
    },
