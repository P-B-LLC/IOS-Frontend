    "%@ did not publish your post after review. You can check it on your profile or contact support." : {
      "comment" : "The placeholder is the app's name, Rytivo",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم ينشر %@ منشورك بعد المراجعة. يمكنك الاطلاع عليه في ملفك الشخصي أو التواصل مع الدعم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat deinen Beitrag nach der Prüfung nicht veröffentlicht. Du kannst ihn in deinem Profil ansehen oder den Support kontaktieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras revisarla, %@ no publicó tu publicación. Puedes verla en tu perfil o contactar a soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après examen, %@ n’a pas mis en ligne votre publication. Vous pouvez la consulter sur votre profil ou contacter l’assistance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समीक्षा के बाद %@ ने आपकी पोस्ट प्रकाशित नहीं की। आप इसे अपनी प्रोफ़ाइल पर देख सकते हैं या सपोर्ट से संपर्क कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は審査の結果、あなたの投稿を公開しませんでした。プロフィールで確認するか、サポートにお問い合わせください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não liberou sua publicação após a revisão. Você pode vê-la no seu perfil ou entrar em contato com o suporte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По итогам проверки %@ ваша публикация не размещена. Вы можете посмотреть её в своём профиле или связаться с поддержкой."
