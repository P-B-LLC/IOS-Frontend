    "Topics only. For You never keeps a list of whose posts you look at to show you here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المواضيع فقط. لا يحتفظ «مقترحات لك» أبدًا بقائمة بأصحاب المنشورات التي تشاهدها لعرضها هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Themen. „Für dich“ speichert nie eine Liste, wessen Beiträge du dir ansiehst, um sie dir hier zu zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo temas. Para ti nunca guarda una lista de las personas cuyas publicaciones miras para mostrártela aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujets uniquement. Pour vous ne conserve jamais de liste des personnes dont vous regardez les publications à afficher ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ विषय। ‘आपके लिए’ यहाँ दिखाने के लिए कभी यह सूची नहीं रखता कि आप किसकी पोस्ट देखते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トピックのみです。「おすすめ」が、あなたが誰の投稿を見たかのリストを保持してここに表示することはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só temas. O Para Você nunca guarda uma lista de quem são as publicações que você vê para mostrar aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только темы. Раздел «Для вас» никогда не хранит список того, чьи публикации вы смотрите, чтобы показывать их здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限话题。“为你推荐”从不保存你浏览过谁的帖子的列表，因此这里不会显示。"
          }
        }
      }
    },
