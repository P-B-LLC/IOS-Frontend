          }
        }
      }
    },
    "An interest you add counts as one you chose. Tap it again to take it off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتسب الاهتمام الذي تضيفه كاهتمام اخترته. اضغط عليه مرة أخرى لإزالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Interesse, das du hinzufügst, zählt als von dir gewählt. Tippe es erneut an, um es zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
