        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असली सामग्री और पोषण के साथ रेसिपी बनाएँ। Rytivo कुल मात्रा को दोबारा इस्तेमाल के लिए तैयार रखता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際の材料と栄養成分でレシピを作成します。Rytivoが合計値を保存し、いつでも再利用できるようにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monte uma receita com os ingredientes e valores nutricionais reais. O Rytivo deixa os totais prontos para reutilizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Составьте рецепт из реальных ингредиентов с их пищевой ценностью. Rytivo сохранит итоги для повторного использования."
