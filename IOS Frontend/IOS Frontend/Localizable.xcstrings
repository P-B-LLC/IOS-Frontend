    "Rytivo" : {
      "shouldTranslate" : false
    },
    "Rytivo asks for access only when a feature needs it. You can change access at any time in iOS Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب Rytivo الوصول فقط عندما تحتاج إليه ميزة ما. يمكنك تغيير الوصول في أي وقت من إعدادات iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo fragt nur dann nach Zugriff, wenn eine Funktion ihn braucht. Du kannst den Zugriff jederzeit in den iOS-Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo pide acceso solo cuando una función lo necesita. Puedes cambiar el acceso en cualquier momento en Configuración de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo ne demande l’accès que lorsqu’une fonctionnalité en a besoin. Vous pouvez modifier les accès à tout moment dans les Réglages iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo एक्सेस सिर्फ़ तभी माँगता है जब किसी फ़ीचर को उसकी ज़रूरत हो। आप iOS सेटिंग्ज़ में कभी भी एक्सेस बदल सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivoは機能に必要なときだけアクセスを求めます。アクセスはiOSの「設定」でいつでも変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo só pede acesso quando um recurso precisa. Você pode alterar o acesso a qualquer momento nos Ajustes do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo запрашивает доступ, только когда он нужен для функции. Изменить доступ можно в любой момент в Настройках iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo 仅在功能需要时才会请求权限。你可以随时在 iOS“设置”中更改权限。"
          }
        }
      }
    },
    "Rytivo can map your route and measure your distance and pace while this session runs. Location is only used during a session you start." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Rytivo رسم مسارك وقياس المسافة والوتيرة أثناء هذه الجلسة. لا يُستخدم الموقع إلا خلال جلسة تبدأها أنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo kann deine Route aufzeichnen und Distanz und Pace messen, während diese Einheit läuft. Der Standort wird nur während einer von dir gestarteten Einheit verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo puede trazar tu ruta y medir tu distancia y ritmo mientras esta sesión está en curso. La ubicación solo se usa durante una sesión que inicias tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo peut tracer votre itinéraire et mesurer votre distance et votre allure pendant cette séance. La position n’est utilisée que pendant une séance que vous lancez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सेशन चलने के दौरान Rytivo आपका रूट मैप कर सकता है और आपकी दूरी और पेस माप सकता है। लोकेशन का इस्तेमाल सिर्फ़ आपके शुरू किए गए सेशन के दौरान होता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッション中、Rytivoはルートを地図に記録し、距離とペースを計測できます。位置情報は、あなたが開始したセッション中にのみ使用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rytivo pode mapear seu trajeto e medir sua distância e seu ritmo enquanto esta sessão está em andamento. A localização só é usada durante uma sessão que você inicia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytivo может нанести ваш маршрут на карту и измерить дистанцию и темп, пока идёт это занятие. Геопозиция используется только во время занятия, которое вы начали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本次训练进行时，Rytivo 可以绘制你的路线，并测量距离和配速。位置信息仅在你开始的训练期间使用。"
          }
        }
      }
    },
