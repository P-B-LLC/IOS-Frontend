            "value" : "आपका Rytivo सर्वर अभी मेहनत की रेटिंग सेव नहीं करता। सर्वर अपडेट करें, फिर से कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
