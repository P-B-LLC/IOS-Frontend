<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Xcode merges this file with the keys generated from the
	  INFOPLIST_KEY_* build settings. It holds only what the generator
	  cannot express: UIBackgroundModes is required for location updates
	  to continue while a run, ride, or swim session is in progress and
	  the screen is locked.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!--
	  The barometric altimeter is read through CoreMotion, which requires
	  this description. It measures height change far more precisely than
	  GPS, so climb during a run or ride is worth reporting.
	-->
	<key>NSMotionUsageDescription</key>
	<string>Repbase reads your device's barometer during a run, ride, or swim to measure the elevation you climb. It is only used while a session you started is running.</string>
	<!--
	  HealthKit. Reading only, so only the share description is strictly
	  required, but an app that links HealthKit and omits either key is
	  terminated at launch rather than warned. Repbase never writes to Health;
	  the update description says so plainly rather than leaving the user to
	  wonder what it might put there.
	-->
	<key>NSHealthShareUsageDescription</key>
	<string>Repbase reads your step count and the runs, rides, and swims recorded by your iPhone or Apple Watch, so your training shows up here without entering it twice.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Repbase does not write anything to Health. It only reads the activity you have already recorded.</string>
</dict>
</plist>
